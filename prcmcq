          return `
            <section class="question-block">

              <div class="question-header">
                Question ${q.siteQuestionNumber} of ${total}
              </div>

              <div class="question-rule"></div>

              <div class="question-text">
                ${q.questionHTML}
              </div>

              <div class="choices">
                ${choices}
              </div>

              ${explanation}

            </section>
