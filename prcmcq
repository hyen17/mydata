                      choiceIndex
                    );

                  const correct =
                    withAnswers &&
                    choiceIndex ===
                      q.correctIndex;

                  return `
                    <div class="choice ${correct ? 'correct' : ''}">

                      <div class="choice-letter">
                        ${letter}.
                      </div>

                      <div class="choice-content">
                        ${choice}
                      </div>

                      <div class="choice-mark">
