  function updateSequentialProgress(
    current,
    total,
    verb = 'processed'
  ) {
    const percentage =
      total > 0
        ? (
            current /
            total
          ) * 100
        : 0;

    setProgress(
      percentage
    );

    setCounter(
      `${current} of ${total} ${verb}`
    );
  }

  function getOutputFontSize() {
    let size =
      parseFloat(
        fontInput.value
      );

    if (
      !Number.isFinite(size)
    ) {
      size = 12;
    }

    return Math.max(
      9,
      Math.min(
        18,
        size
      )
    );
  }

  /* =========================================================
     TOTAL QUESTIONS
     ========================================================= */

  function validateTotalQuestions() {
    const raw =
      totalInput.value.trim();

    if (!raw) {
      totalInput.classList.add(
        'qe-error'
      );

      totalInput.focus();

      setStatus(
        'Please enter the total number of questions.'
      );

      return null;
    }

    const value =
      Number(raw);

    if (
      !Number.isInteger(value) ||
      value < 1
    ) {
      totalInput.classList.add(
        'qe-error'
      );

      totalInput.focus();

      setStatus(
        'Total questions must be a whole number greater than 0.'
      );

      return null;
    }

    totalInput.classList.remove(
      'qe-error'
    );

    return value;
  }

  totalInput.addEventListener(
    'input',
    () => {
      totalInput.classList.remove(
        'qe-error'
      );
    }
  );

  /* =========================================================
     VISIBILITY
     ========================================================= */

  function isElementVisible(
    el
  ) {
    if (!el) {
      return false;
    }

    const style =
      window.getComputedStyle(
        el
      );

    if (
      style.display ===
        'none' ||
      style.visibility ===
        'hidden'
    ) {
      return false;
    }

    const rect =
      el.getBoundingClientRect();

    return (
      rect.width > 0 &&
      rect.height > 0
    );
  }

  /* =========================================================
     BREADCRUMB / MODE DETECTION
     ========================================================= */

  function getBreadcrumbText() {
    const breadcrumb =
      document.querySelector(
        '[aria-label="breadcrumb"]'
      );

    return (
      breadcrumb
        ?.innerText
        ?.trim() ||
      ''
    );
  }

  function autoDetectMode() {
    const breadcrumb =
      getBreadcrumbText()
        .toLowerCase();

    if (
      breadcrumb.includes(
        'mock exam'
      ) ||
      breadcrumb.includes(
        'mock exams'
      )
    ) {
      return 'mock';
    }

    return 'quiz';
  }

  function resolveMode() {
    const selected =
      modeInput.value;

    if (
      selected ===
        'quiz' ||
      selected ===
        'mock'
    ) {
      return selected;
    }

    return autoDetectMode();
  }

  /* =========================================================
     QUIZ CONTENT
     ========================================================= */

  function getQuizContent() {
    const contents =
      Array.from(
        document.querySelectorAll(
          '.FusePageCarded-content'
        )
      );

    const visible =
      contents.filter(
        isElementVisible
      );

    return (
      visible[
        visible.length - 1
      ] ||
      contents[
        contents.length - 1
      ] ||
      document
    );
  }

  /* =========================================================
     NAVIGATOR COMBOBOX
     ========================================================= */

  function getNavigatorCombobox() {
    const combos =
      Array.from(
        document.querySelectorAll(
          '[role="combobox"]'
        )
      )
      .filter(el => {
        const text =
          el.textContent
            ?.trim() ||
          '';

        /*
          Quiz:
            9

          Mock:
            1 ~ 125
        */

        return (
          /^\d+$/.test(
            text
          ) ||
          /^\d+\s*~\s*\d+$/.test(
            text
          )
        );
      });

    const visible =
      combos.filter(
        isElementVisible
      );

    return (
      visible[
        visible.length - 1
      ] ||
      combos[
        combos.length - 1
      ] ||
      null
    );
  }

  /* =========================================================
     QUIZ CURRENT NUMBER
     ========================================================= */

  function getQuizCurrentNumber() {
    const combo =
      getNavigatorCombobox();

    if (!combo) {
      return null;
    }

    const text =
      combo.textContent
        ?.trim() ||
      '';

    /*
      Numeric only.

      Mock's "1 ~ 125" is intentionally NOT treated as
      current question.
    */

    if (
      !/^\d+$/.test(
        text
      )
    ) {
      return null;
    }

    const value =
      parseInt(
        text,
        10
      );

    return Number.isFinite(
      value
    )
      ? value
      : null;
  }

  /* =========================================================
     RADIOGROUP
     ========================================================= */

  function getRadioGroup() {
    const content =
      getQuizContent();

    let groups =
      Array.from(
        content.querySelectorAll(
          '[role="radiogroup"]'
        )
      )
      .filter(
        group =>
          group.querySelectorAll(
            'input[type="radio"][name="answer"]'
          ).length >= 2
      );

    const visible =
      groups.filter(
        isElementVisible
      );

    if (
      visible.length
    ) {
      return visible[
        visible.length - 1
      ];
    }

    groups =
      groups.filter(
        el =>
          el.isConnected
      );

    return (
      groups[
        groups.length - 1
      ] ||
      null
    );
  }

  function getAnswerInputs() {
    const group =
      getRadioGroup();

    if (!group) {
      return [];
    }

    return Array.from(
      group.querySelectorAll(
        'input[type="radio"][name="answer"]'
      )
    );
  }

  function getChoiceLabels() {
    return getAnswerInputs()
      .map(input => {
        if (!input.id) {
          return null;
        }

        try {
          return document.querySelector(
            `label[for="${CSS.escape(input.id)}"]`
          );
        } catch {
          return null;
        }
      })
      .filter(Boolean);
  }

  /* =========================================================
     QUESTION IDENTITY
     ========================================================= */

  function getQuestionInternalId() {
    const input =
      getAnswerInputs()[0];

    if (!input?.id) {
      return '';
    }

    const marker =
      '.answers.';

    const index =
      input.id.indexOf(
        marker
      );

    if (
      index >= 0
    ) {
      return input.id.slice(
        0,
        index
      );
    }

    return input.id;
  }

  /* =========================================================
     QUESTION TEXT
     ========================================================= */

  function getQuestionElement() {
    const group =
      getRadioGroup();

    if (!group) {
      return null;
    }

    let node =
      group;

    while (
      node &&
      node.parentElement &&
      node.parentElement !==
        document.body
    ) {
      const parent =
        node.parentElement;

      const children =
        Array.from(
          parent.children
        );

      const index =
        children.indexOf(
          node
        );

      if (
        index >= 2
      ) {
        const candidate =
          children[
            index - 2
          ];

        if (candidate) {
          const text =
            candidate.innerText
              ?.trim() ||
            '';

          if (
            text &&
            candidate.querySelector(
              'p'
            ) &&
            !candidate.contains(
              group
            )
          ) {
            return candidate;
          }
        }
      }

      node =
        parent;
    }

    /*
      Fallback.
    */

    const content =
      getQuizContent();

    const candidates =
      Array.from(
        content.querySelectorAll(
          'div[dir="ltr"]'
        )
      )
      .filter(el => {
        if (
          el.contains(
            group
          )
        ) {
          return false;
        }

        const text =
          el.innerText
            ?.trim() ||
          '';

        if (!text) {
          return false;
        }

        if (
          !el.querySelector(
            'p'
          )
        ) {
          return false;
        }

        const relation =
          el.compareDocumentPosition(
            group
          );

        return !!(
          relation &
          Node.DOCUMENT_POSITION_FOLLOWING
        );
      });

    return (
      candidates[
        candidates.length - 1
      ] ||
      null
    );
  }

  /* =========================================================
     FEEDBACK
     ========================================================= */

  function elementHasFeedbackHeading(
    element
  ) {
    if (!element) {
      return false;
    }

    return Array
      .from(
        element.querySelectorAll(
          'p'
        )
      )
      .some(
        p =>
          p.textContent
            ?.trim()
            .toLowerCase() ===
          'feedback'
      );
  }

  function getFeedbackSection() {
    const group =
      getRadioGroup();

    if (!group) {
      return null;
    }

    let parent =
      group.parentElement;

    for (
      let depth = 0;
      depth < 7 &&
      parent;
      depth++
    ) {
      for (
        const child
        of Array.from(
          parent.children
        )
      ) {
        if (
          child === group ||
          child.contains(
            group
          )
        ) {
          continue;
        }

        if (
          elementHasFeedbackHeading(
            child
          )
        ) {
          return child;
        }
      }

      parent =
        parent.parentElement;
    }

    const content =
      getQuizContent();

    const headings =
      Array
        .from(
          content.querySelectorAll(
            'p'
          )
        )
        .filter(
          p =>
            p.textContent
              ?.trim()
              .toLowerCase() ===
            'feedback'
        );

    const visible =
      headings.filter(
        isElementVisible
      );

    const heading =
      visible[
        visible.length - 1
      ] ||
      headings[
        headings.length - 1
      ];

    return (
      heading
        ?.parentElement ||
      null
    );
  }

  function getExplanationText() {
    const section =
      getFeedbackSection();

    if (!section) {
      return '';
    }

    return (
      section.innerText
        ?.replace(
          /^\s*Feedback\s*/i,
          ''
        )
        .trim() ||
      ''
    );
  }

  /* =========================================================
     CORRECT ANSWER
     ========================================================= */

  function getCorrectIndex() {
    const labels =
      getChoiceLabels();

    if (!labels.length) {
      return -1;
    }

    /*
      Primary:
      Answer (c) is correct.
    */

    const feedback =
      getExplanationText();

    const match =
      feedback.match(
        /Answer\s*\(\s*([a-z])\s*\)\s*is\s+correct/i
      );

    if (match) {
      const index =
        match[1]
          .toLowerCase()
          .charCodeAt(0) -
        'a'.charCodeAt(0);

      if (
        index >= 0 &&
        index <
          labels.length
      ) {
        return index;
      }
    }

    /*
      Correct normally:
      font-bold without underline.
    */

    const correct =
      labels.findIndex(
        label => {
          const classes =
            String(
              label.className ||
              ''
            );

          return (
            classes.includes(
              'font-bold'
            ) &&
            !classes.includes(
              'underline'
            )
          );
        }
      );

    if (
      correct >= 0
    ) {
      return correct;
    }

    /*
      Selected correct answer:
      one bold option only.
    */

    const bold =
      [];

    labels.forEach(
      (
        label,
        index
      ) => {
        const classes =
          String(
            label.className ||
            ''
          );

        if (
          classes.includes(
            'font-bold'
          )
        ) {
          bold.push(
            index
          );
        }
      }
    );

    if (
      bold.length === 1
    ) {
      return bold[0];
    }

    return -1;
  }

  /* =========================================================
     MOCK PHASE DETECTION
     ========================================================= */

  function detectMockPhase() {
    const feedback =
      getExplanationText();

    const correct =
      getCorrectIndex();

    /*
      Review:
      correct answer + explanation are visible.
    */

    if (
      feedback &&
      correct >= 0
    ) {
      return 'review';
    }

    /*
      Taking phase:
      ordinary selectable answers, no Feedback.
    */

    return 'taking';
  }

  /* =========================================================
     STABILITY
     ========================================================= */

  function buildRenderSignature() {
    const question =
      getQuestionElement();

    const questionText =
      question
        ?.innerText
        ?.trim() ||
      '';

    const inputs =
      getAnswerInputs();

    const inputData =
      inputs
        .map(
          input =>
            [
              input.id,
              input.value,
              input.checked
                ? 'C'
                : 'U',
              input.disabled
                ? 'D'
                : 'E'
            ].join(':')
        )
        .join('|');

    const labels =
      getChoiceLabels();

    const choices =
      labels
        .map(
          label =>
            label.innerText
              ?.trim() ||
            ''
        )
        .join('|');

    return [
      getQuestionInternalId(),
      questionText,
      inputData,
      choices
    ].join(':::');
  }

  async function waitForQuestionStable(
    timeout =
      CONFIG.questionReadyTimeout
  ) {
    const started =
      Date.now();

    let lastSignature =
      '';

    let stableCount =
      0;

    while (
      Date.now() - started <
      timeout
    ) {
      if (
        state.stopRequested
      ) {
        return false;
      }

      const group =
        getRadioGroup();

      const inputs =
        getAnswerInputs();

      const labels =
        getChoiceLabels();

      const question =
        getQuestionElement();

      const questionText =
        question
          ?.innerText
          ?.trim() ||
        '';

      const ready =
        !!group &&
        inputs.length >= 2 &&
        labels.length ===
          inputs.length &&
        !!questionText;

      if (!ready) {
        stableCount = 0;
        lastSignature = '';

        await sleep(
          CONFIG.stabilityPoll
        );

        continue;
      }

      const signature =
        buildRenderSignature();

      if (
        signature ===
        lastSignature
      ) {
        stableCount++;
      } else {
        lastSignature =
          signature;

        stableCount = 1;
      }

      if (
        stableCount >=
        CONFIG.stabilityChecks
      ) {
        return true;
      }

      await sleep(
        CONFIG.stabilityPoll
      );
    }

    return false;
  }

  /* =========================================================
     NAVIGATION BUTTONS
     ========================================================= */

  function getNavigationButtons() {
    const combo =
      getNavigatorCombobox();

    if (!combo) {
      return {
        previous: null,
        next: null
      };
    }

    let parent =
      combo.parentElement;

    /*
      Look for direct layout:
      Prev | Combo | Next
    */

    for (
      let depth = 0;
      depth < 8 &&
      parent;
      depth++
    ) {
      const children =
        Array.from(
          parent.children
        );

      const comboIndex =
        children.findIndex(
          child =>
            child === combo ||
            child.contains(
              combo
            )
        );

      if (
        comboIndex >= 0
      ) {
        const previous =
          children
            .slice(
              0,
              comboIndex
            )
            .reverse()
            .find(
              child =>
                child.tagName ===
                'BUTTON'
            );

        const next =
          children
            .slice(
              comboIndex + 1
            )
            .find(
              child =>
                child.tagName ===
                'BUTTON'
            );

        if (
          previous &&
          next
        ) {
          return {
            previous,
            next
          };
        }
      }

      parent =
        parent.parentElement;
    }

    /*
      Fallback DOM order.
    */

    parent =
      combo.parentElement;

    for (
      let depth = 0;
      depth < 8 &&
      parent;
      depth++
    ) {
      const elements =
        Array
          .from(
            parent.querySelectorAll(
              'button, [role="combobox"]'
            )
          )
          .filter(
            el =>
              el === combo ||
              isElementVisible(
                el
              )
          );

      const comboIndex =
        elements.indexOf(
          combo
        );

      if (
        comboIndex > 0
      ) {
        const previous =
          elements
            .slice(
              0,
              comboIndex
            )
            .reverse()
            .find(
              el =>
                el.tagName ===
                  'BUTTON'
            );

        const next =
          elements
            .slice(
              comboIndex + 1
            )
            .find(
              el =>
                el.tagName ===
                  'BUTTON'
            );

        if (
          previous &&
          next
        ) {
          return {
            previous,
            next
          };
        }
      }

      parent =
        parent.parentElement;
    }

    return {
      previous: null,
      next: null
    };
  }

  function buttonLooksInactive(
    button
  ) {
    if (!button) {
      return true;
    }

    const classes =
      String(
        button.className ||
        ''
      );

    return (
      button.disabled ||
      button.hasAttribute(
        'disabled'
      ) ||
      button.getAttribute(
        'aria-disabled'
      ) === 'true' ||
      classes.includes(
        'cursor-default'
      )
    );
  }

  /* =========================================================
     WAIT FOR QUESTION ID CHANGE
     ========================================================= */

  async function waitForQuestionIdentityChange(
    oldId,
    timeout =
      CONFIG.navigationTimeout
  ) {
    const started =
      Date.now();

    while (
      Date.now() - started <
      timeout
    ) {
      if (
        state.stopRequested
      ) {
        return false;
      }

      await sleep(100);

      const newId =
        getQuestionInternalId();

      if (
        newId &&
        oldId &&
        newId !==
          oldId
      ) {
        const stable =
          await waitForQuestionStable(
            Math.min(
              5000,
              timeout
            )
          );

        if (stable) {
          await sleep(
            CONFIG.afterNavigation
          );

          return true;
        }
      }
    }

    return false;
  }

  /* =========================================================
     WAIT FOR QUIZ SPECIFIC NUMBER
     ========================================================= */

  async function waitForQuizQuestionNumber(
    expectedNumber,
    oldId,
    timeout =
      CONFIG.navigationTimeout
  ) {
    const started =
      Date.now();

    while (
      Date.now() - started <
      timeout
    ) {
      if (
        state.stopRequested
      ) {
        return false;
      }

      await sleep(100);

      const number =
        getQuizCurrentNumber();

      const newId =
        getQuestionInternalId();

      if (
        number ===
          expectedNumber &&
        newId &&
        newId !==
          oldId
      ) {
        const stable =
          await waitForQuestionStable(
            5000
          );

        if (stable) {
          await sleep(
            CONFIG.afterNavigation
          );

          return true;
        }
      }
    }

    return false;
  }

  /* =========================================================
     CLICK RANDOM ANSWER
     ========================================================= */

  async function chooseRandomAnswer() {
    const stable =
      await waitForQuestionStable();

    if (!stable) {
      throw new Error(
        'Current question did not finish loading.'
      );
    }

    /*
      Already selected?
      Leave it alone.
    */

    const inputs =
      getAnswerInputs();

    if (
      inputs.some(
        input =>
          input.checked
      )
    ) {
      return;
    }

    const available =
      inputs.filter(
        input =>
          !input.disabled
      );

    if (!available.length) {
      /*
        In review mode radios can be disabled.
      */

      if (
        getFeedbackSection()
      ) {
        return;
      }

      throw new Error(
        'No selectable answer choices are available.'
      );
    }

    const selected =
      available[
        Math.floor(
          Math.random() *
          available.length
        )
      ];

    selected.click();

    /*
      Wait until website registers selection.
    */

    const started =
      Date.now();

    while (
      Date.now() - started <
      5000
    ) {
      if (
        state.stopRequested
      ) {
        return;
      }

      const fresh =
        getAnswerInputs();

      const same =
        fresh.find(
          input =>
            input.id ===
              selected.id
        );

      if (
        same?.checked
      ) {
        await sleep(
          CONFIG.afterAnswerClick
        );

        return;
      }

      await sleep(100);
    }

    /*
      Label fallback.
    */

    try {
      const label =
        document.querySelector(
          `label[for="${CSS.escape(selected.id)}"]`
        );

      label?.click();
    } catch {}

    await sleep(300);

    const final =
      getAnswerInputs()
        .find(
          input =>
            input.id ===
              selected.id
        );

    if (
      !final?.checked
    ) {
      throw new Error(
        'Random answer was clicked but the site did not register it.'
      );
    }
  }

  /* =========================================================
     WAIT FOR FEEDBACK + CORRECT ANSWER
     ========================================================= */

  async function waitForReviewDetails(
    timeout =
      CONFIG.feedbackTimeout
  ) {
    const started =
      Date.now();

    while (
      Date.now() - started <
      timeout
    ) {
      if (
        state.stopRequested
      ) {
        return false;
      }

      const explanation =
        getExplanationText();

      const correct =
        getCorrectIndex();

      const choices =
        getChoiceLabels();

      if (
        explanation &&
        correct >= 0 &&
        correct <
          choices.length &&
        choices.length >= 2
      ) {
        await sleep(180);

        const explanationAgain =
          getExplanationText();

        const correctAgain =
          getCorrectIndex();

        if (
          explanationAgain &&
          correctAgain >= 0
        ) {
          return true;
        }
      }

      await sleep(120);
    }

    return false;
  }

  /* =========================================================
     QUIZ FIRST QUESTION
     ========================================================= */

  async function goQuizToFirst() {
    let safety = 0;

    while (
      !state.stopRequested &&
      safety <
        CONFIG.maxQuestions
    ) {
      safety++;

      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          'Question did not become stable while returning to Question 1.'
        );
      }

      const current =
        getQuizCurrentNumber();

      if (
        current === 1
      ) {
        return;
      }

      if (
        !Number.isInteger(
          current
        )
      ) {
        throw new Error(
          'Quiz question number could not be detected.'
        );
      }

      const {
        previous
      } =
        getNavigationButtons();

      if (
        !previous ||
        buttonLooksInactive(
          previous
        )
      ) {
        throw new Error(
          `Could not return from Question ${current} to Question 1.`
        );
      }

      const oldId =
        getQuestionInternalId();

      previous.click();

      const moved =
        await waitForQuizQuestionNumber(
          current - 1,
          oldId
        );

      if (!moved) {
        throw new Error(
          `Could not navigate from Question ${current} to Question ${current - 1}.`
        );
      }
    }
  }

  /* =========================================================
     MOCK FIRST QUESTION
     ========================================================= */

  async function goMockToFirst() {
    /*
      Mock Exam does not expose current question number.
      We therefore walk backwards until Previous becomes
      cursor-default/disabled or no longer changes question.
    */

    let safety = 0;

    while (
      !state.stopRequested &&
      safety <
        CONFIG.maxQuestions
    ) {
      safety++;

      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          'Mock Exam question did not become stable while locating Question 1.'
        );
      }

      const {
        previous
      } =
        getNavigationButtons();

      if (!previous) {
        throw new Error(
          'Mock Exam Previous button could not be detected.'
        );
      }

      /*
        Screenshot supplied by user shows Question 1 Previous
        button with cursor-default.
      */

      if (
        buttonLooksInactive(
          previous
        )
      ) {
        return;
      }

      const oldId =
        getQuestionInternalId();

      previous.click();

      const moved =
        await waitForQuestionIdentityChange(
          oldId,
          5000
        );

      /*
        No movement = already first question.
      */

      if (!moved) {
        return;
      }
    }

    throw new Error(
      'Safety limit reached while locating the first Mock Exam question.'
    );
  }

  /* =========================================================
     CLEAN HTML
     ========================================================= */

  function cleanHTMLFromElement(
    element
  ) {
    if (!element) {
      return '';
    }

    const clone =
      element.cloneNode(
        true
      );

    clone
      .querySelectorAll(
        'script, button, input'
      )
      .forEach(
        el =>
          el.remove()
      );

    clone
      .querySelectorAll('*')
      .forEach(el => {
        el.removeAttribute(
          'class'
        );

        Array
          .from(
            el.attributes
          )
          .forEach(attr => {
            const name =
              attr.name
                .toLowerCase();

            if (
              name.startsWith(
                'data-'
              ) ||
              name.startsWith(
                'aria-'
              ) ||
              name ===
                'role' ||
              name ===
                'tabindex'
            ) {
              el.removeAttribute(
                attr.name
              );
            }
          });
      });

    return clone
      .innerHTML
      .trim();
  }

  /* =========================================================
     EXPLANATION HTML
     ========================================================= */

  function getExplanationHTML() {
    const section =
      getFeedbackSection();

    if (!section) {
      return '';
    }

    const clone =
      section.cloneNode(
        true
      );

    /*
      Remove original Feedback heading.
    */

    Array
      .from(
        clone.querySelectorAll(
          'p'
        )
      )
      .filter(
        p =>
          p.textContent
            ?.trim()
            .toLowerCase() ===
          'feedback'
      )
      .forEach(
        p =>
          p.remove()
      );

    clone
      .querySelectorAll('*')
      .forEach(el => {
        el.removeAttribute(
          'class'
        );

        Array
          .from(
            el.attributes
          )
          .forEach(attr => {
            const name =
              attr.name
                .toLowerCase();

            if (
              name.startsWith(
                'data-'
              ) ||
              name.startsWith(
                'aria-'
              ) ||
              name ===
                'role' ||
              name ===
                'tabindex'
            ) {
              el.removeAttribute(
                attr.name
              );
            }
          });
      });

    return clone
      .innerHTML
      .trim();
  }

  /* =========================================================
     EXTRACT VALIDATED REVIEW QUESTION
     ========================================================= */

  function extractReviewQuestion(
    questionNumber
  ) {
    const questionElement =
      getQuestionElement();

    if (!questionElement) {
      throw new Error(
        `Question ${questionNumber}: question text could not be detected.`
      );
    }

    const questionHTML =
      cleanHTMLFromElement(
        questionElement
      );

    const choices =
      getChoiceLabels()
        .map(
          label =>
            cleanHTMLFromElement(
              label
            )
        );

    const correctIndex =
      getCorrectIndex();

    const explanationHTML =
      getExplanationHTML();

    const explanationText =
      getExplanationText();

    if (!questionHTML) {
      throw new Error(
        `Question ${questionNumber}: empty question text.`
      );
    }

    if (
      choices.length < 2
    ) {
      throw new Error(
        `Question ${questionNumber}: incomplete choices.`
      );
    }

    if (
      correctIndex < 0 ||
      correctIndex >=
        choices.length
    ) {
      throw new Error(
        `Question ${questionNumber}: correct answer could not be verified.`
      );
    }

    if (
      !explanationHTML ||
      !explanationText
    ) {
      throw new Error(
        `Question ${questionNumber}: explanation could not be verified.`
      );
    }

    return {
      siteQuestionNumber:
        questionNumber,

      internalId:
        getQuestionInternalId(),

      questionHTML,

      choices,

      correctIndex,

      explanationHTML
    };
  }

  /* =========================================================
     TITLE
     ========================================================= */

  function shortenQuizTitle(
    title
  ) {
    if (!title) {
      return 'Quiz';
    }

    const parts =
      title
        .split(
          /\s+-\s+/
        )
        .map(
          part =>
            part.trim()
        )
        .filter(Boolean);

    if (
      parts.length > 1
    ) {
      return parts[
        parts.length - 1
      ];
    }

    return title.trim();
  }

  function getQuizTitle() {
    const breadcrumb =
      document.querySelector(
        '[aria-label="breadcrumb"]'
      );

    if (breadcrumb) {
      const items =
        Array.from(
          breadcrumb.querySelectorAll(
            'li'
          )
        );

      for (
        let i =
          items.length - 1;
        i >= 0;
        i--
      ) {
        const text =
          items[i]
            .innerText
            ?.trim();

        if (text) {
          /*
            Mock:
            Part 1 Mock Exam

            Quiz:
            long title ending in A.1 ...
          */

          if (
            autoDetectMode() ===
            'mock'
          ) {
            return text;
          }

          return shortenQuizTitle(
            text
          );
        }
      }
    }

    return shortenQuizTitle(
      document.title
        ?.trim() ||
      'Quiz'
    );
  }

  /* =========================================================
     QUIZ MODE
     ========================================================= */

  async function runQuizMode(
    total
  ) {
    setDetected(
      'Quiz'
    );

    if (
      firstInput.checked
    ) {
      setStatus(
        'Returning to Question 1…'
      );

      await goQuizToFirst();
    }

    let current =
      getQuizCurrentNumber();

    if (
      !Number.isInteger(
        current
      )
    ) {
      throw new Error(
        'Quiz question number could not be detected.'
      );
    }

    if (
      current > total
    ) {
      throw new Error(
        `Current Question is ${current}, but Total Questions is ${total}.`
      );
    }

    state.startQuestion =
      current;

    while (
      !state.stopRequested
    ) {
      current =
        getQuizCurrentNumber();

      if (
        !Number.isInteger(
          current
        )
      ) {
        throw new Error(
          'Current Quiz question number could not be detected.'
        );
      }

      if (
        state.questionMap.has(
          current
        )
      ) {
        throw new Error(
          `Question ${current} was encountered twice.`
        );
      }

      setStatus(
        `Question ${current} of ${total}: checking…`
      );

      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          `Question ${current}: page did not become stable.`
        );
      }

      /*
        If Feedback is not ready, answer if possible.
      */

      if (
        !getExplanationText() ||
        getCorrectIndex() < 0
      ) {
        await chooseRandomAnswer();

        setStatus(
          `Question ${current}: waiting for feedback…`
        );
      }

      const feedbackReady =
        await waitForReviewDetails();

      if (!feedbackReady) {
        throw new Error(
          `Question ${current}: correct answer or explanation did not load.`
        );
      }

      const data =
        extractReviewQuestion(
          current
        );

      state.questionMap.set(
        current,
        data
      );

      const processed =
        current -
        state.startQuestion +
        1;

      const expected =
        total -
        state.startQuestion +
        1;

      updateSequentialProgress(
        processed,
        expected,
        'saved'
      );

      /*
        Final Quiz question.
      */

      if (
        current === total
      ) {
        break;
      }

      const {
        next
      } =
        getNavigationButtons();

      if (
        !next ||
        buttonLooksInactive(
          next
        )
      ) {
        throw new Error(
          `Question ${current}: Next is unavailable before Question ${total}.`
        );
      }

      const oldId =
        getQuestionInternalId();

      const expectedNext =
        current + 1;

      setStatus(
        `Question ${current} saved. Moving to Question ${expectedNext}…`
      );

      next.click();

      const moved =
        await waitForQuizQuestionNumber(
          expectedNext,
          oldId
        );

      if (!moved) {
        throw new Error(
          `Could not move from Question ${current} to Question ${expectedNext}.`
        );
      }
    }
  }

  /* =========================================================
     MOCK EXAM TAKING PHASE
     ========================================================= */

  async function runMockTakingMode(
    total
  ) {
    state.mockPhase =
      'taking';

    setDetected(
      'Mock Exam — Taking'
    );

    /*
      Mock navigator does not expose current question number.

      Therefore always establish Question 1 first.
    */

    setStatus(
      'Mock Exam: locating Question 1…'
    );

    await goMockToFirst();

    /*
      Re-detect phase after returning to first.
      Could have been run from Review.
    */

    const phaseAfterFirst =
      detectMockPhase();

    if (
      phaseAfterFirst ===
      'review'
    ) {
      return runMockReviewMode(
        total,
        true
      );
    }

    for (
      let index = 1;
      index <= total;
      index++
    ) {
      if (
        state.stopRequested
      ) {
        return;
      }

      setStatus(
        `Mock Exam: answering Question ${index} of ${total}…`
      );

      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          `Mock Question ${index}: page did not become stable.`
        );
      }

      /*
        IMPORTANT:
        We DO NOT save content here.
      */

      await chooseRandomAnswer();

      updateSequentialProgress(
        index,
        total,
        'answered'
      );

      /*
        Final Mock question:
        do NOT click Next.
      */

      if (
        index === total
      ) {
        setProgress(
          100
        );

        setStatus(
          `Mock Exam answering complete — ${total} questions answered. Submit the exam and open Review, then click Start again.`
        );

        setCounter(
          `${total} of ${total} answered · nothing saved yet`
        );

        return;
      }

      const {
        next
      } =
        getNavigationButtons();

      if (
        !next ||
        buttonLooksInactive(
          next
        )
      ) {
        throw new Error(
          `Mock Question ${index}: Next is unavailable before Question ${total}.`
        );
      }

      const oldId =
        getQuestionInternalId();

      next.click();

      const moved =
        await waitForQuestionIdentityChange(
          oldId
        );

      if (!moved) {
        throw new Error(
          `Mock Exam did not advance after Question ${index}.`
        );
      }
    }
  }

  /* =========================================================
     MOCK EXAM REVIEW PHASE
     ========================================================= */

  async function runMockReviewMode(
    total,
    alreadyAtFirst = false
  ) {
    state.mockPhase =
      'review';

    setDetected(
      'Mock Exam — Review'
    );

    if (
      !alreadyAtFirst
    ) {
      setStatus(
        'Mock Review: locating Question 1…'
      );

      await goMockToFirst();
    }

    /*
      Confirm that this really is Review.
    */

    const firstReady =
      await waitForReviewDetails(
        5000
      );

    if (!firstReady) {
      throw new Error(
        'Mock Exam Review was detected, but correct answer/explanation is not available on Question 1.'
      );
    }

    for (
      let index = 1;
      index <= total;
      index++
    ) {
      if (
        state.stopRequested
      ) {
        return;
      }

      if (
        state.questionMap.has(
          index
        )
      ) {
        throw new Error(
          `Mock Review Question ${index} was encountered twice.`
        );
      }

      setStatus(
        `Mock Review: extracting Question ${index} of ${total}…`
      );

      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          `Mock Review Question ${index}: page did not become stable.`
        );
      }

      const reviewReady =
        await waitForReviewDetails();

      if (!reviewReady) {
        throw new Error(
          `Mock Review Question ${index}: correct answer or explanation did not finish loading.`
        );
      }

      const data =
        extractReviewQuestion(
          index
        );

      state.questionMap.set(
        index,
        data
      );

      updateSequentialProgress(
        index,
        total,
        'saved'
      );

      /*
        Final review question.
      */

      if (
        index === total
      ) {
        break;
      }

      const {
        next
      } =
        getNavigationButtons();

      if (
        !next ||
        buttonLooksInactive(
          next
        )
      ) {
        throw new Error(
          `Mock Review Question ${index}: Next is unavailable before Question ${total}.`
        );
      }

      const oldId =
        getQuestionInternalId();

      next.click();

      const moved =
        await waitForQuestionIdentityChange(
          oldId
        );

      if (!moved) {
        throw new Error(
          `Mock Review did not advance after Question ${index}.`
        );
      }
    }
  }

  /* =========================================================
     MOCK MODE CONTROLLER
     ========================================================= */

  async function runMockMode(
    total
  ) {
    /*
      Mock must always start from first because its navigator
      says "1 ~ 125" rather than current question number.
    */

    if (
      !firstInput.checked
    ) {
      throw new Error(
        'Mock Exam requires "Start from Question 1" because the Mock Exam navigator does not expose the current question number.'
      );
    }

    const stable =
      await waitForQuestionStable();

    if (!stable) {
      throw new Error(
        'Mock Exam question did not finish loading.'
      );
    }

    const phase =
      detectMockPhase();

    if (
      phase ===
      'review'
    ) {
      return runMockReviewMode(
        total
      );
    }

    return runMockTakingMode(
      total
    );
  }

  /* =========================================================
     OUTPUT SORT
     ========================================================= */

  function getSortedQuestions() {
    return Array
      .from(
        state.questionMap.values()
      )
      .sort(
        (
          a,
          b
        ) =>
          a.siteQuestionNumber -
          b.siteQuestionNumber
      );
  }

  /* =========================================================
     ESCAPE HTML
     ========================================================= */

  function escapeHTML(
    text
  ) {
    return String(
      text ?? ''
    )
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /'/g,
        '&#039;'
      );
  }

  /* =========================================================
