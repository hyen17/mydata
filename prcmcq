  /* =========================================================
     REBUILD OUTPUT
     ========================================================= */

  function rebuildOutputs() {
    const questions =
      getSortedQuestions();

    if (!questions.length) {
      return;
    }

    state.questionHTML =
      buildOutputHTML(
        questions,
        false
      );

    state.answerHTML =
      buildOutputHTML(
        questions,
        true
      );
  }

  fontInput.addEventListener(
    'input',
    () => {
      if (
        state.questionMap.size
      ) {
        rebuildOutputs();
      }
    }
  );

  /* =========================================================
     OPEN HTML
     ========================================================= */

  function openHTML(
    html
  ) {
    const blob =
      new Blob(
        [html],
        {
          type:
            'text/html;charset=utf-8'
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const win =
      window.open(
        url,
        '_blank'
      );

    if (!win) {
      alert(
        'The browser blocked the new tab. Allow pop-ups or use Download.'
      );
    }

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      60000
    );
  }

  /* =========================================================
     DOWNLOAD
     ========================================================= */

  function sanitizeFilename(
    text
  ) {
    return String(
      text ||
      'Quiz'
    )
      .replace(
        /[<>:"/\\\\|?*]+/g,
        ' '
      )
      .replace(
        /\s+/g,
        ' '
      )
      .trim()
      .slice(
        0,
        120
      );
  }

  function downloadHTML(
    html,
    filename
  ) {
    const blob =
      new Blob(
        [html],
        {
          type:
            'text/html;charset=utf-8'
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const a =
      document.createElement(
        'a'
      );

    a.href =
      url;

    a.download =
      filename;

    document.body.appendChild(
      a
    );

    a.click();

    a.remove();

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      5000
    );
  }

  /* =========================================================
     MAIN
     ========================================================= */

  async function run() {
    if (
      state.running
    ) {
      return;
    }

    const total =
      validateTotalQuestions();

    if (!total) {
      return;
    }

    state.running =
      true;

    state.stopRequested =
      false;

    state.totalQuestions =
      total;

    state.questionMap =
      new Map();

    state.questionHTML =
      '';

    state.answerHTML =
      '';

    state.quizTitle =
      getQuizTitle();

    state.mode =
      resolveMode();

    state.mockPhase =
      null;

    resultsEl.style.display =
      'none';

    startBtn.disabled =
      true;

    stopBtn.disabled =
      false;

    setProgress(
      0
    );

    setCounter(
      `0 of ${total} processed`
    );

    try {
      const stable =
        await waitForQuestionStable();

      if (!stable) {
        throw new Error(
          'Current question did not finish loading.'
        );
      }

      /* =====================================================
         QUIZ
         ===================================================== */

      if (
        state.mode ===
        'quiz'
      ) {
        setDetected(
          'Quiz'
        );

        await runQuizMode(
          total
        );

        if (
          state.stopRequested
        ) {
          throw new Error(
            'Stopped by user.'
          );
        }

        rebuildOutputs();

        resultsEl.style.display =
          'block';

        setProgress(
          100
        );

        setStatus(
          `Completed — ${state.questionMap.size} Quiz questions extracted.`
        );

        return;
      }

      /* =====================================================
         MOCK
         ===================================================== */

      setDetected(
        'Mock Exam — detecting phase…'
      );

      const initialPhase =
        detectMockPhase();

      /*
        runMockMode itself rechecks after returning to first.
      */

      await runMockMode(
        total
      );

      if (
        state.stopRequested
      ) {
        throw new Error(
          'Stopped by user.'
        );
      }

      /*
        Taking phase deliberately has no output.
      */

      if (
        state.mockPhase ===
        'taking'
      ) {
        resultsEl.style.display =
          'none';

        return;
      }

      /*
        Review phase.
      */

      if (
        state.mockPhase ===
        'review'
      ) {
        if (
          state.questionMap.size !==
          total
        ) {
          throw new Error(
            `Mock Review extracted ${state.questionMap.size} questions, but Total Questions is ${total}.`
          );
        }

        rebuildOutputs();

        resultsEl.style.display =
          'block';

        setProgress(
          100
        );

        setCounter(
          `${total} of ${total} saved`
        );

        setStatus(
          `Completed — ${total} Mock Exam Review questions extracted.`
        );
      }

    } catch (error) {
      console.error(
        '[Quiz Extractor v7]',
        error
      );

      setStatus(
        `Error: ${error.message}`
      );

      /*
        Only reviewed/extracted questions are retained.

        Mock Taking phase never saves questions.
      */

      if (
        state.questionMap.size
      ) {
        rebuildOutputs();

        resultsEl.style.display =
          'block';

        setCounter(
          `${state.questionMap.size} verified questions saved before error`
        );
      }

    } finally {
      state.running =
        false;

      startBtn.disabled =
        false;

      stopBtn.disabled =
        true;
    }
  }

  /* =========================================================
     EVENTS
     ========================================================= */

  startBtn.addEventListener(
    'click',
    run
  );

  stopBtn.addEventListener(
    'click',
    () => {
      state.stopRequested =
        true;

      setStatus(
        'Stopping after current safe operation…'
      );

      stopBtn.disabled =
        true;
    }
  );

  $('#qe-close')
    .addEventListener(
      'click',
      () => {
        if (
          state.running
        ) {
          const confirmed =
            confirm(
              'Quiz Extractor is still running. Stop and close it?'
            );

          if (!confirmed) {
            return;
          }

          state.stopRequested =
            true;
        }

        panel.remove();
        uiStyle.remove();
      }
    );

  $('#qe-open-q')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          state.questionHTML
        ) {
          openHTML(
            state.questionHTML
          );
        }
      }
    );

  $('#qe-open-a')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          state.answerHTML
        ) {
          openHTML(
            state.answerHTML
          );
        }
      }
    );

  $('#qe-download-q')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          !state.questionHTML
        ) {
          return;
        }

        downloadHTML(
          state.questionHTML,
          `${sanitizeFilename(
            state.quizTitle
          )} - Questions.html`
        );
      }
    );

  $('#qe-download-a')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          !state.answerHTML
        ) {
          return;
        }

        downloadHTML(
          state.answerHTML,
          `${sanitizeFilename(
            state.quizTitle
          )} - Answers.html`
        );
      }
    );

  /* =========================================================
     INITIAL AUTO DETECTION DISPLAY
     ========================================================= */

  try {
    const detected =
      autoDetectMode();

    if (
      detected ===
      'mock'
    ) {
      setDetected(
        'Mock Exam'
      );

      /*
        Mock navigator itself provides a useful passive hint:
        "1 ~ 125"

        We deliberately do NOT change the Total Questions field.
        User still enters/verifies it manually.
      */

      const combo =
        getNavigatorCombobox();

      const text =
        combo
          ?.textContent
          ?.trim();

      const match =
        text
          ?.match(
            /^\d+\s*~\s*(\d+)$/
          );

      if (match) {
        totalInput.placeholder =
          `e.g. ${match[1]}`;
      }

    } else {
      setDetected(
        'Quiz'
      );
    }
  } catch {}

  console.log(
    '%cQuiz Extractor v7 loaded.',
    'font-weight:bold;color:#2563eb'
  );

  console.log(
    'Supports Quiz, Mock Exam Taking, and Mock Exam Review.'
  );

})();
