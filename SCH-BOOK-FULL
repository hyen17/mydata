  const prepareMathForOutput = async (printWindow, mathMode, printProfile, setStatus) => {
    const doc = printWindow.document;
    const maths = Array.from(doc.querySelectorAll(".__coursePageSegment .MathJax_CHTML"));
    if (!maths.length) return { converted: 0, failed: 0 };

    if (mathMode === "original") {
      return { converted: 0, failed: 0, original: true };
    }

    if (mathMode === "fit") {
      fitMathInPrintWindow(printWindow, printProfile);
      await sleep(200);
      return { converted: 0, failed: 0 };
    }

    let html2canvas;
    try {
      setStatus?.("Loading MathJax image converter...");
      html2canvas = await loadHtml2Canvas(printWindow);
    } catch (e) {
      console.warn("[Kaplan Export] MathJax image converter unavailable; falling back to fit mode.", e);
      fitMathInPrintWindow(printWindow, printProfile);
      await sleep(200);
      return { converted: 0, failed: maths.length, fallback: true };
    }

    let converted = 0;
    let failed = 0;

    for (let i = 0; i < maths.length; i++) {
      const math = maths[i];
      if (!math.isConnected) continue;

      resetMathForMeasurement(math);
      const { fullWidth } = getMathParentContentWidth(printWindow, math, printProfile);
      const rect = math.getBoundingClientRect();
      // fullWidth is capped by physical printable paper width.
      const overWide = fullWidth > 0 && rect.width > fullWidth + 1;
      const shouldConvert = mathMode === "all-image" || (mathMode === "long-image" && overWide);

      if (!shouldConvert) continue;

      setStatus?.(`Converting MathJax to image ${i + 1}/${maths.length}...`);
      try {
        const ok = await convertMathToImage(
          printWindow,
          math,
          html2canvas,
          printProfile,
          mathMode === "long-image" && overWide
        );
        if (ok) converted++;
        else failed++;
      } catch (e) {
        failed++;
        console.warn("[Kaplan Export] Could not convert one MathJax formula; keeping original formula.", e, math);
      }

      if (i % 5 === 0) await sleep(0);
