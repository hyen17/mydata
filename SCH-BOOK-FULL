  };

  const countSelected = () =>
    pages.reduce((n, p) => n + (selectedKeys.has(p.pathKey) ? 1 : 0), 0);

  const updateSummary = () => {
    const selected = countSelected();
    const readingCount = hierarchy.reduce((n, t) => n + t.readings.length, 0);
    summaryEl.textContent = `${hierarchy.length} Topics - ${readingCount} Readings/groups - ${pages.length} pages - ${selected} selected`;
  };

  const checkboxStateForPages = (groupPages) => {
    const selected = groupPages.filter((p) => selectedKeys.has(p.pathKey)).length;
    return {
      checked: selected === groupPages.length && groupPages.length > 0,
      indeterminate: selected > 0 && selected < groupPages.length,
    };
  };

  const syncGroupCheckboxes = () => {
    listEl.querySelectorAll('input[data-topic-id]').forEach((cb) => {
      const topic = hierarchy[Number(cb.dataset.topicId)];
      if (!topic) return;
      const state = checkboxStateForPages(topic.pages);
      cb.checked = state.checked;
      cb.indeterminate = state.indeterminate;
    });

    listEl.querySelectorAll('input[data-reading-id]').forEach((cb) => {
      const readingId = Number(cb.dataset.readingId);
      const reading = hierarchy.flatMap((t) => t.readings).find((r) => r.id === readingId);
      if (!reading) return;
      const state = checkboxStateForPages(reading.pages);
      cb.checked = state.checked;
      cb.indeterminate = state.indeterminate;
    });

    updateSummary();
  };

  const renderList = () => {
    const filter = (filterEl.value || "").trim().toLowerCase();
    const bits = [];

    hierarchy.forEach((topic) => {
      const topicMatch = topic.title.toLowerCase().includes(filter);
      const matchingReadings = topic.readings.filter((reading) => {
        if (!filter || topicMatch) return true;
        if (reading.title.toLowerCase().includes(filter)) return true;
        return reading.pages.some((p) => p.title.toLowerCase().includes(filter));
      });

      if (filter && !topicMatch && !matchingReadings.length) return;

      bits.push(`
        <details data-topic-details="${topic.id}" open style="border-bottom:1px solid #e7e7e7;">
          <summary style="list-style:none;display:flex;align-items:center;gap:8px;padding:9px 12px;background:#f2f4f8;cursor:pointer;">
            <input type="checkbox" data-topic-id="${topic.id}" style="margin:0;">
            <span style="font-weight:800;flex:1;">${escapeHtml(topic.title)}</span>
            <span style="color:#777;font-size:11px;">${topic.pages.length} pages</span>
          </summary>
          <div>
      `);

      matchingReadings.forEach((reading) => {
        const readingMatch = reading.title.toLowerCase().includes(filter);
        const visiblePages = reading.pages.filter(
          (p) => !filter || topicMatch || readingMatch || p.title.toLowerCase().includes(filter)
        );

        bits.push(`
          <details data-reading-details="${reading.id}" open style="border-top:1px solid #eee;">
            <summary style="list-style:none;display:flex;align-items:flex-start;gap:8px;padding:8px 14px 7px 28px;background:#fafafa;cursor:pointer;">
              <input type="checkbox" data-reading-id="${reading.id}" style="margin-top:2px;">
              <span style="font-weight:700;flex:1;">${escapeHtml(reading.title)}</span>
              <span style="color:#888;font-size:11px;">${reading.pages.length}</span>
            </summary>
            <div>
        `);

        visiblePages.forEach((page) => {
          bits.push(`
            <label style="display:flex;gap:8px;padding:7px 14px 7px 48px;align-items:flex-start;cursor:pointer;">
              <input type="checkbox" data-page-key="${escapeHtml(page.pathKey)}" ${selectedKeys.has(page.pathKey) ? "checked" : ""} style="margin-top:2px;">
              <span style="min-width:0;">${escapeHtml(page.title)}</span>
            </label>
          `);
        });

        bits.push(`</div></details>`);
      });

      bits.push(`</div></details>`);
    });

    listEl.innerHTML = bits.join("") || '<div style="padding:12px 14px;color:#666;">No matching pages.</div>';
    syncGroupCheckboxes();
  };

  // Prevent clicking a group checkbox from also collapsing its <details>.
  listEl.addEventListener("click", (e) => {
    if (e.target.matches('input[data-topic-id],input[data-reading-id]')) {
      e.stopPropagation();
    }
  });

  listEl.addEventListener("change", (e) => {
    const target = e.target;

    if (target.matches('input[data-page-key]')) {
      if (target.checked) selectedKeys.add(target.dataset.pageKey);
      else selectedKeys.delete(target.dataset.pageKey);
      syncGroupCheckboxes();
      return;
    }

    if (target.matches('input[data-topic-id]')) {
      const topic = hierarchy[Number(target.dataset.topicId)];
      topic?.pages.forEach((p) => {
        if (target.checked) selectedKeys.add(p.pathKey);
        else selectedKeys.delete(p.pathKey);
      });
      renderList();
      return;
    }

    if (target.matches('input[data-reading-id]')) {
      const id = Number(target.dataset.readingId);
      const reading = hierarchy.flatMap((t) => t.readings).find((r) => r.id === id);
      reading?.pages.forEach((p) => {
        if (target.checked) selectedKeys.add(p.pathKey);
        else selectedKeys.delete(p.pathKey);
      });
      renderList();
    }
  });

  filterEl.addEventListener("input", renderList);

  const doScan = async () => {
    if (busy) return;

    setBusy(true);
    cancelled = false;

    try {
      pages = await scanCoursePages(setStatus);
      hierarchy = buildHierarchy(pages);

      // IMPORTANT: every detected page is selected by default.
      // This includes Module, Reading X: Key Concepts, Warm-Up, resources, etc.
      selectedKeys = new Set(pages.map((p) => p.pathKey));

      renderList();
      const directCount = pages.filter((p) => p.directTopicPage).length;
      setStatus(`Scan complete: ${pages.length} pages detected (${directCount} direct Topic pages/resources).`);
    } catch (e) {
      console.error(e);
      setStatus(`Scan failed: ${e.message}`);
      alert(`Scan gagal:\n${e.message}`);
    } finally {
      setBusy(false);
    }
  };

  const doExport = async () => {
    if (busy) return;

    const selected = pages.filter((p) => selectedKeys.has(p.pathKey));
    if (!selected.length) {
      alert("Pilih minimal satu page.");
      return;
    }

    const addTopicTitles = $('[data-role="topicTitles"]').checked;
    const addReadingTitles = $('[data-role="readingTitles"]').checked;
    const offline = $('[data-role="offline"]').checked;
    const mathMode = $('[data-role="mathMode"]').value || "fit";
    const tableMode = $('[data-role="tableMode"]').value || "fit";
    const printOptions = {
      paper: $('[data-role="paperSize"]')?.value || "A4",
      orientation: $('[data-role="orientation"]')?.value || "portrait",
      marginMm: Number($('[data-role="marginMm"]')?.value ?? 12),
    };

    const original = currentPageIdentity();
    const originalItem = pages.find((p) => p.pathKey === original.pathKey) || null;

    const headHtml = buildHeadFromBaseline();
    const captured = new Map();

    cancelled = false;
    setBusy(true);

    try {
      for (let i = 0; i < selected.length; i++) {
        if (cancelled) throw new Error("Export cancelled by user.");

        const item = selected[i];
        setStatus(`Loading ${i + 1}/${selected.length}: ${item.title}`);
        await navigateToItem(item);

        if (cancelled) throw new Error("Export cancelled by user.");

        setStatus(`Capturing ${i + 1}/${selected.length}: ${item.title}`);
        const wrapper = buildCourseWrapper();

        if (offline) {
          setStatus(`Inlining images ${i + 1}/${selected.length}: ${item.title}`);
          await inlineImagesInDom(wrapper);
        }

        captured.set(item.pathKey, wrapper);
        await sleep(40);
      }

      setStatus("Building hierarchical HTML...");

      const segments = [];
      const selectedKeySet = new Set(selected.map((p) => p.pathKey));

      hierarchy.forEach((topic) => {
        const selectedTopicPages = topic.pages.filter((p) => selectedKeySet.has(p.pathKey));
        if (!selectedTopicPages.length) return;

        if (addTopicTitles) {
          segments.push(
            buildDividerSegment(
              "topic",
              topic.title,
              `topic-${slugify(topic.title)}`
            ).outerHTML
          );
        }

        topic.readings.forEach((reading) => {
          const selectedReadingPages = reading.pages.filter((p) =>
            selectedKeySet.has(p.pathKey)
          );
          if (!selectedReadingPages.length) return;

          if (addReadingTitles && !reading.synthetic) {
            segments.push(
              buildDividerSegment(
                "reading",
                reading.title,
                `reading-${slugify(topic.title)}-${slugify(reading.title)}`
              ).outerHTML
            );
          }

          selectedReadingPages.forEach((page) => {
            const wrapper = captured.get(page.pathKey);
            if (!wrapper) return;

            segments.push(
              wrapAsSegment(
                wrapper,
                `page-${slugify(topic.title)}-${slugify(reading.title)}-${slugify(page.title)}`
              ).outerHTML
            );
          });
        });
      });

      const bodyHtml = segments.join("\n");
      const fileName = `${cleanFilename(BASELINE_BOOK_NAME)} - ${selected.length} pages`;
      setStatus("Preparing shared HTML/print document...");
      await openPrintDocument(fileName, headHtml, bodyHtml, mathMode, tableMode, printOptions);
      setStatus(`HTML saved and print dialog opened: ${fileName}`);
    } catch (e) {
      console.error(e);

      if (cancelled || /cancelled/i.test(e.message)) {
        setStatus("Print cancelled.");
      } else {
        setStatus(`Export failed: ${e.message}`);
        alert(`Print gagal:\n${e.message}\n\nLihat Console untuk detail.`);
      }
    } finally {
      if (originalItem && pathKey(location.href) !== originalItem.pathKey) {
        try {
          setStatus("Returning to the original page...");
          await navigateToItem(originalItem);
        } catch (e) {
          console.warn("Could not restore original page:", e);
        }
      }

      setBusy(false);
    }
  };

  // ============================================================
  // UI actions
  // ============================================================
  $('[data-act="close"]').onclick = () => {
    if (busy) {
      alert("Scan/export masih berjalan. Cancel terlebih dahulu.");
      return;
    }
    ui.remove();
  };

  $('[data-act="scan"]').onclick = doScan;

  $('[data-act="all"]').onclick = () => {
    selectedKeys = new Set(pages.map((p) => p.pathKey));
    renderList();
  };

  $('[data-act="clear"]').onclick = () => {
    selectedKeys.clear();
    renderList();
  };

  $('[data-act="expand"]').onclick = () => {
    listEl.querySelectorAll("details").forEach((d) => (d.open = true));
  };

  $('[data-act="collapse"]').onclick = () => {
    listEl.querySelectorAll("details").forEach((d) => (d.open = false));
  };

  $('[data-act="export"]').onclick = doExport;

  cancelBtn.onclick = () => {
    cancelled = true;
    setStatus("Cancelling after current operation...");
  };

  // Auto-scan.
  doScan();
})();
