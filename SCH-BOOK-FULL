(() => {
  const UI_ID = "__kaplanMultiPrintUI_v62";

  document.getElementById(UI_ID)?.remove();

  // ============================================================
  // Utilities
  // ============================================================
  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  const escapeHtml = (s) =>
    String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  const kill = (el) => el?.parentNode?.removeChild(el);

  const absolutize = (maybeUrl, base = location.href) => {
    try {
      return new URL(maybeUrl, base).href;
    } catch {
      return maybeUrl;
    }
  };

  const pathKey = (href) => {
    try {
      const u = new URL(href, location.href);
      return `${u.pathname}${u.search}${u.hash}`;
    } catch {
      return String(href || "");
    }
  };

  const cleanFilename = (name) =>
    String(name || "course-export")
      .trim()
      .replace(/[\\/:*?"<>|]+/g, "")
      .replace(/\s+/g, " ")
      .slice(0, 150) || "course-export";

  const slugify = (text) =>
    String(text || "section")
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80) || "section";

  const waitUntil = async (fn, timeout = 15000, interval = 100) => {
    const started = Date.now();
    let lastError = null;

    while (Date.now() - started < timeout) {
      try {
        const value = fn();
        if (value) return value;
      } catch (e) {
        lastError = e;
      }
      await sleep(interval);
    }

    if (lastError) throw lastError;
    throw new Error("Timeout waiting for page state.");
  };

  const blobToDataURL = (blob) =>
    new Promise((resolve, reject) => {
      const fr = new FileReader();
      fr.onload = () => resolve(fr.result);
      fr.onerror = reject;
      fr.readAsDataURL(blob);
    });

  const fetchAsBlob = async (url) => {
    const res = await fetch(url, {
      credentials: "omit",
      mode: "cors",
    }).catch(() => null);

    if (!res || !res.ok) throw new Error(`Fetch failed: ${url}`);
    return res.blob();
  };

  // ============================================================
  // DOM cleaner - based on the user's working single-page exporter
  // ============================================================
  const stripPrevNextAndExtras = (root) => {
    const removeSelectors = [
      'a[rel="next"]',
      'a[rel="prev"]',
      'button[rel="next"]',
      'button[rel="prev"]',
      '[aria-label*="next" i]',
      '[aria-label*="previous" i]',
      '[aria-label*="berikut" i]',
      '[aria-label*="sebelum" i]',
      '[data-testid*="next" i]',
      '[data-testid*="prev" i]',
      ".next",
      ".prev",
      ".previous",
      ".pagination-next",
      ".pagination-prev",
      ".Pagination-module__next",
      ".Pagination-module__prev",
    ];

    removeSelectors.forEach((sel) => root.querySelectorAll(sel).forEach(kill));

    root.querySelectorAll('a,button,[role="button"]').forEach((el) => {
      const t = (el.textContent || "").trim().toLowerCase();
      if (/(^|\b)(next|previous|prev|berikut|sebelumnya)(\b|$)/i.test(t)) {
        kill(el);
      }
    });

    [
      ".css-1j1yph6.ep2axm60",
      ".CourseFooter-module__container--ODkSx",
      ".CourseNode-module__toggleProgress--lJqih",
      ".CourseNodeHeader-module__col--n5QDr",
    ].forEach((sel) => root.querySelectorAll(sel).forEach(kill));
  };

  const inlineImagesInDom = async (root, onProgress) => {
    const imgs = Array.from(root.querySelectorAll("img"));

    for (let i = 0; i < imgs.length; i++) {
      const img = imgs[i];
      img.removeAttribute("srcset");
      img.removeAttribute("sizes");

      const src = img.getAttribute("src");
      if (!src || src.startsWith("data:")) continue;

      const abs = absolutize(src);
      try {
        const blob = await fetchAsBlob(abs);
        img.setAttribute("src", await blobToDataURL(blob));
      } catch {
        // Keep original URL if CORS/404 blocks embedding.
      }

      onProgress?.(i + 1, imgs.length);
      await sleep(0);
    }
  };

  const buildCourseWrapper = () => {
    const container = document.querySelector(
      ".CourseNode-module__container--ZjeFP"
    );

    if (!container) {
      throw new Error(
        "Elemen .CourseNode-module__container--ZjeFP tidak ditemukan."
      );
    }

    const clone = container.cloneNode(true);
    stripPrevNextAndExtras(clone);

    const wrapper = document.createElement("div");
    wrapper.className = "__exportWrapper";
    wrapper.appendChild(clone);
    return wrapper;
  };

  // ============================================================
  // BASELINE snapshot
  // Must happen BEFORE scan/navigation.
  // ============================================================
  const captureHeadSnapshot = () => ({
    stylesheets: Array.from(document.querySelectorAll('link[rel="stylesheet"]'))
      .filter((l) => l.href)
      .map((l) => l.href),
    styles: Array.from(document.head.querySelectorAll("style")).map(
      (s) => s.innerHTML
    ),
  });

  const BASELINE_HEAD = captureHeadSnapshot();

  const BASELINE_BOOK_NAME =
    (
      document.querySelector('[data-test-id="course-name"]')?.textContent ||
      document.querySelector('[data-id="toc-container"] [title]')?.getAttribute("title") ||
      "Course"
    )
      .replace(/\s+/g, " ")
      .trim();

  // Capture the exact Kaplan header structure once. It is later reused for
  // Topic and Reading title pages, so their blue header follows Kaplan CSS.
  const captureDividerTemplate = () => {
    const source = document.querySelector(
      ".CourseNode-module__container--ZjeFP"
    );
    if (!source) return null;

    const container = source.cloneNode(true);
    stripPrevNextAndExtras(container);

    const main = container.querySelector(".CourseNode-module__main--qTlT3");
    const header = container.querySelector(
      ".CourseNodeHeader-module__headerContainer--wVRFn"
    );

    if (!main || !header) return null;

    const cleanHeader = header.cloneNode(true);
    cleanHeader.querySelectorAll("button").forEach(kill);

    main.removeAttribute("id");
    main.innerHTML = "";
    main.appendChild(cleanHeader);

    return container;
  };

  const BASELINE_DIVIDER_TEMPLATE = captureDividerTemplate();

  // IMPORTANT BUG FIX:
  // Use a REAL newline "\n", not the two literal characters "\\n".
  // Literal \\n text inside <head> is non-whitespace text and makes the HTML parser
  // move following <meta>/<link>/<style> nodes into <body>.
  const buildHeadFromBaseline = () => {
    const headBits = [
      '<meta charset="utf-8">',
      '<meta name="viewport" content="width=device-width, initial-scale=1">',
    ];

    BASELINE_HEAD.stylesheets.forEach((href) => {
      headBits.push(`<link rel="stylesheet" href="${escapeHtml(href)}">`);
    });

    BASELINE_HEAD.styles.forEach((css) => {
      headBits.push(`<style>${css}</style>`);
    });

    // Keep the same base additions as the user's working exporter.
    // Extra CSS affects only our OUTER segment/divider elements, never the
    // cloned Kaplan CourseNode content itself.
    headBits.push(`<style>
      :root { --font-ui: "Open Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
      html, body {
        margin:0;
        padding:0;
        width:100%;
        max-width:100%;
        font-family:var(--font-ui);
        overflow-x:clip;
      }

      .__exportSegment {
        display:block;
        width:100%;
        max-width:100%;
        box-sizing:border-box;
      }

      .__exportWrapper {
        padding:16px;
        width:100%;
        max-width:100%;
        box-sizing:border-box;
      }

      /*
       * Do not allow a cloned Kaplan layout container to enlarge the document
       * beyond the current viewport / printable width.
       */
      .__coursePageSegment .CourseNode-module__container--ZjeFP,
      .__coursePageSegment .CourseNode-module__main--qTlT3,
      .__coursePageSegment .Content-module__container--L1Ylg,
      .__coursePageSegment .Content-module__column--zj7m5,
      .__coursePageSegment .Content-module__contentText--iH9YR {
        max-width:100%;
        box-sizing:border-box;
      }

      /*
       * Example/callout boxes in the source commonly use inline background and
       * border styles. content-box plus a border can otherwise add a few pixels
       * beyond the available width in the standalone export.
       */
      .__coursePageSegment .Content-module__contentText--iH9YR > div {
        max-width:100%;
        box-sizing:border-box;
      }

      .__coursePageSegment img,
      .__coursePageSegment svg,
      .__coursePageSegment canvas,
      .__coursePageSegment table,
      .__coursePageSegment figure {
        max-width:100%;
      }

      /*
       * MathJax output is intentionally non-wrapping. The runtime helper below
       * first moves an overflowing formula to its own line at the SAME size.
       * Only a formula that is still wider than the parent is scaled.
       */
      .__coursePageSegment .MathJax_CHTML {
        transform-origin:left center;
      }

      /*
       * max-width alone cannot constrain tables whose intrinsic/min width is
       * larger than the printable area. The runtime fitter below measures the
       * real rendered table width and shrinks ONLY an over-wide table.
       */
      .__coursePageSegment table {
        transform-origin:left top;
      }

      img { max-width:100%; height:auto; }

      .__dividerSegment {
        box-sizing:border-box;
        min-height:72vh;
        padding:16px;
        background:#fff;
      }

      .__dividerSegment .CourseNode-module__container--ZjeFP {
        width:100%;
      }

      .__dividerKicker {
        color:rgba(255,255,255,.86);
        font-size:12px;
        font-weight:700;
        letter-spacing:.14em;
        text-transform:uppercase;
        margin-bottom:8px;
      }

      .__topicDivider [data-test-id="course-module-name"] {
        font-size:38px !important;
        line-height:1.16 !important;
        font-weight:600 !important;
        bookmark-level:1;
        bookmark-label:content(text);
      }

      .__readingDivider [data-test-id="course-module-name"] {
        font-size:29px !important;
        line-height:1.2 !important;
        font-weight:600 !important;
        bookmark-level:2;
        bookmark-label:content(text);
      }

      @media print {
        .__exportSegment + .__exportSegment {
          break-before:page !important;
          page-break-before:always !important;
        }

        .__dividerSegment {
          min-height:88vh;
        }
      }
    </style>`);

    // REAL newline. Do not change this to "\\n".
    return headBits.join("\n");
  };

  const buildDividerSegment = (kind, title, anchorId) => {
    const segment = document.createElement("section");
    segment.className = `__exportSegment __dividerSegment __${kind}Divider`;
    segment.id = anchorId;

    let container = BASELINE_DIVIDER_TEMPLATE?.cloneNode(true) || null;

    if (container) {
      const titleEl = container.querySelector('[data-test-id="course-module-name"]');
      const bookEl = container.querySelector('[data-test-id="course-name"]');

      if (titleEl) {
        titleEl.textContent = title;
        const kicker = document.createElement("div");
        kicker.className = "__dividerKicker";
        kicker.textContent = kind === "topic" ? "TOPIC" : "READING";
        titleEl.parentElement?.insertBefore(kicker, titleEl);
      }

      if (bookEl) bookEl.textContent = BASELINE_BOOK_NAME;

      segment.appendChild(container);
    } else {
      // Fallback if Kaplan changes the header DOM.
      segment.innerHTML = `
        <div style="padding:48px;background:linear-gradient(120deg,#29147e,#0868df);color:#fff;">
          <div class="__dividerKicker">${kind === "topic" ? "TOPIC" : "READING"}</div>
          <div style="font-size:${kind === "topic" ? "38px" : "29px"};font-weight:600;line-height:1.2;">${escapeHtml(title)}</div>
          <div style="margin-top:10px;font-size:14px;font-weight:600;text-transform:uppercase;">${escapeHtml(BASELINE_BOOK_NAME)}</div>
        </div>`;
    }

    return segment;
  };

  const wrapAsSegment = (wrapper, anchorId) => {
    const section = document.createElement("section");
    section.className = "__exportSegment __coursePageSegment";
    if (anchorId) section.id = anchorId;
    section.appendChild(wrapper);
    return section;
  };

  // ============================================================
  // MathJax fitting executed from the MAIN script.
  // No JavaScript is injected into the temporary print document.
  // This avoids secondary parse/runtime errors inside the print window.
  // ============================================================
  const cssNumber = (value) => {
    const n = parseFloat(value);
    return Number.isFinite(n) ? n : 0;
  };

  const PRINT_PAPERS_MM = {
    A4: { width: 210, height: 297 },
    Legal: { width: 215.9, height: 355.6 },
    Letter: { width: 215.9, height: 279.4 },
    Tabloid: { width: 279.4, height: 431.8 },
    A3: { width: 297, height: 420 },
  };

  const makePrintProfile = (paper = "A4", orientation = "portrait", marginMm = 12) => {
    const base = PRINT_PAPERS_MM[paper] || PRINT_PAPERS_MM.A4;
    const landscape = orientation === "landscape";
    const pageWidthMm = landscape ? base.height : base.width;
    const pageHeightMm = landscape ? base.width : base.height;
    const safeMarginMm = Math.max(0, Math.min(35, Number(marginMm) || 0));
    const printableWidthMm = Math.max(20, pageWidthMm - safeMarginMm * 2);
    const printableHeightMm = Math.max(20, pageHeightMm - safeMarginMm * 2);
    const MM_TO_CSS_PX = 96 / 25.4;
    return {
      paper,
      orientation: landscape ? "landscape" : "portrait",
      marginMm: safeMarginMm,
      pageWidthMm,
      pageHeightMm,
      printableWidthMm,
      printableHeightMm,
      printableWidthPx: printableWidthMm * MM_TO_CSS_PX,
    };
  };

  const getEffectiveMathLimit = (printWindow, math, printProfile) => {
    const parent = math.closest("p, li, td, th, div") || math.parentElement;
    if (!parent) return { parent: null, parentWidth: 0, limit: 0 };
    const cs = printWindow.getComputedStyle(parent);
    const parentWidth = Math.max(
      0,
      parent.clientWidth - cssNumber(cs.paddingLeft) - cssNumber(cs.paddingRight)
    );
    const paperLimit = printProfile?.printableWidthPx || Number.POSITIVE_INFINITY;
    const limit = Math.max(0, Math.min(parentWidth || paperLimit, paperLimit));
    return { parent, parentWidth, limit };
  };

  const fitMathInPrintWindow = (printWindow, printProfile = makePrintProfile()) => {
    const doc = printWindow.document;
    const maths = Array.from(
      doc.querySelectorAll('.__coursePageSegment .MathJax_CHTML')
    );

    const reset = (math) => {
      math.style.removeProperty('zoom');
      math.style.removeProperty('display');
      math.style.removeProperty('margin-top');
      math.style.removeProperty('margin-bottom');
      math.removeAttribute('data-export-fitted');
    };

    const contentWidth = (parent) => {
      const cs = printWindow.getComputedStyle(parent);
      return Math.max(
        0,
        parent.clientWidth - cssNumber(cs.paddingLeft) - cssNumber(cs.paddingRight)
      );
    };

    const widthFromCurrentPosition = (math, parent) => {
      const pr = parent.getBoundingClientRect();
      const mr = math.getBoundingClientRect();
      const cs = printWindow.getComputedStyle(parent);
      return Math.max(0, pr.right - cssNumber(cs.paddingRight) - mr.left);
    };

    maths.forEach((math) => {
      if (!math.isConnected) return;
      reset(math);

      const parent = math.closest('p, li, td, th, div') || math.parentElement;
      if (!parent) return;

      const rect = math.getBoundingClientRect();
      const mathWidth = rect.width;
      const availableAtPosition = widthFromCurrentPosition(math, parent);
      const { limit: effectiveLimit } = getEffectiveMathLimit(printWindow, math, printProfile);
      const available = Math.min(availableAtPosition || effectiveLimit, effectiveLimit);
      const fullWidth = effectiveLimit;

      if (!mathWidth || !available || !fullWidth) return;
      if (mathWidth <= available + 1) return;

      // If it only overflows because text precedes it, move it to a new line.
      if (mathWidth <= fullWidth + 1) {
        math.style.setProperty('display', 'block', 'important');
        math.style.setProperty('margin-top', '0.22em', 'important');
        math.style.setProperty('margin-bottom', '0.12em', 'important');
        math.setAttribute('data-export-fitted', 'newline');
        return;
      }

      // Intrinsically too wide: shrink ONLY this formula, never the page text.
      const scale = Math.max(0.30, Math.min(1, (fullWidth - 2) / mathWidth));
      math.style.setProperty('display', 'inline-block', 'important');
      math.style.setProperty('zoom', String(scale), 'important');
      math.setAttribute('data-export-fitted', 'scaled');

      // Extreme-case final guard. If still wider after Chromium applies zoom,
      // calculate one more correction, allowing scale below 30% only when needed
      // to prevent clipping beyond the printable content width.
      const after = math.getBoundingClientRect().width;
      if (after > fullWidth + 1 && after > 0) {
        const correction = (fullWidth - 2) / after;
        const finalScale = Math.max(0.10, scale * correction);
        math.style.setProperty('zoom', String(finalScale), 'important');
        math.setAttribute('data-export-fitted', 'scaled-final');
      }
    });
  };


  // ============================================================
  // Table fitting
  // max-width:100% is not enough for tables with intrinsic width,
  // fixed column widths, nowrap cells, long URLs, etc.
  //
  // IMPORTANT:
  // - Do NOT resize the whole page.
  // - Do NOT change normal tables.
  // - Only an actually over-wide table is scaled down.
  // - Printable paper width is used as the hard upper boundary.
  // ============================================================
  const getEffectiveTableLimit = (printWindow, table, printProfile) => {
    const parent =
      table.parentElement?.closest(
        "td, th, li, .Content-module__contentText--iH9YR, .Content-module__column--zj7m5, .Content-module__container--L1Ylg, .CourseNode-module__main--qTlT3"
      ) ||
      table.parentElement;

    if (!parent) {
      return {
        parent: null,
        parentWidth: 0,
        paperLimit: printProfile?.printableWidthPx || 0,
        limit: printProfile?.printableWidthPx || 0,
      };
    }

    const cs = printWindow.getComputedStyle(parent);
    const parentWidth = Math.max(
      0,
      parent.clientWidth -
        cssNumber(cs.paddingLeft) -
        cssNumber(cs.paddingRight) -
        cssNumber(cs.borderLeftWidth) -
        cssNumber(cs.borderRightWidth)
    );

    const paperLimit =
      printProfile?.printableWidthPx || Number.POSITIVE_INFINITY;

    const limit = Math.max(
      0,
      Math.min(parentWidth || paperLimit, paperLimit)
    );

    return { parent, parentWidth, paperLimit, limit };
  };

  const resetTableForMeasurement = (table) => {
    table.style.removeProperty("zoom");
    table.style.removeProperty("transform");
    table.style.removeProperty("transform-origin");
    table.style.removeProperty("max-width");
    table.removeAttribute("data-export-table-fitted");
    table.removeAttribute("data-export-table-scale");
  };

  const fitTablesInPrintWindow = (
    printWindow,
    printProfile = makePrintProfile()
  ) => {
    const doc = printWindow.document;
    const tables = Array.from(
      doc.querySelectorAll(".__coursePageSegment table")
    );

    let fitted = 0;

    tables.forEach((table) => {
      if (!table.isConnected) return;

      resetTableForMeasurement(table);

      const { limit } = getEffectiveTableLimit(
        printWindow,
        table,
        printProfile
      );

      if (!limit) return;

      /*
       * scrollWidth is important here. getBoundingClientRect().width can report
       * the CSS box width while content inside the table still overflows it.
       */
      const rect = table.getBoundingClientRect();
      const visualWidth = rect.width || 0;
      const intrinsicWidth = Math.max(
        table.scrollWidth || 0,
        table.offsetWidth || 0,
        visualWidth
      );

      if (!intrinsicWidth || intrinsicWidth <= limit + 1) return;

      /*
       * Chromium's zoom changes layout width as well as visual width, which is
       * preferable to transform:scale() here because transform can leave the
       * original oversized layout footprint behind.
       */
      let scale = Math.min(1, (limit - 2) / intrinsicWidth);
      scale = Math.max(0.10, scale);

      table.style.setProperty("transform-origin", "left top", "important");
      table.style.setProperty("zoom", String(scale), "important");
      table.style.setProperty("max-width", "none", "important");
      table.setAttribute("data-export-table-fitted", "scaled");
      table.setAttribute("data-export-table-scale", String(scale));

      /*
       * One correction pass after Chromium has applied zoom. This catches
       * tables whose cells/colgroups recompute after zoom is set.
       */
      const afterRect = table.getBoundingClientRect();
      const afterWidth = Math.max(
        afterRect.width || 0,
        (table.scrollWidth || 0) * scale
      );

      if (afterWidth > limit + 1 && afterWidth > 0) {
        const correction = (limit - 2) / afterWidth;
        scale = Math.max(0.05, scale * correction);
        table.style.setProperty("zoom", String(scale), "important");
        table.setAttribute("data-export-table-fitted", "scaled-final");
        table.setAttribute("data-export-table-scale", String(scale));
      }

      fitted++;
    });

    return { total: tables.length, fitted };
  };

  const waitForPrintDocumentReady = async (printWindow, timeout = 20000) => {
    const doc = printWindow.document;
    const started = Date.now();

    const waitImages = async () => {
      const images = Array.from(doc.images || []);
      await Promise.all(
        images.map((img) => {
          if (img.complete) return Promise.resolve();
          return new Promise((resolve) => {
            const done = () => resolve();
            img.addEventListener("load", done, { once: true });
            img.addEventListener("error", done, { once: true });
            setTimeout(done, 5000);
          });
        })
      );
    };

    await waitImages();

    if (doc.fonts?.ready) {
      await Promise.race([doc.fonts.ready.catch(() => null), sleep(7000)]);
    }

    // Give Chromium time to apply copied Kaplan CSS + generated MathJax CHTML.
    await sleep(350);


    while (Date.now() - started < timeout) {
      const root = doc.body;
      if (root && root.scrollHeight > 0) break;
      await sleep(100);
    }

    await sleep(450);
  };

  const loadHtml2Canvas = async (printWindow) => {
    if (typeof printWindow.html2canvas === "function") return printWindow.html2canvas;

    await new Promise((resolve, reject) => {
      const existing = printWindow.document.querySelector('script[data-kaplan-html2canvas="1"]');
      if (existing) {
        const started = Date.now();
        const poll = setInterval(() => {
          if (typeof printWindow.html2canvas === "function") {
            clearInterval(poll);
            resolve();
          } else if (Date.now() - started > 12000) {
            clearInterval(poll);
            reject(new Error("html2canvas load timeout."));
          }
        }, 100);
        return;
      }

      const script = printWindow.document.createElement("script");
      script.src = "https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js";
      script.async = true;
      script.dataset.kaplanHtml2canvas = "1";
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("Could not load html2canvas."));
      printWindow.document.head.appendChild(script);
    });

    if (typeof printWindow.html2canvas !== "function") {
      throw new Error("html2canvas is unavailable.");
    }

    return printWindow.html2canvas;
  };

  const getMathParentContentWidth = (printWindow, math, printProfile = makePrintProfile()) => {
    const { parent, parentWidth, limit } = getEffectiveMathLimit(printWindow, math, printProfile);
    return { parent, fullWidth: limit, parentWidth, paperWidth: printProfile.printableWidthPx };
  };

  const resetMathForMeasurement = (math) => {
    math.style.removeProperty("zoom");
    math.style.removeProperty("display");
    math.style.removeProperty("margin-top");
    math.style.removeProperty("margin-bottom");
    math.removeAttribute("data-export-fitted");
  };

  const convertMathToImage = async (printWindow, math, html2canvas, printProfile, forceBlock = false) => {
    resetMathForMeasurement(math);

    const { parent, fullWidth } = getMathParentContentWidth(printWindow, math, printProfile);
    if (!parent || fullWidth <= 0) return false;

    const rect = math.getBoundingClientRect();
    if (!rect.width || !rect.height) return false;

    const captureScale = Math.min(3, Math.max(2, printWindow.devicePixelRatio || 1));
    const canvas = await html2canvas(math, {
      backgroundColor: null,
      logging: false,
