    doc.querySelectorAll("img.__mathjaxImage").forEach((img) => {
      const { fullWidth } = getMathParentContentWidth(printWindow, img, printProfile);
      if (!fullWidth) return;
      const rect = img.getBoundingClientRect();
      if (rect.width > fullWidth + 1) {
        img.style.setProperty("width", `${Math.max(1, fullWidth - 2)}px`, "important");
