(() => {
  // ================================================================
  // JSON -> HTML Converter (Becker per-category JSON) v3.2
  // - Tidak combine/split category
  // - Setiap file JSON menghasilkan:
  //   <nama-json> - Questions.html
  //   <nama-json> - Answer.html
  // - CSS utama dari Becker CDN
  // ================================================================

  const BECKER_CSS_URL = 'https://cdn-cpa.becker.com/public/frontend/_assets/assets/question-D1jw6Y6r-v3.css';
  const letters = (n) => String.fromCharCode(64 + n); // 1 -> A

  // ---------- Sanitizers ----------
  function replaceChoiceNumberTokens(html) {
    if (!html) return html;
    return String(html).replace(/#([1-9]|1[0-9]|2[0-6])#/g, (_, n) => letters(Number(n)));
  }

  function removeSrOnly(html) {
    if (!html) return html;
    const div = document.createElement('div');
    div.innerHTML = html;
    div.querySelectorAll('.sr-only').forEach(el => el.remove());
    return div.innerHTML;
  }

  function fixWileyMathSVG(html) {
    if (!html) return html;
    if (!html.includes('data-svg')) return html;

    const div = document.createElement('div');
    div.innerHTML = html;
    div.querySelectorAll('span[data-svg]').forEach(span => {
      const svgContent = span.getAttribute('data-svg');
      if (!svgContent) return;
      const spanWrapper = document.createElement('span');
      spanWrapper.className = 'mjx-svg-fix';
      spanWrapper.style.display = 'inline-block';
      spanWrapper.style.verticalAlign = 'middle';
      spanWrapper.innerHTML = svgContent;
      span.replaceWith(spanWrapper);
    });
    return div.innerHTML;
  }

  function removeChoicePercentSpans(html) {
    if (!html) return html;
    return String(html)
      .replace(/<span[^>]*class=["']?choice-percent["']?[^>]*>[\s\S]*?<\/span>/gi, '')
      .replace(/\(\s*\d{1,3}%\s*\)/g, '');
  }

  function cleanMathTags(html) {
    if (!html) return html;
    let h = String(html);
    h = h.replace(/<\/?\w+:displayeditem[^>]*>/gi, '');
    h = h.replace(/xmlns(:\w+)?="[^"]*"/gi, '');
    return h;
  }

  function removeVideoAndEmptyP(html) {
    if (!html) return html;
    let h = String(html);
    h = h.replace(/<a\b[^>]*>\s*Video\s*<\/a>/gi, '');
    h = h.replace(/<p\b[^>]*>[\s\S]*?<\/p>/gi, (m) => {
      if (/<img\b/i.test(m)) return m;
      if (/<svg|data-svg/i.test(m)) return m;
      if (/^<p[^>]*>\s*(?:&nbsp;|\s|<br\s*\/?>)*<\/p>$/i.test(m)) return '';
      return m;
    });
    h = h.replace(/>\s+</g, '><');
    return h;
  }

  function removeEssayPrompt(html) {
    if (!html) return html;
    return String(html).replace(/type\s+your\s+response\s+here\b[.\s:]*/gi, '');
  }

  function removeInternalLinks(html) {
    if (!html) return html;
    const div = document.createElement('div');
    div.innerHTML = html;
    div.querySelectorAll('a[href]').forEach(a => {
      const href = (a.getAttribute('href') || '').trim();
      const isExternal = /^(https?:)?\/\//i.test(href) || /^mailto:/i.test(href) || /^tel:/i.test(href) || /^#/i.test(href);
      const isInternal = /^\d+$/.test(href) || href === '' || (!isExternal && !/[./:?#]/.test(href));
      if (isInternal) a.replaceWith(document.createTextNode(a.textContent || ''));
    });
    return div.innerHTML;
  }

  function applySmartTableClasses(html) {
    if (!html) return html;
    const div = document.createElement('div');
    div.innerHTML = html;
    div.querySelectorAll('table').forEach(table => {
      const classAttr = table.getAttribute('class') || '';
      const borderAttr = (table.getAttribute('border') || '').trim();
      const styleAttr = (table.getAttribute('style') || '').toLowerCase();

      if (!/table-default-style|table-custom-style|table-CFA-default-style|gr-table-default-style/.test(classAttr)) {
        table.classList.add('table-default-style');
      }

      const noBorder = borderAttr === '0' || /\bborder_outer_none\b|\bborder_no\b|\bborder-no\b/.test(classAttr) || /border\s*:\s*none/.test(styleAttr);
      if (noBorder) table.classList.add('table-No-Border');
    });
    return div.innerHTML;
  }



  function fixLongTableCells(html) {
    if (!html) return html;
    const div = document.createElement('div');
    div.innerHTML = html;

    function stripWhiteSpaceNowrap(cell) {
      const style = cell.getAttribute('style') || '';
      const cleaned = style
        .replace(/(?:^|;)\s*white-space\s*:\s*nowrap\s*;?/ig, ';')
        .replace(/;{2,}/g, ';')
        .replace(/^\s*;|;\s*$/g, '')
        .trim();

      if (cleaned) cell.setAttribute('style', cleaned);
      else cell.removeAttribute('style');
    }

    div.querySelectorAll('table').forEach(table => {
      let hasNarrativeNote = false;
      let maxColumnCount = 0;

      const rows = Array.from(table.querySelectorAll('tr'));
      rows.forEach(row => {
        const cells = Array.from(row.children).filter(el => /^(TD|TH)$/i.test(el.tagName));
        maxColumnCount = Math.max(maxColumnCount, cells.length);

        cells.forEach((cell, idx) => {
          const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          if (!text) return;

          const looksLikeAmount = /^\(?\s*\$?\s*[\d,]+(?:\.\d+)?\s*\)?\s*%?\s*$/.test(text);
          const wordCount = text.split(/\s+/).length;

          // Target utama: kolom catatan/narasi panjang di table perhitungan 3 kolom.
          // Jangan mengubah table biasa 2 kolom yang sudah wrap normal.
          if (idx >= 2 && !looksLikeAmount && (text.length > 85 || wordCount >= 10)) {
            hasNarrativeNote = true;
            cell.classList.add('becker-wrap-cell', 'becker-note-cell');
            stripWhiteSpaceNowrap(cell);
          }
        });
      });

      if (hasNarrativeNote && maxColumnCount >= 3) {
        table.classList.add('becker-has-wrap-cell', 'becker-long-note-table');

        // Di table semacam ini, label kolom pertama yang cukup panjang juga boleh wrap.
        // Kolom nominal tetap dibiarkan nowrap agar angka tidak pecah.
        rows.forEach(row => {
          const cells = Array.from(row.children).filter(el => /^(TD|TH)$/i.test(el.tagName));
          cells.forEach((cell, idx) => {
            const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
            if (!text) return;
            if (idx === 0 && text.length > 30) {
              cell.classList.add('becker-wrap-cell', 'becker-label-cell');
              stripWhiteSpaceNowrap(cell);
            }
          });
        });
      }

      // v3.1: perbaikan statis yang lebih mirip pendekatan Colab:
      // Jangan mengecilkan font. Untuk table non-choice yang *kemungkinan* melebar karena
      // inline white-space:nowrap dari JSON Becker, hilangkan nowrap hanya pada teks panjang.
      // Angka, simbol, dan cell pendek tetap nowrap.
      if (!table.classList.contains('becker-options-table')) {
        const allCells = Array.from(table.querySelectorAll('td, th'));

        const visualColumnCount = rows.reduce((max, row) => {
          const cells = Array.from(row.children).filter(el => /^(TD|TH)$/i.test(el.tagName));
          const count = cells.reduce((sum, cell) => sum + Number(cell.getAttribute('colspan') || '1'), 0);
          return Math.max(max, count);
        }, maxColumnCount);

        function isNumberLikeText(text) {
          const t = String(text || '').replace(/\s+/g, ' ').trim();
          if (!t) return true;
          if (/^[=×+\-–—]$/.test(t)) return true;
          if (/^\(?\s*[$S]?\s*[\d,]+(?:\.\d+)?\s*\)?\s*%?\s*$/.test(t)) return true;
          if (/^\(?\s*[\d,]+(?:\.\d+)?\s*\)?\s*(units?|types?|orders?)?$/i.test(t)) return true;
          return false;
        }

        function hasInlineNowrap(cell) {
          return /white-space\s*:\s*nowrap/i.test(cell.getAttribute('style') || '');
        }

        function isTextLikeLongCell(cell) {
          const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          if (!text || isNumberLikeText(text)) return false;
          const wordCount = text.split(/\s+/).length;
          const isHeader = /^TH$/i.test(cell.tagName);
          const colspan = Number(cell.getAttribute('colspan') || '1');

          // v3.1: aturan utama untuk sumber masalah Becker:
          // Jika non-choice table punya inline white-space:nowrap pada teks/header panjang,
          // hapus nowrap langsung. Ini meniru hasil Colab yang lebih membiarkan table wrap,
          // namun tetap menjaga angka/simbol/cell pendek agar tidak pecah.
          if (!hasInlineNowrap(cell)) return false;
          if (isHeader && (text.length > 18 || wordCount >= 3)) return true;
          if (visualColumnCount === 1 && text.length > 35) return true;
          if (visualColumnCount === 2 && text.length > 35) return true;
          if (visualColumnCount >= 3 && (text.length > 28 || wordCount >= 4 || colspan > 1)) return true;
          return false;
        }

        let staticLongNowrapFixed = false;
        allCells.forEach(cell => {
          if (isTextLikeLongCell(cell)) {
            cell.classList.add('becker-wide-wrap-cell');
            stripWhiteSpaceNowrap(cell);
            staticLongNowrapFixed = true;
          }
        });
        if (staticLongNowrapFixed) {
          table.classList.add('becker-wide-wrap-table', 'becker-static-nowrap-fixed-table');
          if (visualColumnCount === 2) table.classList.add('becker-statement-wrap-table');
          if (visualColumnCount >= 5) table.classList.add('becker-wide-header-wrap-table');
        }

        const hasLongSingleCellFormula = visualColumnCount === 1 && allCells.some(cell => {
          const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          return text.length > 95 && hasInlineNowrap(cell);
        });

        const hasLongColspanLayout = visualColumnCount >= 4 && allCells.some(cell => {
          const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          const colspan = Number(cell.getAttribute('colspan') || '1');
          return !isNumberLikeText(text) && text.length > 48 && colspan > 1;
        });

        // Table 2 kolom berisi statement I/II/III: kolom statement biasanya panjang dan nowrap.
        const hasLongTwoColumnStatement = visualColumnCount === 2 && rows.some(row => {
          const cells = Array.from(row.children).filter(el => /^(TD|TH)$/i.test(el.tagName));
          if (cells.length < 2) return false;
          const left = (cells[0].textContent || '').replace(/\s+/g, ' ').trim();
          const right = (cells[1].textContent || '').replace(/\s+/g, ' ').trim();
          return /^(I|II|III|IV|V|VI|VII|VIII|IX|X)\.?$/i.test(left) && right.length > 80 && hasInlineNowrap(cells[1]);
        });

        // Table lebar dengan banyak kolom dan header panjang seperti Workers / MRC / MRP.
        // Header panjang boleh wrap; angka dan data pendek tetap nowrap.
        const hasWideHeaderTable = visualColumnCount >= 5 && Array.from(table.querySelectorAll('th')).some(th => {
          const text = (th.textContent || '').replace(/\s+/g, ' ').trim();
          return text.length > 22 && hasInlineNowrap(th);
        });

        const shouldWrapWide = hasLongSingleCellFormula || hasLongColspanLayout || hasLongTwoColumnStatement || hasWideHeaderTable;

        if (shouldWrapWide) {
          table.classList.add('becker-wide-wrap-table');
          if (hasLongTwoColumnStatement) table.classList.add('becker-statement-wrap-table');
          if (hasWideHeaderTable) table.classList.add('becker-wide-header-wrap-table');

          rows.forEach(row => {
            const cells = Array.from(row.children).filter(el => /^(TD|TH)$/i.test(el.tagName));
            cells.forEach((cell, idx) => {
              const text = (cell.textContent || '').replace(/\s+/g, ' ').trim();
              const wordCount = text ? text.split(/\s+/).length : 0;
              const isHeader = /^TH$/i.test(cell.tagName);
              const numberLike = isNumberLikeText(text);
              const colspan = Number(cell.getAttribute('colspan') || '1');

              let shouldWrapCell = false;
              if (hasLongSingleCellFormula && text.length > 35 && !numberLike) shouldWrapCell = true;
              if (hasLongColspanLayout && !numberLike && (text.length > 35 || colspan > 1)) shouldWrapCell = true;
              if (hasLongTwoColumnStatement && idx >= 1 && !numberLike && text.length > 45) shouldWrapCell = true;
              if (hasWideHeaderTable && isHeader && !numberLike && (text.length > 18 || wordCount >= 3)) shouldWrapCell = true;

              // Data cell panjang pada table banyak kolom juga boleh wrap, tapi jangan sentuh angka/simbol.
              if (hasWideHeaderTable && !isHeader && !numberLike && (text.length > 28 || wordCount >= 4)) shouldWrapCell = true;

              if (shouldWrapCell) {
                cell.classList.add('becker-wide-wrap-cell');
                stripWhiteSpaceNowrap(cell);
              }
            });
          });
        }
      }
    });

    return div.innerHTML;
  }


  function sanitizeContent(html) {
    if (!html) return '';
    let s = String(html);
    s = removeSrOnly(s);
    s = fixWileyMathSVG(s);
    s = cleanMathTags(s);
    s = removeChoicePercentSpans(s);
    s = removeVideoAndEmptyP(s);
    s = removeEssayPrompt(s);
    s = removeInternalLinks(s);
    s = applySmartTableClasses(s);
    s = fixLongTableCells(s);
    return s.trim();
  }

  function unwrapOptionTd(html) {
    if (!html) return '';
    const table = document.createElement('table');
    table.innerHTML = `<tbody><tr>${String(html).trim()}</tr></tbody>`;
    const tds = table.querySelectorAll('td.optionText, td[class*="optionText"]');
    if (tds.length) {
      return Array.from(tds).map(td => td.innerHTML).join('');
    }

    const div = document.createElement('div');
    div.innerHTML = String(html).trim();
    return div.innerHTML;
  }

  function sanitizeTableRowCells(cellsHtml) {
    if (!cellsHtml) return '';
    const wrapped = `<table><tbody><tr>${String(cellsHtml)}</tr></tbody></table>`;
    const cleaned = sanitizeContent(wrapped);
    const div = document.createElement('div');
    div.innerHTML = cleaned;
    const tr = div.querySelector('tr');
    return tr ? tr.innerHTML : String(cellsHtml);
  }

  function countTableCells(cellsHtml) {
    if (!cellsHtml) return 0;
    const table = document.createElement('table');
    table.innerHTML = `<tbody><tr>${String(cellsHtml)}</tr></tbody>`;
    return table.querySelectorAll('td, th').length;
  }


  function extractRowCells(cellsHtml, defaultTag) {
    const table = document.createElement('table');
    table.innerHTML = `<tbody><tr>${String(cellsHtml || '')}</tr></tbody>`;
    const tr = table.querySelector('tr');
    if (!tr) return [];

    return Array.from(tr.children)
      .filter(el => /^(td|th)$/i.test(el.tagName))
      .map(el => {
        const tag = defaultTag || el.tagName.toLowerCase();
        let inner = sanitizeContent(el.innerHTML || '');
        let style = el.getAttribute('style') || '';

        // v1.8: optionTexts dari Becker sering memakai class optionText.
        // Class itu ditargetkan CSS Becker khusus untuk pilihan radio asli,
        // jadi untuk output table custom kita buang agar cell tidak dirender aneh.
        return {
          tag,
          inner,
          style
        };
      });
  }

  function renderHeaderCells(cellsHtml) {
    const cells = extractRowCells(cellsHtml, 'th');
    return cells.map(cell => {
      const style = cell.style ? ` style="${cell.style.replace(/"/g, '&quot;')}"` : '';
      return `<th class="becker-opt-head"${style}>${cell.inner}</th>`;
    }).join('');
  }

  function renderOptionCells(cellsHtml, fallbackHtml) {
    let cells = extractRowCells(cellsHtml, 'td');
    if (!cells.length) cells = [{ tag: 'td', inner: sanitizeContent(fallbackHtml || ''), style: '' }];

    return cells.map(cell => {
      const style = cell.style ? ` style="${cell.style.replace(/"/g, '&quot;')}"` : '';
      return `<td class="becker-opt-cell"${style}>${cell.inner}</td>`;
    }).join('');
  }

  function addTdSpacing(html) {
    if (!html) return html;
    return String(html).replace(/<\/td>/gi, '&nbsp;&nbsp;</td>');
  }

  function hasImageInHtml(html) {
    return /<img\b/i.test(String(html || ''));
  }

  // ---------- UI ----------
  const panel = document.createElement('div');
  panel.style.cssText = `
    position:fixed; right:18px; bottom:18px; z-index:2147483647;
    background:#1f2937; color:#fff; padding:14px; width:390px;
    border-radius:10px; font-family:Inter, system-ui, sans-serif;
    box-shadow:0 8px 30px rgba(0,0,0,0.4);
  `;

  panel.innerHTML = `
    <div style="font-weight:700; font-size:15px; margin-bottom:8px;">Becker JSON → HTML v3.2</div>
    <div style="font-size:13px; margin-bottom:8px;">Upload file JSON per kategori. Nama HTML otomatis mengikuti nama JSON.</div>

    <input id="fileInput" type="file" accept=".json,.txt,application/json" multiple style="width:100%; margin-bottom:10px;">

    <div style="margin-bottom:6px;">HTML output:</div>
    <label style="display:block;"><input type="radio" name="htmlout" value="questions"> Questions HTML only</label>
    <label style="display:block;"><input type="radio" name="htmlout" value="answers"> Answers HTML only</label>
    <label style="display:block; margin-bottom:8px;"><input type="radio" name="htmlout" value="both" checked> Both HTML</label>

    <div style="margin-bottom:6px;">Page-break mode:</div>
    <label style="display:block;"><input type="radio" name="pb" value="normal"> HTML Normal</label>
    <label style="display:block;"><input type="radio" name="pb" value="smart" checked> HTML Smart</label>
    <label style="display:block; margin-bottom:8px;"><input type="radio" name="pb" value="each"> HTML Page-break per Question</label>

    <div style="margin-bottom:6px;">Paper size for print/page width:</div>
    <select id="paperSizeSel" style="width:100%; margin-bottom:8px; padding:6px; border-radius:6px; border:1px solid #374151;">
      <option value="letter" selected>Letter</option>
      <option value="a4">A4</option>
      <option value="browser">Browser default</option>
      <option value="full">Full HTML / full screen</option>
    </select>

    <label style="display:block; margin-bottom:8px;"><input id="autoDl" type="checkbox"> Auto Download</label>
    <label style="display:block; margin-bottom:8px;"><input id="openTabChk" type="checkbox" checked> Open HTML in new tabs</label>
    <label style="display:block; margin-bottom:8px;"><input id="shrinkTablesChk" type="checkbox" checked> Auto wrap wide tables (no font shrink)</label>
    <label style="display:block; margin-bottom:8px;"><input id="pdfChk" type="checkbox"> Auto Print PDF (Answer)</label>
    <label style="display:block; margin-bottom:10px; color:#fbbf24;"><input id="removeImgChk" type="checkbox"> Remove Question with Image</label>

    <button id="genBtn" style="
      width:100%; padding:10px; background:#10b981; color:#fff; border:none;
      border-radius:6px; font-weight:700; cursor:pointer;
    ">Generate HTML</button>

    <div id="statusArea" style="margin-top:10px; font-size:13px; color:#d1d5db;"></div>
  `;

  document.body.appendChild(panel);

  const fileInput = panel.querySelector('#fileInput');
  const genBtn = panel.querySelector('#genBtn');
  const statusArea = panel.querySelector('#statusArea');
  const autoDlChk = panel.querySelector('#autoDl');
  const openTabChk = panel.querySelector('#openTabChk');
  const shrinkTablesChk = panel.querySelector('#shrinkTablesChk');
  const paperSizeSel = panel.querySelector('#paperSizeSel');
  const removeImgChk = panel.querySelector('#removeImgChk');

  const setStatus = (t) => { statusArea.innerText = t; console.log('[becker-json-html]', t); };

  // ---------- CSS ----------
  function cssFor(mode, paperSize) {
    let extra = '';
    if (mode === 'smart') extra = `.q-block{page-break-inside:avoid; break-inside:avoid;}`;
    if (mode === 'each') extra = `.q-block{page-break-before:always; break-before:page;} .q-block:first-child{page-break-before:avoid; break-before:auto;}`;

    const normalizedPaper = String(paperSize || 'letter').toLowerCase();
    const pageRule = (normalizedPaper === 'browser' || normalizedPaper === 'full')
      ? '@page{ margin:0.5in; }'
      : `@page{ size:${normalizedPaper === 'a4' ? 'A4' : 'Letter'} portrait; margin:0.5in; }`;
    const pageContentWidth = normalizedPaper === 'a4'
      ? '7.267in'
      : normalizedPaper === 'browser'
        ? '100%'
        : normalizedPaper === 'full'
          ? 'none'
          : '7.5in';

    return `
      ${pageRule}
      :root{ --becker-page-content-width:${pageContentWidth}; }
      body{
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        padding:28px;
        color:#111;
        line-height:1.55;
      }
      .er-question .repQuestion{
        max-width:var(--becker-page-content-width);
        width:100%;
        box-sizing:border-box;
      }
      @media print{
        body{ padding:0; }
        .er-question .repQuestion{ max-width:100%; width:100%; }
      }
      .er-question .repQuestion .q-block{ margin-bottom:22px; }
      .er-question .repQuestion .q-header{ font-weight:700; font-size:18px; margin-bottom:8px; }
      .er-question .repQuestion .q-text{ margin-bottom:10px; }
      .er-question .repQuestion .foil-header{ margin:10px 0; }

      /* Choices dibuat lebih spesifik dari CSS Becker agar A/B/C/D tetap sejajar */
      .er-question .repQuestion ol.choices{ list-style:none; padding-left:0; margin:0; }
      .er-question .repQuestion ol.choices li{
        margin:0 !important;
        padding:8px 4px !important;
        line-height:1.35;
        display:grid;
        grid-template-columns:24px minmax(0, 1fr);
        column-gap:4px;
        align-items:start;
      }
      .er-question .repQuestion .letter{ font-weight:700; white-space:nowrap; line-height:1.35; }
      .er-question .repQuestion .choice-content{ min-width:0; line-height:1.35; }
      .er-question .repQuestion .choice-content > *:first-child{ margin-top:0 !important; }
      .er-question .repQuestion .choice-content > *:last-child{ margin-bottom:0 !important; }
      .er-question .repQuestion .choice-content p{ margin:0 !important; padding:0 !important; }
      .er-question .repQuestion .correct{ font-weight:700; background:#e6f9ea; border:1px solid #2e7d32; border-radius:4px; }

      /* v2.0: support optionsHeader Becker dengan jawaban berbentuk table tanpa class options-table agar tidak kena negative margin CSS Becker */
      .er-question .repQuestion table.becker-options-table{
        display:table !important;
        margin-top:10px;
        margin-left:0 !important;
        border-collapse:separate !important;
        border-spacing:0 8px !important;
        width:auto !important;
        max-width:100%;
      }
      .er-question .repQuestion table.becker-options-table thead{ display:table-header-group !important; }
      .er-question .repQuestion table.becker-options-table tbody{ display:table-row-group !important; }
      .er-question .repQuestion table.becker-options-table tr{ display:table-row !important; }
      .er-question .repQuestion table.becker-options-table th,
      .er-question .repQuestion table.becker-options-table td{
        display:table-cell !important;
        vertical-align:top;
      }
      .er-question .repQuestion table.becker-options-table .becker-opt-head,
      .er-question .repQuestion table.becker-options-table .becker-opt-cell{
        padding:5px !important;
        white-space:normal;
      }
      .er-question .repQuestion table.becker-options-table .becker-opt-cell p,
      .er-question .repQuestion table.becker-options-table .becker-opt-head p{
        margin:0 !important;
      }
      /* v1.9: khusus table pilihan yang memakai optionsHeader.
         Cell optionTexts dipertahankan sebagai cell table terpisah, bukan digabung jadi satu blok. */
      .er-question .repQuestion table.becker-options-table .becker-opt-cell{
