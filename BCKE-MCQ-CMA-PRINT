    ensureRuntimeStyle();
    clearRuntimeWrapClasses();
    document.body.classList.add(PREP_CLASS);

    var tables = Array.prototype.slice.call(document.querySelectorAll('.er-question .repQuestion table'));

    tables.forEach(function (table) {
      if (isExcludedTable(table)) return;
      if (!isOverflowing(table)) return;
      markCellsForWrap(table, false);
    });

    // Recheck synchronously after classes are applied. If still overflow, allow all non-numeric text cells to wrap.
    tables.forEach(function (table) {
      if (isExcludedTable(table)) return;
      if (!table.classList.contains('becker-runtime-wrap-overflow')) return;
      if (isOverflowing(table)) markCellsForWrap(table, true);
    });
  }

  function schedulePrepare() {
    window.requestAnimationFrame(function () {
      prepareOverflowTables();
    });
  }

  window.addEventListener('load', schedulePrepare);
  window.addEventListener('resize', schedulePrepare);
  window.addEventListener('beforeprint', prepareOverflowTables);
})();
</script>`;
  }


  function wrapFullHtml(title, css, body, enableAutoShrink) {
    return `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${escapeHtml(title)}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="${BECKER_CSS_URL}">
  <style>${css}</style>
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['\\\\(','\\\\)']],
        displayMath: [['$$','$$']],
        processEscapes: true
      },
      options: {
        ignoreHtmlClass: 'tex2jax_ignore',
        processHtmlClass: 'tex2jax_process'
      }
    };
  </script>
  <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" id="MathJax-script" async></script>
  ${autoShrinkOverflowTablesScript(enableAutoShrink)}
</head>
<body><div class="er-question er-question--no-symbol er-question--indent-mcqs"><div class="repQuestion">${body}</div></div></body>
</html>`;
  }

  async function processOneFile(file, mode, paperSize, outputMode, wantPdf, autoDownload, openTabs, removeImg, enableAutoShrink) {
    const txt = await file.text();
    const parsed = parseJsonContent(txt);
    const questions = normalizeQuestions(parsed);
    const baseName = getBaseName(file.name);

    if (!questions.length) {
      return { file: file.name, count: 0, imageReports: [], skipped: true };
    }

    questions.sort((a, b) => {
      const sa = Number(a.questionNumber || 0);
      const sb = Number(b.questionNumber || 0);
      return sa - sb;
    });

    const { qBody, aBody, imageReports, count } = buildBodies(questions, removeImg);
    if (!qBody || !aBody) {
      return { file: file.name, count: 0, imageReports, skipped: true };
    }

    const css = cssFor(mode, paperSize);
    const makeQuestions = outputMode === 'questions' || outputMode === 'both';
    const makeAnswers = outputMode === 'answers' || outputMode === 'both';

    let convQ = { html: '', failed: [] };
    let convA = { html: '', failed: [] };
    let htmlQ = '';
    let htmlA = '';

    if (makeQuestions) {
      convQ = await convertImagesToBase64(qBody);
      htmlQ = wrapFullHtml(`${baseName} - Questions`, css, convQ.html, enableAutoShrink);
    }
    if (makeAnswers) {
      convA = await convertImagesToBase64(aBody);
      htmlA = wrapFullHtml(`${baseName} - Answer`, css, convA.html, enableAutoShrink);
    }

    const qFileName = `${baseName} - Questions.html`;
    const aFileName = `${baseName} - Answer.html`;

    let winA = null;
    if (openTabs || wantPdf) {
      if (makeQuestions) window.open(URL.createObjectURL(new Blob([htmlQ], { type: 'text/html' })), '_blank');
      if (makeAnswers || wantPdf) {
        const answerHtmlForPrint = makeAnswers ? htmlA : wrapFullHtml(`${baseName} - Answer`, css, (await convertImagesToBase64(aBody)).html, enableAutoShrink);
        winA = window.open(URL.createObjectURL(new Blob([answerHtmlForPrint], { type: 'text/html' })), '_blank');
      }
    }

    if (autoDownload) {
      if (makeQuestions) downloadBlob(new Blob([htmlQ], { type: 'text/html' }), qFileName);
      if (makeAnswers) downloadBlob(new Blob([htmlA], { type: 'text/html' }), aFileName);
    }

    if (wantPdf && winA) setTimeout(() => winA.print(), 1000);

    return {
      file: file.name,
      count,
      imageReports,
      failedImages: [...convQ.failed, ...convA.failed],
      skipped: false
    };
  }

  async function handleFiles(fileList) {
    const files = Array.from(fileList || []);
    if (!files.length) return alert('Upload file JSON terlebih dahulu.');

    const mode = panel.querySelector("input[name='pb']:checked").value;
    const paperSize = paperSizeSel.value || 'letter';
    const outputMode = panel.querySelector("input[name='htmlout']:checked").value || 'both';
    const wantPdf = !!panel.querySelector('#pdfChk').checked;
    const autoDownload = !!autoDlChk.checked;
    const openTabs = !!openTabChk.checked;
    const enableAutoShrink = !!shrinkTablesChk.checked;
    const removeImg = !!removeImgChk.checked;

    setStatus(`Memproses ${files.length} file...`);

    const allImageReports = [];
    const allFailedImages = [];
    let totalQuestions = 0;
    let skippedFiles = 0;

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      setStatus(`Memproses ${i + 1}/${files.length}: ${file.name}`);
      try {
        const result = await processOneFile(file, mode, paperSize, outputMode, wantPdf, autoDownload, openTabs, removeImg, enableAutoShrink);
        totalQuestions += result.count || 0;
        if (result.skipped) skippedFiles++;
        if (result.imageReports && result.imageReports.length) {
          allImageReports.push(`File: ${file.name}`, ...result.imageReports);
        }
        if (result.failedImages && result.failedImages.length) {
          allFailedImages.push(`File: ${file.name}`, ...result.failedImages.map(x => `- ${x}`));
        }
      } catch (e) {
        console.error(e);
        skippedFiles++;
        alert(`Gagal memproses file: ${file.name}\n${e.message}`);
      }
    }

    if (allImageReports.length) {
      let msg = removeImg
        ? 'PERHATIAN: Soal berikut memiliki gambar dan TELAH DIHAPUS dari hasil generate:\n\n'
        : 'PERHATIAN: Terdapat gambar pada soal berikut:\n\n';
      msg += allImageReports.slice(0, 40).join('\n');
      if (allImageReports.length > 40) msg += `\n... dan ${allImageReports.length - 40} baris lainnya.`;
      setTimeout(() => alert(msg), 500);
    }

    if (allFailedImages.length) {
      console.warn('Images failed to convert:', allFailedImages.join('\n'));
    }

    setStatus(`Selesai. Total soal dibuat: ${totalQuestions}. File dilewati: ${skippedFiles}.`);
  }

  // ---------- Events ----------
  genBtn.addEventListener('click', () => handleFiles(fileInput.files));
  setStatus('Ready — Upload JSON per kategori lalu klik Generate.');
})();
