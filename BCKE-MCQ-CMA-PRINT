  // ---------- JSON parsing / normalization ----------
  function parseJsonContent(text) {
    try { return JSON.parse(text); }
    catch {
      const m = String(text).match(/(\[[\s\S]*\]|\{[\s\S]*\})/);
      if (!m) throw new Error('Cannot parse JSON');
      return JSON.parse(m[1]);
    }
  }

  function normalizeQuestions(obj) {
    if (!obj) return [];
    if (Array.isArray(obj)) return obj.map(normalizeOneQuestion).filter(Boolean);
    if (obj.questionList) return obj.questionList.map(normalizeOneQuestion).filter(Boolean);
    if (obj.test && obj.test.questionList) return obj.test.questionList.map(normalizeOneQuestion).filter(Boolean);
    if (obj.questions) return obj.questions.map(normalizeOneQuestion).filter(Boolean);
    return [normalizeOneQuestion(obj)].filter(Boolean);
  }

  function normalizeOneQuestion(raw, idx) {
    if (!raw) return null;

    // Format baru Becker: item.response.content
    const c = raw.response && raw.response.content ? raw.response.content : raw.content ? raw.content : raw;

    const rawOptions = c.optionTexts || c.options || c.answerChoiceList || c.answerChoice || c.foils || [];
    const explanations = Array.isArray(c.explanations) ? c.explanations : [];
    const correctIndex = Number(c.correctOptionIndex ?? c.correctAnswerIndex ?? c.correctIndex ?? 0);

    const choices = rawOptions.map((opt, optionIdx) => {
      const optionNumber = optionIdx + 1;
      const letter = letters(optionNumber);
      let html = '';
      let isCorrect = false;
      let explanation = '';

      let rawOptionHtml = '';
      if (typeof opt === 'string') {
        rawOptionHtml = replaceChoiceNumberTokens(opt);
        html = unwrapOptionTd(rawOptionHtml);
        isCorrect = correctIndex ? optionNumber === correctIndex : false;
        explanation = replaceChoiceNumberTokens(explanations[optionIdx] || '');
      } else {
        rawOptionHtml = replaceChoiceNumberTokens(opt.text || opt.choice || opt.html || opt.body || '');
        html = unwrapOptionTd(rawOptionHtml);
        isCorrect = correctIndex ? optionNumber === correctIndex : !!(opt.isCorrect || opt.correctTaken === true);
        explanation = replaceChoiceNumberTokens(opt.explanation || explanations[optionIdx] || '');
      }

      return { letter, html, rawOptionHtml, isCorrect, explanation };
    });

    return {
      id: c.id || raw.id || '',
      questionNumber: c.questionNumber || c.number || raw.questionNumber || raw.number || idx + 1,
      body: c.body || c.stem || c.questionText || '',
      optionsHeader: c.optionsHeader || c.foilHeader || c.answerHeader || '',
      choices,
      explanationText: replaceChoiceNumberTokens(c.explanationText || ''),
      raw
    };
  }

  function getBaseName(filename) {
    if (!filename) return 'Questions';
    const name = filename.split('/').pop().split('\\').pop();
    const dot = name.lastIndexOf('.');
    return dot === -1 ? name : name.slice(0, dot);
  }

  function downloadBlob(blob, filename) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
      URL.revokeObjectURL(a.href);
      a.remove();
    }, 1500);
  }

  // ---------- Image converter ----------
  async function convertImagesToBase64(htmlString) {
    const div = document.createElement('div');
    div.innerHTML = htmlString;
    const imgs = div.querySelectorAll('img');
    const failed = [];

    async function imgToBase64(url) {
      try {
        const res = await fetch(url, { mode: 'cors' });
        const blob = await res.blob();
        return await new Promise(resolve => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result);
          reader.readAsDataURL(blob);
        });
      } catch (e) {
        failed.push(url);
        return null;
      }
    }

    for (const img of imgs) {
      const url = img.getAttribute('src');
      if (!url) continue;
      if (/^(data:|blob:)/i.test(url)) continue;
      const base64 = await imgToBase64(url);
      if (base64) img.setAttribute('src', base64);
    }

    return { html: div.innerHTML, failed };
  }

  // ---------- HTML builders ----------
  function buildBodies(questions, removeImg) {
    let qBody = '';
    let aBody = '';
    const imageReports = [];

    const processed = [];
    questions.forEach((q, i) => {
      const qText = sanitizeContent(q.body || '');
      const foilHeader = sanitizeContent(q.optionsHeader || '');
      let searchHtml = qText + foilHeader + sanitizeContent(q.explanationText || '');

      q.choices.forEach(ch => {
        searchHtml += sanitizeContent(ch.html || '') + sanitizeContent(ch.explanation || '');
      });

      const hasImage = hasImageInHtml(searchHtml);
      if (hasImage) {
        imageReports.push(`- Soal asli No: ${q.questionNumber || i + 1}${q.id ? ` (ID ${q.id})` : ''}`);
      }

      if (!(removeImg && hasImage)) processed.push(q);
    });

    processed.forEach((q, i) => {
      const seq = i + 1;
      const total = processed.length;
      const qText = sanitizeContent(q.body || '');
      const foilHeader = sanitizeContent(q.optionsHeader || '');

      let correctExplanation = '';
      let falseExplanations = '';

      const normalized = q.choices.map((ch, idx) => {
        let html = sanitizeContent(ch.html || '');
        html = addTdSpacing(html);
        html = html.replace(/^\s*[A-Z]\.\s*/i, '');
        const letter = ch.letter || letters(idx + 1);
        const expText = sanitizeContent(ch.explanation || '');

        if (ch.isCorrect) {
          correctExplanation = expText;
        } else if (expText) {
          falseExplanations += `<div class="false-choice-item"><strong>Choice ${letter}:</strong> ${expText}</div>`;
        }

        return { letter, html, rawOptionHtml: ch.rawOptionHtml || '', isCorrect: !!ch.isCorrect };
      });

      if (!correctExplanation && q.explanationText) correctExplanation = sanitizeContent(q.explanationText);

      let combinedExplanationHTML = '';
      if (correctExplanation) {
        combinedExplanationHTML += `
          <div class="exp-correct-title"><strong>&#10004; Correct Answer Explanation</strong></div>
          <div>${correctExplanation}</div>
        `;
      }
      if (falseExplanations) {
        combinedExplanationHTML += `
          <div class="exp-false-title"><strong>&#10006; False Answer Explanations</strong></div>
          <div>${falseExplanations}</div>
        `;
      }
      if (!combinedExplanationHTML) combinedExplanationHTML = '(No explanation provided)';

      const hasOptionsHeader = !!foilHeader;
      const hasMultiCellOptions = normalized.some(c => countTableCells(c.rawOptionHtml || '') > 1);
      const useOptionsTable = hasOptionsHeader;

      function renderChoices(asAnswer) {
        if (useOptionsTable) {
          let out = `<table class="becker-options-table"><thead>`;
          if (foilHeader) {
            out += `<tr><th class="optionLetter"></th>${renderHeaderCells(q.optionsHeader || '')}</tr>`;
          }
          out += `</thead><tbody>`;
          normalized.forEach(c => {
            const rowClass = asAnswer && c.isCorrect ? ' class="correct"' : '';
            const cells = renderOptionCells(c.rawOptionHtml || '', c.html);
            out += `<tr${rowClass}><td class="optionLetter">${c.letter}.</td>${cells}</tr>`;
          });
          out += `</tbody></table>`;
          return out;
        }

        let out = '<ol class="choices">';
        normalized.forEach(c => {
          if (asAnswer) {
            out += `<li class="${c.isCorrect ? 'correct' : ''}"><span class="letter">${c.letter}.</span><span class="choice-content">${c.html}</span></li>`;
          } else {
            out += `<li><span class="letter">${c.letter}.</span><span class="choice-content">${c.html}</span></li>`;
          }
        });
        out += '</ol>';
        return out;
      }

      qBody += `<div class="q-block">
        <div class="q-header">Question ${seq} of ${total}</div>
        <div class="q-text">${qText}</div>
        ${renderChoices(false)}
      </div><hr/>`;

      aBody += `<div class="q-block">
        <div class="q-header">Question ${seq} of ${total}</div>
        <div class="q-text">${qText}</div>
        ${renderChoices(true)}
        <div class="explain-box">${combinedExplanationHTML}</div>
      </div><hr/>`;
    });

    return { qBody, aBody, imageReports, count: processed.length };
  }

