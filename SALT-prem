  const apiExam = makeInput('level-ii-2027', 'examName API');
  const apiCh1 = makeInput('2614', 'Chapter 1 API');
  const apiCh2 = makeInput('2615', 'Chapter 2 API');
  const apiRow = el('div', 'display:flex;gap:8px;');
