  tocBar.appendChild(btnNone);
  const tocList = el('div', 'max-height:230px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:6px;padding:6px 8px;background:#f8fafc;display:flex;flex-direction:column;gap:4px;');
  const btnRun = makeBtn('Proses yang Dicentang', '#2563eb', 'padding:9px 12px;font-size:13px;');
  tocBox.appendChild(tocBar);
  tocBox.appendChild(tocList);
  tocBox.appendChild(btnRun);
  panel.appendChild(tocBox);

  const status = el('div', 'font-size:11px;color:#64748b;text-align:center;', 'Siap');
  panel.appendChild(status);

  // Tombol copy semua link video (muncul kalau sudah ada video yang diproses)
  const btnCopyAll = makeBtn('Copy semua link video', '#7c3aed', 'display:none;width:100%;padding:8px 12px;');
  panel.appendChild(btnCopyAll);

  const resultsBox = el('div', 'display:flex;flex-direction:column;gap:6px;');
  panel.appendChild(resultsBox);

  const btnLast = makeBtn('Ambil pelajaran terakhir saja (manual, tanpa prefix)', '#64748b', 'font-size:11px;font-weight:normal;');
  panel.appendChild(btnLast);

  document.body.appendChild(panel);

  // ===== STATE =====
  let items = [];
  let sectionGroups = []; // { cb, items: [] } untuk centang sub heading
  let videoResults = [];  // { link, title }
  let runId = 0;          // naik setiap proses baru / reset (untuk membatalkan proses lama)
  let running = false;

  // ===== Video: kumpulan link =====
  function updateCopyAll() {
    if (videoResults.length) {
      btnCopyAll.style.display = 'block';
      btnCopyAll.textContent = 'Copy semua link video (' + videoResults.length + ')';
    } else {
      btnCopyAll.style.display = 'none';
    }
  }
  function videoLinkOf(id) {
    return (vimeoBase.value.trim() || '') + String(id);
  }
  function addVideoResult(link, title) {
    const i = videoResults.findIndex(v => v.title === title);
    if (i >= 0) videoResults[i] = { link, title };
    else videoResults.push({ link, title });
    updateCopyAll();
  }
  btnCopyAll.onclick = () => {
    if (!videoResults.length) return;
    const text = videoResults.map(v => v.link + ' | ' + v.title).join('\n');
    copyText(text, btnCopyAll, '#7c3aed');
  };

  // ===== Reset =====
  btnReset.onclick = () => {
    if (running && !confirm('Proses sedang berjalan. Hentikan dan reset semuanya?')) return;
    runId++;             // proses lama otomatis berhenti
    running = false;
    items = [];
    sectionGroups = [];
    videoResults = [];
    tocList.innerHTML = '';
    tocBox.style.display = 'none';
    resultsBox.innerHTML = '';
    jsonArea.value = '';
    updateCopyAll();
    btnRun.disabled = false;
    btnRun.style.opacity = '1';
    btnList.disabled = false;
    status.textContent = 'Sudah direset. Tempel JSON daftar isi untuk mulai lagi.';
  };

  function refreshSection(g) {
    const enabled = g.items.filter(i => !i.cb.disabled);
    if (!enabled.length) {
      g.cb.checked = false;
      g.cb.indeterminate = false;
      g.cb.disabled = true;
      return;
    }
    const n = enabled.filter(i => i.cb.checked).length;
    g.cb.checked = n === enabled.length;
    g.cb.indeterminate = n > 0 && n < enabled.length;
  }
  function refreshAllSections() { sectionGroups.forEach(refreshSection); }

  function readApiConfig() {
    const cfg = {
      exam: apiExam.value.trim(),
      ch1: apiCh1.value.trim(),
      ch2: apiCh2.value.trim(),
      img: imgSelect.value,
      footer: footerInput.value.trim()
    };
    if (!cfg.exam || !cfg.ch1 || !cfg.ch2) {
      throw new Error('Pengaturan API (Exam Name, Chapter 1, Chapter 2) harus diisi.');
    }
    return cfg;
  }

  function readUrlConfig() {
    const u = { exam: urlExam.value.trim(), ch1: urlCh1.value.trim(), ch2: urlCh2.value.trim() };
    if (!u.exam || !u.ch1 || !u.ch2) {
      throw new Error('Alamat halaman: Exam, Chapter 1, dan Chapter 2 di URL harus diisi.');
    }
    return u;
  }

  // ===== Buat daftar isi dari JSON (+ hitung prefix) =====
  btnList.addEventListener('click', () => {
    try {
      const raw = jsonArea.value.trim();
      if (!raw) throw new Error('Tempel JSON daftar isi dulu.');
      const json = JSON.parse(raw);
      const d = json.data || json;
      const sections = d.sections || {};
      const artifacts = d.artifacts || {};
      const secId = String(d.data?.section ?? Object.keys(sections)[0] ?? '');
      const sec = sections[secId];
      if (!sec || !Array.isArray(sec.artifacts)) {
        throw new Error('Urutan daftar isi tidak ditemukan di JSON.');
      }

      // Hanya bagian URL yang diisi otomatis. Pengaturan API TIDAK diubah.
      urlCh2.value = secId;
      const bc = sec.breadcrumbs || [];
      if (bc[0]?.id) urlExam.value = bc[0].id;
      if (bc.length >= 2 && bc[bc.length - 2]?.id && !urlCh1.value) urlCh1.value = bc[bc.length - 2].id;

      const shortName = String(sec.shortName || '').trim(); // contoh "2.1"

      const counts = {};
      {
        let s = -1;
        sec.artifacts.forEach(id => {
          const t = artifacts[id]?.artifactType?.name || '';
          if (t === 'sectiontitle') { s++; counts[s] = 0; }
          else { const k = Math.max(s, 0); counts[k] = (counts[k] || 0) + 1; }
        });
      }

      items = [];
      sectionGroups = [];
      tocList.innerHTML = '';

      let secIdx = -1;
      let itemIdx = 0;
      let currentGroup = null;

      sec.artifacts.forEach(id => {
        const a = artifacts[id] || {};
        const type = a.artifactType?.name || '';
        const name = a.name || String(id);

        if (type === 'sectiontitle') {
          secIdx++;
          itemIdx = 0;

          const headRow = el('label', 'display:flex;align-items:center;gap:6px;font-weight:800;color:#1e293b;margin-top:6px;border-bottom:1px solid #e2e8f0;padding-bottom:2px;cursor:pointer;');
          const hcb = document.createElement('input');
          hcb.type = 'checkbox';
          headRow.appendChild(hcb);
          headRow.appendChild(el('span', '', name));
          tocList.appendChild(headRow);

          const group = { cb: hcb, items: [] };
          sectionGroups.push(group);
          currentGroup = group;
          hcb.addEventListener('change', () => {
            group.items.forEach(i => { if (!i.cb.disabled) i.cb.checked = hcb.checked; });
            hcb.indeterminate = false;
          });
          return;
        }

        itemIdx++;
        const sIdx = Math.max(secIdx, 0);
        let prefix = null;
        if (shortName) {
          if (sIdx === 0 && counts[0] === 1) prefix = shortName + '.0';
          else prefix = shortName + '.' + sIdx + '.' + itemIdx;
        }

        const canProcess = (type === 'manual' || type === 'video');
        const row = el('label', 'display:flex;align-items:flex-start;gap:6px;cursor:' + (canProcess ? 'pointer' : 'default') + ';opacity:' + (canProcess ? '1' : '0.5') + ';');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.disabled = !canProcess;
        cb.style.marginTop = '2px';
        row.appendChild(cb);

        const badgeText = type === 'manual' ? 'Baca' : type === 'video' ? 'Video' : (type === 'assignment' ? 'Latihan' : type);
        const badgeColor = type === 'manual' ? '#0f766e' : type === 'video' ? '#2563eb' : '#94a3b8';
        row.appendChild(el('span', 'background:' + badgeColor + ';color:#fff;border-radius:3px;padding:0 5px;font-size:10px;font-weight:bold;white-space:nowrap;margin-top:1px;', badgeText));
        row.appendChild(el('span', 'flex:1;color:#0f172a;', (prefix ? prefix + ' ' : '') + name));
        tocList.appendChild(row);

        const item = { id: String(id), name, type, cb, prefix };
        items.push(item);
        if (currentGroup) {
          currentGroup.items.push(item);
          const g = currentGroup;
          cb.addEventListener('change', () => refreshSection(g));
        }
      });

      refreshAllSections();
      tocBox.style.display = 'flex';
      status.textContent = 'Daftar isi siap. Cek prefix di daftar, isi "Chapter 1 URL" (mis. 2625) jika masih kosong, lalu centang item atau sub heading.';
    } catch (err) {
      console.error(err);
      status.textContent = 'Error: ' + err.message;
    }
  });

  btnAll.onclick = () => { items.forEach(i => { if (!i.cb.disabled) i.cb.checked = true; }); refreshAllSections(); };
  btnNone.onclick = () => { items.forEach(i => { i.cb.checked = false; }); refreshAllSections(); };

  // ===== Fetch asli =====
  async function fetchLastLesson(cfg) {
    const res = await fetch(API_URL, {
      headers: {
        "accept": "*/*",
        "accept-language": "en-US,en;q=0.9",
        "content-type": "application/json",
        "priority": "u=1, i",
        "sec-fetch-dest": "empty",
        "sec-fetch-mode": "cors",
        "sec-fetch-site": "same-site"
      },
      referrer: "https://account.saltsolutions.com/",
      body: JSON.stringify({
        breadcrumbs: ["learn", cfg.ch1, cfg.ch2],
        depth: 1,
        examName: cfg.exam,
        liveOnly: true
      }),
      method: "POST",
      mode: "cors",
      credentials: "include"
    });
    if (!res.ok) throw new Error('HTTP Error: ' + res.status);
    const json = await res.json();
    return json?.data?.lastLesson || json?.data?.lastlesson || null;
  }

  // ===== Cara-cara pindah ke pelajaran =====
  const METHOD_NAMES = {
    click: 'klik tautan di menu',
    push: 'pindah alamat di dalam halaman',
    iframe: 'salinan tersembunyi',
    popup: 'tab sementara'
  };

  function lessonPath(urlCfg, id) {
    return '/' + urlCfg.exam + '/learn/' + urlCfg.ch1 + '/' + urlCfg.ch2 + '/' + id;
  }

  async function navigate(method, urlCfg, id, waitSec) {
    const path = lessonPath(urlCfg, id);

    if (method === 'click') {
      const a = Array.from(document.querySelectorAll('a[href]')).find(x => {
        const h = (x.getAttribute('href') || '').split('?')[0].split('#')[0].replace(/\/$/, '');
        return h.endsWith('/' + id);
      });
      if (!a) return false;
      a.click();
      return true;
    }

    if (method === 'push') {
      if (location.origin !== 'https://account.saltsolutions.com') {
        throw new Error('Halaman yang sedang terbuka bukan account.saltsolutions.com');
      }
      history.pushState(history.state, '', path);
      window.dispatchEvent(new PopStateEvent('popstate', { state: history.state }));
      return true;
    }

    if (method === 'iframe') {
      const url = 'https://account.saltsolutions.com' + path;
      await new Promise(resolve => {
        const f = document.createElement('iframe');
        f.style.cssText = 'position:fixed;width:1024px;height:768px;opacity:0;pointer-events:none;border:0;left:-2000px;top:0;';
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          setTimeout(() => { f.remove(); resolve(); }, 3000);
        };
        f.onload = finish;
        setTimeout(finish, 15000);
        f.src = url;
        document.body.appendChild(f);
      });
      return true;
    }

    if (method === 'popup') {
      const url = 'https://account.saltsolutions.com' + path;
      const w = window.open(url, '_blank', 'width=900,height=700');
      if (!w) throw new Error('Pop-up diblokir browser.');
      await sleep(Math.max(6, waitSec) * 1000);
      try { w.close(); } catch (e) {}
      return true;
    }

    return false;
  }

  async function waitForLesson(id, apiCfg, seconds, note, label, cancelled) {
    const end = Date.now() + seconds * 1000;
    let seen = null;
    do {
      if (cancelled && cancelled()) return { lesson: null, seen };
      try {
        const l = await fetchLastLesson(apiCfg);
        if (l) {
          seen = String(l.id);
          if (seen === String(id)) return { lesson: l, seen };
        }
      } catch (e) {
        console.warn(e);
      }
      note(label + ' — server masih menyebut pelajaran ' + (seen || '?') + ', menunggu...');
      await sleep(1500);
    } while (Date.now() < end);
    return { lesson: null, seen };
  }

  async function getLessonForItem(it, apiCfg, urlCfg, note, cancelled) {
    const waitSec = Math.max(3, Number(waitInput.value) || 10);

    note('Mengecek pelajaran terakhir di server...');
    let r = await waitForLesson(it.id, apiCfg, 0, note, 'Cek awal', cancelled);
    if (r.lesson) return r.lesson;
    if (cancelled()) throw new Error('Dibatalkan');

    const mode = modeSelect.value;
    const methods = mode === 'auto' ? ['click', 'push', 'iframe'] : [mode];
    const tried = [];

    for (const m of methods) {
      if (cancelled()) throw new Error('Dibatalkan');
      note('Mencoba: ' + METHOD_NAMES[m] + '...');
      try {
        const ok = await navigate(m, urlCfg, it.id, waitSec);
        if (!ok) {
          tried.push(METHOD_NAMES[m] + ' (tidak tersedia)');
          continue;
        }
      } catch (e) {
        console.warn(e);
        tried.push(METHOD_NAMES[m] + ' (' + e.message + ')');
        continue;
      }
      r = await waitForLesson(it.id, apiCfg, waitSec, note, METHOD_NAMES[m], cancelled);
      if (r.lesson) {
        console.log('Berhasil dengan cara:', METHOD_NAMES[m], 'untuk', it.id);
        return r.lesson;
      }
      if (cancelled()) throw new Error('Dibatalkan');
      tried.push(METHOD_NAMES[m] + ' (server menyebut ' + (r.seen || '?') + ')');
    }

    throw new Error('Server tidak pernah menyebut pelajaran ' + it.id + ' sebagai terakhir. Percobaan: ' + tried.join('; '));
  }

  // ===== Halaman hasil bacaan =====
  // fileTitle = isi <title> (nama file saat disimpan)
  // title     = judul besar di dalam halaman (tanpa prefix)
  function buildReadingHtml(fileTitle, title, contentCache, footerText, imgChoice) {
    const imageCss = imgChoice === 'both'
      ? ''
      : `img[data-theme]:not([data-theme="${imgChoice}"]) { display: none !important; }`;

    // Apakah materi ini berisi rumus MathJax?
    const hasMath = /\\\(|\\\[|\$\$/.test(String(contentCache));

    return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>${esc(fileTitle)}</title>
  <script>
    window.__hasMath = ${hasMath ? 'true' : 'false'};
    window.MathJax = {
      tex: {
        inlineMath: [['\\\\(', '\\\\)']],
        displayMath: [['\\\\[', '\\\\]'], ['$$', '$$']],
        processEscapes: true
      },
      svg: {
        fontCache: 'global'
      },
      startup: {
        pageReady: function () {
          return MathJax.startup.defaultPageReady().then(function () {
            window.__mjDone = true;
          });
        }
      }
    };
  </script>
  <script>
    // Muat MathJax; kalau sumber utama gagal, coba sumber cadangan
    (function () {
      var urls = [
        'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js',
        'https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.js'
      ];
      var i = 0;
      function load() {
        if (i >= urls.length) { window.__mjFailed = true; return; }
        var s = document.createElement('script');
        s.src = urls[i++];
        s.async = true;
        s.onerror = function () { s.remove(); load(); };
        document.head.appendChild(s);
      }
      load();
    })();
  </script>
  <style>
    body {
      background: #ffffff;
      color: #1e293b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      padding: 40px 48px;
      line-height: 1.7;
      font-size: 16.5px;
      max-width: 860px;
      margin: 0 auto;
    }
    h1 {
      font-size: 28px;
