<body>
  ${hasMath ? '<div id="mj-status">Rumus sedang dimuat… tunggu sebentar sebelum menyimpan/mencetak.</div>' : ''}
  <h1>${esc(title)}</h1>
  <div id="content">${contentCache}</div>
  ${footerText ? `<div class="print-footer">${esc(footerText)}</div>` : ''}
  <script>
    // Penjaga: pastikan rumus benar-benar tampil
    (function () {
      if (!window.__hasMath) return;
      var bar = document.getElementById('mj-status');
      if (!bar) return;
      var tries = 0;
      var finished = false;
      function ok() { return window.__mjDone || !!document.querySelector('mjx-container'); }
      function finish() {
        if (finished) return;
        finished = true;
        bar.textContent = 'Rumus siap ✓';
        bar.className = 'ok';
        setTimeout(function () { bar.style.display = 'none'; }, 2500);
      }
      function check() {
        if (finished) return;
        if (ok()) { finish(); return; }
        if (window.MathJax && window.MathJax.typesetPromise) {
          window.MathJax.typesetPromise().then(function () { if (ok()) finish(); }).catch(function () {});
        }
        tries++;
        if (tries > 40 || window.__mjFailed) {
          bar.textContent = 'Rumus belum tampil. Periksa internet lalu tekan F5 sebelum menyimpan/mencetak.';
          bar.className = 'err';
        }
      }
      setInterval(check, 1500);
      document.addEventListener('visibilitychange', check);
      window.addEventListener('load', check);
    })();
  </script>
</body>
</html>`;
  }

  function addResultRow(name) {
    const box = el('div', 'border:1px solid #e2e8f0;border-radius:6px;padding:8px 10px;background:#f8fafc;display:flex;flex-direction:column;gap:5px;');
    box.appendChild(el('div', 'font-size:12px;font-weight:700;color:#0f172a;word-break:break-word;', name));
    const noteEl = el('div', 'font-size:11px;color:#64748b;word-break:break-word;', 'Menunggu...');
    const body = el('div', 'display:flex;flex-direction:column;gap:5px;');
    box.appendChild(noteEl);
    box.appendChild(body);
    resultsBox.appendChild(box);
    return {
      note(text, color) { noteEl.textContent = text; noteEl.style.color = color || '#64748b'; },
      body,
      scroll() { box.scrollIntoView({ block: 'nearest' }); }
    };
  }

  // prefix = null untuk mode manual (tanpa JSON)
  function renderLesson(row, lesson, fallbackName, cfg, prefix) {
    const detail = lesson?.detail || {};
    const title = detail.name || lesson?.name || fallbackName || 'Untitled Lesson';
    const contentCache = detail.contentCache;
    const providerId = detail.providerId;
    const fileTitle = fileTitleOf(prefix, title);

    // KONDISI 1: video
    if (providerId) {
      row.note('Video terdeteksi ✓', '#16a34a');
      row.body.appendChild(el('div', 'font-size:12px;font-weight:600;color:#0f172a;word-break:break-word;', fileTitle));
      row.body.appendChild(el('div', 'font-size:13px;font-family:monospace;color:#2563eb;background:#e0e7ff;padding:4px 6px;border-radius:4px;font-weight:bold;word-break:break-all;', providerId));
      const btns = el('div', 'display:flex;gap:6px;');
      const bText = makeBtn('Copy Text', '#2563eb', 'flex:1;');
      bText.onclick = () => copyText(fileTitle, bText, '#2563eb');
      const bId = makeBtn('Copy ID', '#2563eb', 'flex:1;');
      bId.onclick = () => copyText(String(providerId), bId, '#2563eb');
      btns.appendChild(bText);
      btns.appendChild(bId);
      row.body.appendChild(btns);
      addVideoResult(videoLinkOf(providerId), fileTitle);
      return;
    }

    // KONDISI 2: bacaan
    if (contentCache) {
      const html = buildReadingHtml(fileTitle, title, contentCache, cfg.footer, cfg.img);
      const blobUrl = URL.createObjectURL(new Blob([html], { type: 'text/html;charset=utf-8' }));
      const w = window.open(blobUrl, '_blank');
      row.note(w ? 'Tab baru terbuka ✓' : 'Browser menahan tab baru. Klik "Buka hasil" atau izinkan pop-up.', w ? '#16a34a' : '#b45309');
      const b = makeBtn('Buka hasil', '#0f766e');
      b.onclick = () => window.open(blobUrl, '_blank');
      row.body.appendChild(b);
      return;
    }

    throw new Error('Materi tidak memiliki contentCache maupun providerId.');
  }

  // ===== Proses yang dicentang =====
  btnRun.addEventListener('click', async () => {
    let apiCfg, urlCfg;
    try {
      apiCfg = readApiConfig();
      urlCfg = readUrlConfig();
    } catch (e) {
      status.textContent = 'Error: ' + e.message;
      return;
    }
    const chosen = items.filter(i => i.cb.checked);
    if (!chosen.length) {
      status.textContent = 'Belum ada yang dicentang.';
      return;
    }

    const myRun = ++runId;
    const cancelled = () => myRun !== runId;
    running = true;

    resultsBox.innerHTML = '';
    videoResults = [];
    updateCopyAll();
    btnRun.disabled = true;
    btnRun.style.opacity = '0.6';
    btnList.disabled = true;

    for (let n = 0; n < chosen.length; n++) {
      if (cancelled()) return; // sudah di-reset, reset yang mengurus tampilan
      const it = chosen[n];
      status.textContent = 'Memproses ' + (n + 1) + ' dari ' + chosen.length + ': ' + it.name;
      const row = addResultRow((it.prefix ? it.prefix + ' ' : '') + it.name);
      row.scroll();
      try {
        const lesson = await getLessonForItem(it, apiCfg, urlCfg, t => row.note(t), cancelled);
        if (cancelled()) return;
        renderLesson(row, lesson, it.name, apiCfg, it.prefix);
      } catch (err) {
        if (cancelled()) return;
        console.error(err);
        row.note('Gagal: ' + err.message, '#dc2626');
      }
      await sleep(700);
    }

    if (cancelled()) return;
    running = false;
    status.textContent = 'Selesai. ' + chosen.length + ' item diproses.';
    btnRun.disabled = false;
    btnRun.style.opacity = '1';
    btnList.disabled = false;
  });

  // ===== Mode manual: pelajaran terakhir saja, TANPA prefix =====
  btnLast.addEventListener('click', async () => {
    try {
      const cfg = readApiConfig();
      resultsBox.innerHTML = '';
      videoResults = [];
      updateCopyAll();
      status.textContent = 'Fetching data...';
      const lesson = await fetchLastLesson(cfg);
      if (!lesson) throw new Error('Pelajaran terakhir tidak ditemukan.');
      const row = addResultRow(lesson.detail?.name || lesson.name || 'Pelajaran terakhir');
      renderLesson(row, lesson, lesson.name, cfg, null);
      status.textContent = 'Selesai.';
    } catch (err) {
      console.error(err);
      status.textContent = 'Error: ' + err.message;
    }
  });

  console.log('Salt Exporter (daftar isi + prefix + sub heading + penjaga rumus + reset + copy semua video) dimuat.');
})();
