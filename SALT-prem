  const waitInput = makeInput('10', 'Batas tunggu per cara (detik)');

  panel.appendChild(el('label', LABEL_CSS, 'Versi Gambar:'));
  panel.appendChild(imgSelect);
  panel.appendChild(el('label', LABEL_CSS, 'Footer Cetak:'));
  panel.appendChild(footerInput);
  panel.appendChild(el('label', LABEL_CSS, 'Awalan link video (untuk "Copy semua link video"):'));
  panel.appendChild(vimeoBase);
  panel.appendChild(el('label', LABEL_CSS, 'Cara pindah ke pelajaran:'));
  panel.appendChild(modeSelect);
  panel.appendChild(el('label', LABEL_CSS, 'Batas tunggu per cara (detik):'));
  panel.appendChild(waitInput);

  // --- 4. Daftar isi ---
  panel.appendChild(el('div', GROUP_CSS, '4. Daftar isi'));
  const jsonArea = el('textarea', FIELD_CSS + 'height:70px;font-family:monospace;font-size:11px;resize:vertical;');
  jsonArea.placeholder = 'Paste JSON daftar isi...';
  panel.appendChild(jsonArea);
  const btnList = makeBtn('Buat Daftar Isi', '#1e293b');
  panel.appendChild(btnList);

  const tocBox = el('div', 'display:none;flex-direction:column;gap:6px;');
  const tocBar = el('div', 'display:flex;gap:6px;');
  const btnAll = makeBtn('Centang semua', '#475569', 'flex:1;');
