  [
    ['auto', 'Otomatis (klik menu → pindah alamat → cadangan)'],
    ['click', 'Hanya klik tautan di menu halaman'],
    ['push', 'Hanya pindah alamat di dalam halaman'],
    ['iframe', 'Hanya salinan tersembunyi (cara lama)'],
    ['popup', 'Hanya tab sementara (cara lama)']
  ].forEach(([v, t]) => {
