(function () {
  const old = document.getElementById('salt-exporter-panel');
  if (old) old.remove();

  const API_URL = "https://be.saltsolutions.com/json/study/get/section-or-content";
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // Nama aman untuk file: ":" -> " - ", "/" -> "_", karakter terlarang lain -> "_"
  function safeName(s) {
    return String(s ?? '')
      .replace(/\s*:\s*/g, ' - ')
      .replace(/\//g, '_')
      .replace(/[\\*?"<>|]/g, '_')
      .replace(/\s+/g, ' ')
      .trim();
  }
  function fileTitleOf(prefix, title) {
    return (prefix ? prefix + ' ' : '') + safeName(title);
  }

  function el(tag, css, text) {
    const e = document.createElement(tag);
    if (css) e.style.cssText = css;
    if (text != null) e.textContent = text;
    return e;
  }

  const FIELD_CSS = 'padding:6px 8px;font-size:12px;border:1px solid #cbd5e1;border-radius:4px;outline:none;color:#0f172a;background:#fff;box-sizing:border-box;width:100%;';
  const LABEL_CSS = 'font-size:12px;font-weight:bold;color:#334155;';
  const GROUP_CSS = 'font-size:11px;font-weight:800;color:#fff;background:#475569;border-radius:4px;padding:3px 8px;margin-top:4px;';

  function makeInput(value, placeholder) {
    const i = el('input', FIELD_CSS);
    i.type = 'text';
    i.value = value || '';
    i.placeholder = placeholder || '';
    return i;
  }

  function makeBtn(label, bg, extra) {
    return el('button', 'background:' + bg + ';color:#fff;border:none;padding:7px 12px;font-size:12px;font-weight:bold;border-radius:4px;cursor:pointer;' + (extra || ''), label);
  }

  async function copyText(text, btn, baseColor) {
    const orig = btn.textContent;
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Tersalin ✓';
      btn.style.background = '#16a34a';
      setTimeout(() => { btn.textContent = orig; btn.style.background = baseColor; }, 1800);
    } catch (e) {
      prompt('Salin manual di bawah ini:', text);
    }
  }

  // ===== PANEL =====
