  const urlExam = makeInput('', 'contoh: level-ii-2027');
  const urlCh1 = makeInput('', 'Chapter 1 URL (isi manual, contoh 2625)');
  const urlCh2 = makeInput('', 'Chapter 2 URL (otomatis dari JSON)');
  const urlRow = el('div', 'display:flex;gap:8px;');
  urlRow.appendChild(urlCh1);
  urlRow.appendChild(urlCh2);
  panel.appendChild(el('label', LABEL_CSS, 'Exam di URL (otomatis dari JSON):'));
  panel.appendChild(urlExam);
