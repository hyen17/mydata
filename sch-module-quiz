        if (document.getElementById('quiz-tools-panel')) return;
        const panel = document.createElement('div');
        panel.id = 'quiz-tools-panel';
        Object.assign(panel.style, {
            position: 'fixed', bottom: '20px', right: '20px', zIndex: '99999',
            display: 'flex', flexDirection: 'column', gap: '10px'
        });

        const btnAnswer = document.createElement('button');
        btnAnswer.id = 'quiz-answer-btn';
        btnAnswer.innerHTML = '🎲 Jawab Acak';
        btnAnswer.onclick = toggleAutoAnswer;
        Object.assign(btnAnswer.style, {
            padding: '10px 15px', fontSize: '14px', fontWeight: 'bold',
            color: 'white', backgroundColor: '#28a745', border: 'none',
            borderRadius: '5px', cursor: 'pointer', boxShadow: '0 2px 5px rgba(0,0,0,0.2)'
        });

        const btnExtract = document.createElement('button');
        btnExtract.id = 'quiz-extractor-btn';
        btnExtract.innerHTML = '🖨️ Ekstrak Quiz';
        btnExtract.onclick = jalankanProsesEkstraksi;
        Object.assign(btnExtract.style, {
            padding: '10px 15px', fontSize: '14px', fontWeight: 'bold',
            color: 'white', backgroundColor: '#007bff', border: 'none',
            borderRadius: '5px', cursor: 'pointer', boxShadow: '0 2px 5px rgba(0,0,0,0.2)'
        });

        const btnGradeZero = document.createElement('button');
        btnGradeZero.id = 'quiz-grade-zero-btn';
        btnGradeZero.innerHTML = '0️⃣ Grading 0';
        btnGradeZero.onclick = jalankanGradingNol;
        Object.assign(btnGradeZero.style, {
            padding: '10px 15px', fontSize: '14px', fontWeight: 'bold',
            color: 'white', backgroundColor: '#6f42c1', border: 'none',
            borderRadius: '5px', cursor: 'pointer', boxShadow: '0 2px 5px rgba(0,0,0,0.2)'
        });

        panel.appendChild(btnAnswer);
        panel.appendChild(btnExtract);
        panel.appendChild(btnGradeZero);
        document.body.appendChild(panel);
    }
    buatPanelTombol();
})();
