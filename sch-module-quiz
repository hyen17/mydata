(() => {
    // =================================================================================
    // CONFIG & SHARED HELPERS
    // =================================================================================
    const CONFIG = { MIN_WAIT_MS: 500, LOAD_TIMEOUT_MS: 10000 };
    const sleep = (ms) => new Promise(res => setTimeout(res, ms));
    const $ = (sel, root = document) => root.querySelector(sel);
    const $all = (sel, root = document) => Array.from(root.querySelectorAll(sel));

    window.isAutoAnswerRunning = false;

    async function waitFor(predicate, timeoutMs = CONFIG.LOAD_TIMEOUT_MS, interval = 120) {
        const start = performance.now();
        while (performance.now() - start < timeoutMs) {
            try { const v = await predicate(); if (v) return v; } catch (e) {}
            await sleep(interval);
        }
        return null;
    }

    // =================================================================================
    // BAGIAN 1: AUTO ANSWER (TIDAK BERUBAH)
    // =================================================================================
    async function toggleAutoAnswer() {
        const btn = document.getElementById('quiz-answer-btn');
        
        if (window.isAutoAnswerRunning) {
            window.isAutoAnswerRunning = false;
            if (btn) {
                btn.textContent = '🎲 Jawab Acak';
                btn.style.backgroundColor = '#28a745';
            }
            console.log("🛑 Auto Answer Dihentikan Manual.");
            return;
        }

        window.isAutoAnswerRunning = true;
        if (btn) {
            btn.textContent = '🛑 STOP (Klik untuk Manual)';
            btn.style.backgroundColor = '#dc3545';
        }

        try {
            console.log("🚀 Mulai menjawab otomatis...");
            while (window.isAutoAnswerRunning) {
                const questionBlocks = $all('[data-id="question-content"]');
                let answersClicked = 0;

                for (const block of questionBlocks) {
                    if (!window.isAutoAnswerRunning) break;

                    // -------------------------------------------------------------
                    // 1) MULTIPLE CHOICE
                    // -------------------------------------------------------------
                    const radios = Array.from(block.querySelectorAll('input[type="radio"]'));
                    if (radios.length > 0) {
                        if (!radios.some(r => r.checked)) {
                            const randomIdx = Math.floor(Math.random() * radios.length);
                            radios[randomIdx].click();
                            answersClicked++;
                            await sleep(200);
                        }
                        continue;
                    }

                    // -------------------------------------------------------------
                    // 2) ESSAY / CONSTRUCTED RESPONSE (QUILL)
                    // -------------------------------------------------------------
                    const essayEditor =
                        block.querySelector('.quill .ql-editor[contenteditable="true"]') ||
                        block.querySelector('.ql-editor[contenteditable="true"]') ||
                        block.querySelector('[contenteditable="true"][class*="ql-editor"]');

                    if (essayEditor) {
                        const currentText = (essayEditor.innerText || essayEditor.textContent || '').trim();

                        if (!currentText) {
                            // Quill listens to DOM/input events. Put the requested answer
                            // into the editable area and emit the events React/Quill expects.
                            essayEditor.focus();
                            essayEditor.innerHTML = '<p>answer</p>';

                            essayEditor.dispatchEvent(new InputEvent('input', {
                                bubbles: true,
                                inputType: 'insertText',
                                data: 'answer'
                            }));
                            essayEditor.dispatchEvent(new Event('change', { bubbles: true }));
                            essayEditor.dispatchEvent(new Event('blur', { bubbles: true }));

                            answersClicked++;
                            await sleep(300);

                            // Some React/Quill builds update state only after a real edit.
                            // If the button is still Skip, use execCommand as a fallback.
                            let navBtn = $('[data-test-id="runnner-footer-nextskip-button"]');
                            let navText = (navBtn?.innerText || navBtn?.textContent || '').trim().toLowerCase();

                            if (navText === 'skip') {
                                essayEditor.focus();
                                try {
                                    document.execCommand('selectAll', false, null);
                                    document.execCommand('insertText', false, 'answer');
                                } catch (_) {}

                                essayEditor.dispatchEvent(new InputEvent('input', {
                                    bubbles: true,
                                    inputType: 'insertText',
                                    data: 'answer'
                                }));
                                essayEditor.dispatchEvent(new Event('change', { bubbles: true }));
                                await sleep(300);
                            }

                            // Wait until Kaplan recognizes the essay as answered.
                            await waitFor(() => {
                                const btnNext = $('[data-test-id="runnner-footer-nextskip-button"]');
                                if (!btnNext) return false;
                                const txt = (btnNext.innerText || btnNext.textContent || '').trim().toLowerCase();
                                return txt === 'next' || btnNext.className.includes('nextbtn');
                            }, 3000, 100);
                        }
                    }
                }

                if (!window.isAutoAnswerRunning) break;
                if (answersClicked > 0) await sleep(500);

                let nextBtn = $('[data-test-id="runnner-footer-nextskip-button"]') || 
                              $('[data-test-id="attempt-review-footer-nextattempt"]') ||
                              $('.RunFooter-module__rightButton--gMXAV'); 

                if (!nextBtn) {
                     nextBtn = Array.from(document.querySelectorAll('button')).find(b => {
                        const txt = (b.innerText || '').trim().toLowerCase();
                        return (txt === 'next' || txt === 'skip' || b.querySelector('img[src*="right-arrow"]'));
                     });
                }

                let submitBtn = $('[data-test-id="runnner-footer-submit-button"]');
                if (!submitBtn) {
                     submitBtn = Array.from(document.querySelectorAll('button')).find(b => (b.innerText || '').trim().toLowerCase() === 'submit');
                }

                if (nextBtn && !nextBtn.disabled) {
                    const navLabel = (nextBtn.innerText || nextBtn.textContent || '').trim().toLowerCase();

                    // For essay questions Kaplan initially shows "Skip".
                    // Do not advance until the entered answer has been accepted and it becomes "Next".
                    const pageHasEssay = questionBlocks.some(block =>
                        block.querySelector('.ql-editor[contenteditable="true"]')
                    );

                    if (pageHasEssay && navLabel === 'skip') {
                        await sleep(300);
                        continue;
                    }

                    const anyUnchecked = questionBlocks.some(block => {
                        const rs = Array.from(block.querySelectorAll('input[type="radio"]'));

                        // MCQ: unanswered when no radio is checked.
                        if (rs.length > 0) {
                            return !rs.some(r => r.checked);
                        }

                        // Essay: unanswered when the Quill editor is empty.
                        const essayEditor =
                            block.querySelector('.quill .ql-editor[contenteditable="true"]') ||
                            block.querySelector('.ql-editor[contenteditable="true"]') ||
                            block.querySelector('[contenteditable="true"][class*="ql-editor"]');

                        if (essayEditor) {
                            return !(essayEditor.innerText || essayEditor.textContent || '').trim();
                        }

                        return false;
                    });

                    if (!anyUnchecked) {
                        const currentId = ($('[data-id="question-content"]')?.closest('[id^="question_"]'))?.id || document.body.innerText.length;
                        nextBtn.click();
                        await waitFor(() => {
                            const newId = ($('[data-id="question-content"]')?.closest('[id^="question_"]'))?.id || document.body.innerText.length;
                            return newId !== currentId;
                        }, 5000);
                        await sleep(800);
                    } else {
                        await sleep(1000);
                    }
                } 
                else if (submitBtn && !submitBtn.disabled) {
                    submitBtn.click();
                    window.isAutoAnswerRunning = false;
                    if (btn) { btn.textContent = 'Selesai'; btn.style.backgroundColor = '#6c757d'; }
                    break;
                } 
                else {
                    await sleep(1000);
                }
            }
        } catch (e) {
            console.error(e);
            alert("Error Auto Answer: " + e.message);
        } finally {
            if (window.isAutoAnswerRunning && btn) {
                window.isAutoAnswerRunning = false;
                btn.textContent = '🎲 Jawab Acak';
                btn.style.backgroundColor = '#28a745';
            }
        }
    }

    // =================================================================================
    // BAGIAN 2: EKSTRAK QUIZ (CSS FONT DIPERKUAT)
    // =================================================================================
    async function jalankanProsesEkstraksi() {
        window.isAutoAnswerRunning = false;
        const btnAuto = document.getElementById('quiz-answer-btn');
        if (btnAuto) { btnAuto.textContent = '🎲 Jawab Acak'; btnAuto.style.backgroundColor = '#28a745'; }

        const btn = document.getElementById('quiz-extractor-btn');
        if (btn) { btn.textContent = '⏳ Memproses...'; btn.disabled = true; }

        try {
            const esc = (s) => s ? s.replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m])) : '';
            function sanitizeHTML(html) { if (!html) return ''; const tpl = document.createElement('template'); tpl.innerHTML = html; const walker = document.createTreeWalker(tpl.content, NodeFilter.SHOW_ELEMENT, null); const toRemove = []; while (walker.nextNode()) { const el = walker.currentNode; const tag = el.tagName ? el.tagName.toLowerCase() : ''; if (tag === 'script') { toRemove.push(el); continue; } [...el.attributes].forEach(attr => { const name = attr.name.toLowerCase(); const val = (attr.value || '').trim(); if (name.startsWith('on')) el.removeAttribute(attr.name); if ((name === 'href' || name === 'src') && /^javascript:/i.test(val)) el.removeAttribute(attr.name); }); } toRemove.forEach(n => n.remove()); return tpl.innerHTML; }
            function pickText(el) { return el ? (el.textContent || el.innerText || '').trim() : ''; }
            function getFullCourseTitleImmediate() { const el = $('h1.CourseNodeHeader-module__courseTitleHeadingTwo--RL41B[data-test-id="course-module-name"]') || $('h1[data-test-id="course-module-name"]') || $('h1[class*="courseTitleHeadingTwo"]') || $('[class*="CourseNodeHeader-module__wrapper"] h1') || $('h1'); return pickText(el) || 'Quiz'; }
            async function getFullCourseTitle() { const now = getFullCourseTitleImmediate(); if (now !== 'Quiz') return now; const el = await waitFor(() => $('h1[data-test-id="course-module-name"]') || $('h1[class*="courseTitleHeadingTwo"]') || null, 2000, 120); return el ? pickText(el) : 'Quiz'; }
            
            function toSafeFileBase(fullTitle) {
                return String(fullTitle || 'Quiz')
                    .replace(/[:\\/*?"<>|]/g, '')
                    .replace(/\s+/g, ' ')
                    .trim() || 'Quiz';
            }

            function parseQNumFromIndexText(s) { if (!s) return null; const m = s.match(/Question(?:\s*#)?\s*(\d+)/i); return m ? parseInt(m[1], 10) : null; }
            function getNextAriaNumber() { const btn = $('[data-test-id="attempt-review-footer-nextattempt"]') || $('button[class*="__nextbtn"]') || $('.RunFooter-module__rightButton--gMXAV'); if (!btn) return null; const aria = btn.getAttribute('aria-label') || ''; const m = aria.match(/Next item question #(\d+)/i); return m ? parseInt(m[1], 10) : null; }
            function getTotalQuestionsFromNav() { const table = $('table[data-test-id="exam-review-results"]') || $('.css-19cszzt'); if (!table) return null; const rows = $all('tbody tr', table); if (rows.length) return rows.length; const rowsById = $all('tbody tr[id^="exam-review-table-row-"]', table); if (rowsById.length) return rowsById.length; const nums = $all('tbody tr td:first-child span', table).map(s => parseInt((s.textContent || '').trim(), 10)).filter(n => Number.isFinite(n)); return nums.length ? Math.max(...nums) : null; }
            
            function extractFromContainer(root, readingHTML) { const content = $('[data-id="question-content"]', root) || root; const idxEl = $('.QuestionBody-module__questionOrder--kNol4,[class*="questionOrder"]', root); const indexText = idxEl ? idxEl.innerText.trim() : ($('[data-test-id="attempt-review-question-index"]')?.innerText?.trim() || ($('[data-id="runner-header-question-index"]')?.innerText?.trim()) || null); const qEl = $('.QuestionBody-module__questionText--mVV91,[class*="QuestionBody-module__questionText"]', root) || content; const questionHTML = qEl.innerHTML; const questionText = qEl.innerText.trim(); const group = $('[role="radiogroup"]', root) || root; const blocks = $all('[data-id="question-body-container"]', group); const makeChoice = (container, idx) => { const letterEl = $('[class*="alphaOrdinal"]', container); const textEl = $('[class*="optionText"]', container) || container; const correctImg = $('img[alt="Correct Answer"]', container) || $('img[src*="check-icon"]', container); const letter = (letterEl ? letterEl.innerText : String.fromCharCode(65 + idx)).replace(/[)\.]/g, '').trim(); const choiceHTML = (textEl.innerHTML || '').trim(); const choiceText = (textEl.innerText || '').trim(); return { letter, text: choiceText, html: choiceHTML, isCorrect: !!correctImg }; }; const choices = blocks.length ? blocks.map(makeChoice) : $all('label[class*="e1bppr3n2"], label', group).map(makeChoice); let expWrap = $('[id^="question-explanation-"]', root); if (!expWrap) { const secs = $all('section', root); expWrap = secs.find(s => s.querySelector('b')) || secs[0] || null; } let explanationHTML = '', explanationText = '', explanationHasLabel = false; if (expWrap) { const clone = expWrap.cloneNode(true); explanationHasLabel = !!$('b', clone); explanationHTML = clone.innerHTML.trim(); explanationText = clone.innerText.trim(); } const idEl = content.closest('[id^="question_"]') || content; const qId = idEl.id || null; const correct = choices.find(c => c.isCorrect) || null; return { id: qId, indexText, questionHTML, questionText, choices, correct, explanationHTML, explanationText, explanationHasLabel, readingHTML: readingHTML || null }; }
            function collectAllQuestionsOnPage() { const results = []; const setContainer = $('.AttemptReview-module__questionSetContainer--k2LgH') || $('[data-question-target="overview"]')?.closest('.AttemptReview-module__questionSetContainer--k2LgH') || $('.Runner-module__questionSetContainer--ovz6k'); if (setContainer) { const readingEl = $('.QuestionSet-module__questionText--e_VDw', setContainer) || $('[data-question-target="overview"]', setContainer); const readingHTML = readingEl ? readingEl.innerHTML : null; const qBodies = $all('.QuestionSet-module__questionSetBodyContainer--N7Atb', setContainer).map(span => $('.QuestionBody-module__questionContainer--wi5XU', span) || span).filter(Boolean); qBodies.forEach(root => { const rec = extractFromContainer(root, readingHTML); results.push(rec); }); return { records: results, pageMaxQNum: getMaxQNumFromRecords(results) }; } const wrap = $('[data-id="question-content"]'); if (wrap) { const rec = extractFromContainer(wrap, null); return { records: [rec], pageMaxQNum: parseQNumFromIndexText(rec.indexText) || null }; } return { records: [], pageMaxQNum: null }; }
            function getMaxQNumFromRecords(recs) { let max = null; recs.forEach(r => { const n = parseQNumFromIndexText(r.indexText); if (Number.isFinite(n)) max = max == null ? n : Math.max(max, n); }); return max; }

            async function captureAll() {
                await waitFor(() => $('[data-id="question-content"]') || $('.AttemptReview-module__questionSetContainer--k2LgH') || $('.Runner-module__questionSetContainer--ovz6k'));
                let prevFirstId = ($('[data-id="question-content"]')?.closest('[id^="question_"]') || $('[data-id="question-content"]'))?.id || null;
                const totalFromNav = getTotalQuestionsFromNav();
                const all = [];
                const seen = new Set();
                while (true) {
                    const { records: pageRecs, pageMaxQNum } = collectAllQuestionsOnPage();
                    for (const rec of pageRecs) {
                        const key = rec.id || (rec.indexText + '|' + rec.questionText.slice(0, 40));
                        if (!seen.has(key)) { seen.add(key); all.push(rec); }
                    }
                    if (totalFromNav && pageMaxQNum && pageMaxQNum >= totalFromNav) break;
                    const nextBtn = $('[data-test-id="attempt-review-footer-nextattempt"]') || $('button[class*="__nextbtn"]') || $('[data-test-id="runnner-footer-nextskip-button"]') || $('.RunFooter-module__rightButton--gMXAV'); 
                    if (!nextBtn || nextBtn.disabled) break;
                    const nextNum = getNextAriaNumber();
                    if (pageMaxQNum != null && nextNum != null && nextNum <= pageMaxQNum) break;
                    if (totalFromNav && nextNum > totalFromNav) break;
                    nextBtn.click();
                    const changed = await waitFor(() => { const nowId = ($('[data-id="question-content"]')?.closest('[id^="question_"]') || $('[data-id="question-content"]'))?.id || null; return (nowId && nowId !== prevFirstId) ? nowId : null; }, CONFIG.LOAD_TIMEOUT_MS, 120);
                    if (!changed) break;
                    prevFirstId = changed;
                }
                return all;
            }

            function gatherOriginalHead() { let headBits = ['<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">']; document.querySelectorAll('link[rel="stylesheet"], style, head script').forEach(el => { headBits.push(el.outerHTML); }); return headBits.join("\n"); }
            function getPageTemplate(title, originalHeadHTML, bodyHTML) { 
                const mjxCfg = `<script>window.MathJax = window.MathJax || {}; MathJax.chtml = Object.assign({ matchFontHeight: false }, MathJax.chtml || {});</script>`; 
                // Paksa root font size ke 16px
                const normalize = `<style>html { font-size: 16px !important; } @media print { .qc-reading.qc-break { page-break-before: always; break-before: page; } .qc-item { page-break-inside: avoid; break-inside: avoid; } body { padding:0 20px; } }</style>`; 
                
                const quizStyles = `
<style>
:root { --qc-maxw: 900px; --qc-pad: 16px; --qc-gray: #f3f4f6; --qc-reading:#f9fafb; }
html, body { background:#fff; }
body { font-family:"Open Sans", Arial, sans-serif; color:#333; margin:0; padding:24px; }
.qc-container { margin: 0 auto; max-width: var(--qc-maxw); }
.qc-title { font-size:20px; font-weight:700; margin:0 0 12px; }
