                return '<!doctype html><html><head><title>' + esc(title) + '</title>' + mjxCfg + originalHeadHTML + quizStyles + normalize + '</head><body>' + bodyHTML + '</body></html>'; 
            }
            
            function renderListHTML(records, displayTitle, mode) { 
                let html = '<div class="qc-container"><h1 class="qc-title">' + esc(displayTitle) + '</h1>'; 
                let lastReadingKey = null, firstBlock = true; 
                records.forEach((rec, i) => { 
                    if (rec.readingHTML && rec.readingHTML !== lastReadingKey) { 
                        const readingClass = firstBlock ? 'qc-reading' : 'qc-reading qc-break'; 
                        html += (firstBlock ? '' : '<hr class="qc-breakMarker">') + `<section class="${readingClass}">${rec.readingHTML}</section>`; 
                        lastReadingKey = rec.readingHTML; firstBlock = false; 
                    } 
                    const idxText = rec.indexText || ('Question ' + (i + 1)); 
                    const choiceLis = rec.choices.map(ch => { 
                        const core = (ch.html && ch.html.length) ? ch.html : esc(ch.text); 
                        const tick = (mode === 'A' && ch.isCorrect) ? '<span class="qc-tick">✓</span>' : ''; 
                        const base = '<span class="qc-letter">' + esc(ch.letter) + ')</span>' + '<span class="qc-text">' + core + tick + '</span>'; 
                        return '<li class="qc-choice ' + ((mode === 'A' && ch.isCorrect) ? 'qc-correct' : '') + '">' + base + '</li>'; 
                    }).join(''); 
                    
                    html += `<article class="qc-item" data-qid="${esc(rec.id || ('q-' + (i + 1)))}"><h3>${esc(idxText)}</h3><div class="qc-stem">${(rec.questionHTML || esc(rec.questionText))}</div><ul class="qc-choices">${choiceLis}</ul>`; 
                    
                    if (mode === 'A') { 
                        html += '<div class="qc-answer-block">' + (rec.explanationHTML ? (rec.explanationHasLabel ? `<div class="qc-expl">` + rec.explanationHTML + '</div>' : `<div class="qc-expl"><b>Explanation:</b> ` + rec.explanationHTML + '</div>') : '<div class="qc-expl"><b>Explanation:</b> <em>No explanation found.</em></div>') + '</div>'; 
                    } 
                    html += '</article>'; firstBlock = false; 
                }); 
                html += '</div>'; return html; 
            }
            
            function openTabWith(docHTML) { const win = window.open('', '_blank'); if (!win) { alert('Popup diblokir. Izinkan pop-up untuk situs ini.'); return; } const doc = win.document; doc.open(); doc.write(docHTML); doc.close(); try { if (win.MathJax && win.MathJax.typesetPromise) { win.MathJax.typesetPromise(); } } catch (_) {} }

            const fullTitle = await getFullCourseTitle();
            const safeFileBase = toSafeFileBase(fullTitle);
            const records = await captureAll();
            if (!records || !records.length) { alert('Tidak ada pertanyaan yang tertangkap.'); return; }
            const originalHead = gatherOriginalHead();

            const questionsFileTitle = safeFileBase + ' - Questions';
            const questionsBody = renderListHTML(records, fullTitle, 'Q');
            openTabWith(getPageTemplate(questionsFileTitle, originalHead, questionsBody));
            await sleep(200);

            const answersFileTitle = safeFileBase + ' - Answers';
            const answersBody = renderListHTML(records, fullTitle, 'A');
            openTabWith(getPageTemplate(answersFileTitle, originalHead, answersBody));

        } catch (err) {
            console.error(err);
            alert('Gagal memproses quiz: ' + err.message);
