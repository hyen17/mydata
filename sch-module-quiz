            if (btn) { btn.textContent = '🖨️ Ekstrak Quiz'; btn.disabled = false; }
        }
    }

    // =================================================================================
    // BAGIAN 3: AUTO GRADING ESSAY -> 0 POINTS
    // =================================================================================
    async function jalankanGradingNol() {
        const btn = document.getElementById('quiz-grade-zero-btn');
        if (btn) {
            btn.disabled = true;
            btn.textContent = '⏳ Grading 0...';
        }

        try {
            // Pastikan tab Ungraded aktif bila tersedia.
            const tabs = $all('[data-id="exam-review-section"]');
            const ungradedTab = tabs.find(t => (t.innerText || t.textContent || '').trim().toLowerCase() === 'ungraded');
            if (ungradedTab && ungradedTab.getAttribute('aria-selected') !== 'true') {
                ungradedTab.click();
                await sleep(500);
            }

            const getRows = () => $all('tr[data-test-id="exam-review-answer"]')
                .filter(row => {
                    const txt = (row.innerText || row.textContent || '').toLowerCase();
                    return txt.includes('ungraded');
                });

            let safety = 0;

            while (safety++ < 500) {
                const rows = getRows();
                if (!rows.length) break;

                const row = rows[0];
                const rowId = row.id || '';

                row.click();

                // Tunggu detail soal + score input muncul.
                const scoreInput = await waitFor(() => {
                    const candidates = $all('input[aria-label="Question count"], input[title="count value"], input.count-value');
                    return candidates.find(el => el.offsetParent !== null) || candidates[0] || null;
                }, 5000, 100);

                if (!scoreInput) {
                    console.warn('Score input tidak ditemukan untuk', rowId || row);
                    await sleep(300);
                    continue;
                }

                // Isi score = 0 dengan native setter agar React mengenali perubahan.
                const nativeSetter = Object.getOwnPropertyDescriptor(
                    window.HTMLInputElement.prototype,
                    'value'
                )?.set;

                scoreInput.focus();

                if (nativeSetter) {
                    nativeSetter.call(scoreInput, '0');
                } else {
                    scoreInput.value = '0';
                }

                scoreInput.dispatchEvent(new InputEvent('input', {
                    bubbles: true,
                    inputType: 'insertText',
                    data: '0'
                }));
                scoreInput.dispatchEvent(new Event('change', { bubbles: true }));
                scoreInput.dispatchEvent(new Event('blur', { bubbles: true }));

                await sleep(250);

                // Jika React mengembalikan field kosong, coba fallback keyboard-like.
                if ((scoreInput.value || '').trim() !== '0') {
                    scoreInput.focus();
                    try {
                        document.execCommand('selectAll', false, null);
                        document.execCommand('insertText', false, '0');
                    } catch (_) {}

                    scoreInput.dispatchEvent(new InputEvent('input', {
                        bubbles: true,
                        inputType: 'insertText',
                        data: '0'
                    }));
                    scoreInput.dispatchEvent(new Event('change', { bubbles: true }));
                    await sleep(250);
                }

                // Beberapa halaman langsung menyimpan score saat field berubah.
                // Jika ada tombol eksplisit Save/Grade/Submit untuk grading, klik.
                const actionBtn = $all('button').find(b => {
                    if (b.disabled || b.offsetParent === null) return false;
                    const t = (b.innerText || b.textContent || '').trim().toLowerCase();
                    return ['save', 'grade', 'submit grade', 'save grade', 'apply'].includes(t);
                });

                if (actionBtn) {
                    actionBtn.click();
                    await sleep(500);
                }

                // Tunggu row tidak lagi "ungraded" bila state langsung diperbarui.
                await waitFor(() => {
                    const sameRow = rowId ? document.getElementById(rowId) : null;
                    if (!sameRow) return true;
                    const txt = (sameRow.innerText || sameRow.textContent || '').toLowerCase();
                    return !txt.includes('ungraded');
                }, 1500, 100);

                // Refresh daftar dan lanjut ke row ungraded berikutnya.
                await sleep(250);
            }

            if (safety >= 500) {
                console.warn('Grading dihentikan oleh safety limit.');
            }

            const remaining = getRows().length;
            if (remaining === 0) {
                if (btn) btn.textContent = '✅ Grading 0 Selesai';
            } else {
                if (btn) btn.textContent = `⚠️ Sisa ${remaining}`;
                alert(`Masih ada ${remaining} soal Ungraded. Kemungkinan halaman membutuhkan tombol simpan grading yang berbeda.`);
            }

        } catch (err) {
            console.error(err);
            alert('Gagal grading 0: ' + err.message);
            if (btn) btn.textContent = '0️⃣ Grading 0';
        } finally {
            if (btn) {
                btn.disabled = false;
                setTimeout(() => {
                    if (btn.textContent === '✅ Grading 0 Selesai') {
                        btn.textContent = '0️⃣ Grading 0';
                    }
                }, 2000);
            }
        }
    }

