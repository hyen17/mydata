  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function parseNumberSelection(input) {
    const text = String(input || "").trim();

    if (!text) {
      throw new Error("Pilihan module masih kosong.");
    }

    const result = [];
    const parts = text.split(",").map(x => x.trim()).filter(Boolean);

    for (const part of parts) {
      if (/^\d+$/.test(part)) {
        result.push(Number(part));
        continue;
      }

      const rangeMatch = part.match(/^(\d+)\s*-\s*(\d+)$/);
      if (rangeMatch) {
        const start = Number(rangeMatch[1]);
        const end = Number(rangeMatch[2]);

        if (end < start) {
          throw new Error(`Range tidak valid: ${part}`);
        }

        for (let n = start; n <= end; n++) {
          result.push(n);
        }
        continue;
      }

      throw new Error(`Format pilihan tidak valid: ${part}`);
    }

    return [...new Set(result)];
  }

  function getSelectedModules() {
    if (!resources) {
      throw new Error("Upload resources dulu.");
