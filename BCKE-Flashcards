    const numbers = parseNumberSelection(selectionInput.value);
    const mode = modeSelect.value;

    if (mode === "order") {
      return numbers.map(orderNumber => {
        const mod = resources.modules[orderNumber - 1];
        if (!mod) {
          throw new Error(`Module urutan ${orderNumber} tidak ditemukan.`);
        }
        return {
          orderNumber,
          moduleId: mod.id,
          flashcardIds: mod.flashcardIds,
          label: ""
        };
      });
    }

    const moduleById = new Map(resources.modules.map((mod, index) => [
      String(mod.id),
      {
        orderNumber: index + 1,
        moduleId: mod.id,
        flashcardIds: mod.flashcardIds,
        label: ""
      }
    ]));

    return numbers.map(moduleId => {
      const mod = moduleById.get(String(moduleId));
      if (!mod) {
        throw new Error(`Module ID ${moduleId} tidak ditemukan.`);
      }
      return mod;
    });
  }

