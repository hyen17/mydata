  async function fetchFlashcard(id, moduleLabelById) {
    const response = await fetch(`${BASE_URL}${encodeURIComponent(id)}`, {
      credentials: "include",
      headers: {
        "accept": "application/json, text/plain, */*"
      }
    });

    if (!response.ok) {
      throw new Error(`Gagal fetch flashcard ${id}: HTTP ${response.status}`);
    }

    const data = await response.json();
    const content = data && data.content ? data.content : data;

    if (!content) {
      throw new Error(`Format response flashcard ${id} tidak dikenali.`);
    }

    const moduleId = content.moduleId ?? "";

    return {
      id: content.id ?? id,
      flashcardNumber: content.flashcardNumber ?? "",
      moduleId,
      moduleLabel: moduleLabelById.get(String(moduleId)) || `Module ${moduleId}`,
      body: decodeHtmlEntities(content.body || ""),
      explanation: decodeHtmlEntities(content.explanation || "")
    };
  }

