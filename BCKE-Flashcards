    if (!Array.isArray(data.modules)) {
      throw new Error("Resources harus punya property modules berupa array.");
    }

    data.modules.forEach((mod, index) => {
      if (!mod || typeof mod !== "object") {
        throw new Error(`Module urutan ${index + 1} tidak valid.`);
      }

      if (mod.id === undefined || mod.id === null) {
        throw new Error(`Module urutan ${index + 1} tidak punya id.`);
      }

      if (!Array.isArray(mod.flashcardIds)) {
        throw new Error(`Module ${mod.id} tidak punya flashcardIds berupa array.`);
      }
    });
  }

