        selectedModules.map(mod => [String(mod.moduleId), mod.label || `Module ${mod.moduleId}`])
      );

      const ids = selectedModules.flatMap(mod => mod.flashcardIds);
      const uniqueIds = [...new Set(ids.map(String))];

      if (!uniqueIds.length) {
        throw new Error("Module yang dipilih tidak punya flashcardIds.");
      }

      printWindow = window.open("", "_blank");
      if (!printWindow) {
        throw new Error("Popup diblokir browser. Izinkan popup untuk halaman ini, lalu coba lagi.");
      }

      printWindow.document.open();
      printWindow.document.write(`
        <!doctype html>
        <html>
          <head>
            <title>Loading Flashcards...</title>
            <style>
              body {
                font-family: Arial, sans-serif;
                padding: 32px;
                line-height: 1.5;
              }
            </style>
          </head>
          <body>
            <h1>Mengambil flashcards...</h1>
            <p>Tab ini akan otomatis berubah menjadi halaman print setelah selesai.</p>
          </body>
        </html>
      `);
      printWindow.document.close();

      generateBtn.disabled = true;
      continuePrintBtn.disabled = true;

      const flashcards = [];
      const failed = [];

      for (let i = 0; i < uniqueIds.length; i++) {
        const id = uniqueIds[i];
        setStatus(`Mengambil flashcard ${i + 1}/${uniqueIds.length}: ${id}`);

        try {
          const card = await fetchFlashcard(id, moduleLabelById);
          flashcards.push(card);
        } catch (err) {
          failed.push({
            id,
            error: err.message || String(err)
          });
        }
      }

      const title = titleInput.value.trim() || "Becker Flashcards";
      const autoPrint = autoPrintSelect.value === "yes";

      const html = buildPrintableHtml({
        title,
        flashcards,
        failed,
        autoPrint
      });

      printWindow.document.open();
      printWindow.document.write(html);
      printWindow.document.close();

      labelPanel.style.display = "none";
      pendingSelectedModules = null;

      setStatus(
        `Selesai.\n` +
        `Flashcard berhasil: ${flashcards.length}\n` +
        `Flashcard gagal: ${failed.length}`
      );
    } catch (err) {
      if (printWindow && !printWindow.closed) {
        printWindow.close();
      }

      setStatus(`Error: ${err.message || String(err)}`);
    } finally {
      generateBtn.disabled = !resources;
      continuePrintBtn.disabled = false;
    }
  }

  fileInput.addEventListener("change", async () => {
    const file = fileInput.files && fileInput.files[0];

    if (!file) return;

    try {
      setStatus(`Membaca file: ${file.name}`);
      const text = await file.text();
      const data = parseJSONLoose(text);
      validateResources(data);

      resources = data;

      selectionInput.disabled = false;
      generateBtn.disabled = false;
      selectionInput.value = "1";
      labelPanel.style.display = "none";
      pendingSelectedModules = null;

      const totalModules = resources.modules.length;
      const totalFlashcards = resources.modules.reduce((sum, mod) => sum + mod.flashcardIds.length, 0);

      countPill.textContent = `${totalModules} modules · ${totalFlashcards} flashcards`;
      setStatus(
        `Resources berhasil dibaca.\n` +
        `Total modules: ${totalModules}\n` +
        `Total flashcards: ${totalFlashcards}\n\n` +
        `Silakan pilih module, contoh: 1-5 atau 968,979 sesuai mode.`
      );

      renderPreview();
    } catch (err) {
      resources = null;
      selectionInput.disabled = true;
      generateBtn.disabled = true;
      labelPanel.style.display = "none";
      pendingSelectedModules = null;
      previewBox.style.display = "none";
      countPill.textContent = "Resources error";
      setStatus(`Error membaca resources: ${err.message || String(err)}`);
    }
  });

  modeSelect.addEventListener("change", () => {
    labelPanel.style.display = "none";
    pendingSelectedModules = null;

    if (modeSelect.value === "order") {
      selectionInput.placeholder = "Contoh: 1-5 atau 1,3,5-7";
      $("#bfp-mode-hint").textContent = "Contoh: 1 atau 1-5 atau 1,3,5-7";
      if (resources) selectionInput.value = "1";
    } else {
      selectionInput.placeholder = "Contoh: 968,979";
      $("#bfp-mode-hint").textContent = "Contoh: 968 atau 968,979";
      if (resources && resources.modules[0]) selectionInput.value = String(resources.modules[0].id);
    }
  });

  sampleBtn.addEventListener("click", () => {
    labelPanel.style.display = "none";
    pendingSelectedModules = null;

    if (modeSelect.value === "order") {
      selectionInput.value = "1-5";
    } else if (resources && resources.modules.length >= 2) {
      selectionInput.value = resources.modules.slice(0, 2).map(m => m.id).join(",");
    } else {
      selectionInput.value = "968,979";
    }
  });

  selectionInput.addEventListener("input", () => {
    labelPanel.style.display = "none";
    pendingSelectedModules = null;
  });

  generateBtn.addEventListener("click", () => {
    try {
      const selectedModules = getSelectedModules();
      showModuleLabelForm(selectedModules);
    } catch (err) {
      setStatus(`Error: ${err.message || String(err)}`);
    }
  });

  continuePrintBtn.addEventListener("click", () => {
    const selectedModules = collectModuleLabels();
    generatePrintHtml(selectedModules);
  });

  cancelLabelBtn.addEventListener("click", () => {
    labelPanel.style.display = "none";
    pendingSelectedModules = null;
    setStatus("Generate dibatalkan. Silakan ubah pilihan module atau klik Generate lagi.");
  });

  console.log("Becker Flashcard Print Builder siap digunakan.");
})();
