          status.textContent =
            'Popup blocked. Allow popups for this site.';


          status.style.color =
            '#dc2626';

        }

      }


      return;

    }


    // ==========================================================
    // SAVE FILES
    // ==========================================================

    saveHtml(

      questionsHtml,

      questionsFilename

    );


    setTimeout(
      () => {

        saveHtml(

          answersHtml,

          answersFilename

