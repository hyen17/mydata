      !info
    ) {

      updateMergeUI();

      return;

    }


    if (
      !state.latestJson
    ) {

      status.textContent =
        `Waiting for ${TARGET_PATH} ...`;


      status.style.color =
        '#64748b';


      info.innerHTML = `
        No matching JSON captured yet.
      `;


      updateMergeUI();


      return;

    }


    const quiz =
      getCurrentQuiz();


    status.textContent =
      'Latest practice JSON captured';


    status.style.color =
      '#15803d';


    info.innerHTML = `

      <div
        style="
          margin-bottom:5px;
        "
      >

        <strong>
          Section:
        </strong>

        ${escapeHtml(
          quiz?.title ||
          ''
        )}

      </div>


      <div>

        <strong>
          Readings:
        </strong>

        ${quiz?.groups?.length || 0}

      </div>


      <div>

        <strong>
          Questions:
        </strong>

        ${quiz?.questions?.length || 0}

      </div>


      <div>

        <strong>
          Captured:
        </strong>

        ${escapeHtml(
          state.latestCapturedAt ||
          ''
        )}

      </div>


      <div
        style="
          margin-top:5px;
          word-break:break-all;
        "
      >

        <strong>
          URL:
        </strong>

        ${escapeHtml(
          state.latestUrl ||
          ''
        )}

      </div>

    `;


    updateMergeUI();

  }


  // ============================================================
  // CAPTURE JSON
  // ============================================================

  function captureJson(
    json,
    url
  ) {

    if (
      !json ||
      typeof json !==
        'object'
    ) {

      return;

    }


    const data =
      getDataRoot(
        json
      );


    if (
      !Array.isArray(
        data?.questions
      )
    ) {

      return;

    }


    state.latestJson =
      json;


    state.latestUrl =
      String(
        url ||
        TARGET_PATH
      );


    state.latestCapturedAt =
      new Date()
        .toLocaleString();


    try {

      sessionStorage.setItem(

        JSON_CACHE_KEY,

        JSON.stringify({

          json:
            state.latestJson,

          url:
            state.latestUrl,

          capturedAt:
            state.latestCapturedAt

        })

      );

    } catch (
      err
    ) {

      console.warn(
        '[Practice Exporter] JSON cache failed:',
        err
      );

    }


    updatePanel();


    console.log(
      '[Practice Exporter] Latest quiz captured:',
      getCurrentQuiz()
    );

  }


  // ============================================================
  // INTERCEPT FETCH
  // ============================================================

  if (
    typeof state.originalFetch ===
      'function'
  ) {

    window.fetch =
      async function (
        ...args
      ) {

        const response =
          await state
            .originalFetch
            .apply(
              this,
              args
            );


        try {

          const firstArg =
            args[0];


          const requestUrl =

            typeof firstArg ===
              'string'

              ? firstArg

              : (
                  firstArg?.url ||
                  response?.url ||
                  ''
                );


          const responseUrl =
            response?.url ||
            '';


          if (

            isTargetUrl(
              requestUrl
            )

            ||

            isTargetUrl(
              responseUrl
            )

          ) {

            response
              .clone()
              .json()
              .then(
                json => {

                  captureJson(

                    json,

                    responseUrl ||
                    requestUrl

                  );

                }
              )
              .catch(
                err => {

                  console.warn(
                    '[Practice Exporter] Fetch response parse failed:',
                    err
                  );

                }
              );

          }

        } catch (
          err
        ) {

          console.warn(
            '[Practice Exporter] Fetch interceptor error:',
            err
          );

        }


        return response;

      };

  }


  // ============================================================
  // INTERCEPT XHR
  // ============================================================

  XMLHttpRequest.prototype.open =
    function (
      method,
      url,
      ...rest
    ) {

      this.__pheUrl =
        String(
          url ||
          ''
        );


      return state
        .originalXhrOpen
        .call(
          this,
          method,
          url,
          ...rest
        );

    };


  XMLHttpRequest.prototype.send =
    function (
      body
    ) {

      const xhr =
        this;


      if (
        isTargetUrl(
          xhr.__pheUrl
        )
      ) {

        xhr.addEventListener(

          'load',

          function () {

            try {

              let json;


              if (
                xhr.responseType ===
                  'json'
              ) {

                json =
                  xhr.response;

              } else {

                json =
                  JSON.parse(
                    xhr.responseText
                  );

              }


              captureJson(

                json,

                xhr.responseURL ||
                xhr.__pheUrl

              );

            } catch (
              err
            ) {

              console.warn(
                '[Practice Exporter] XHR response parse failed:',
                err
              );

            }

          },

          {
            once:
              true
          }

        );

      }


      return state
        .originalXhrSend
        .call(
          xhr,
          body
        );

    };


  // ============================================================
  // SAVE CURRENT QUIZ FOR MERGE
  // ============================================================

  function saveCurrentQuizForMerge() {

    const current =
      getCurrentQuiz();


    if (
      !current ||
      !current.questions.length
    ) {

      alert(
        'Belum ada quiz yang dapat disimpan.'
      );

      return;

    }


    const bundle =
      deepClone(
        current
      );


    const savedData = {

      bundle,

      savedAt:
        new Date()
          .toLocaleString()

    };


    try {

      sessionStorage.setItem(

        MERGE_CACHE_KEY,

        JSON.stringify(
          savedData
        )

      );


      state.savedQuiz =
        savedData;


      const status =
        document.getElementById(
          'phe-status'
        );


      if (
        status
      ) {

        status.textContent =
          `Saved ${bundle.questions.length} questions for merge`;

        status.style.color =
          '#2563eb';

      }


      updateMergeUI();


      console.log(
        '[Practice Exporter] Quiz saved for merge:',
        bundle
      );

    } catch (
      err
    ) {

      console.error(
        '[Practice Exporter] Unable to save quiz for merge:',
        err
      );


      alert(
        'Quiz tidak dapat disimpan ke sessionStorage. Kemungkinan ukuran JSON terlalu besar.'
      );

    }

  }


  // ============================================================
  // GET CORRECT ANSWER
  // ============================================================

  function getCorrectAnswerInfo(
    questionEntry
  ) {

    const question =
      questionEntry.question;


    const answers =
      Array.isArray(
        question?.answers
      )
        ? question.answers
        : [];


    if (
      !answers.length
    ) {

      return null;

    }


    let correctIndex =
      answers.findIndex(
        answer =>
          answer?.isCorrect ===
            true
      );


    if (
      correctIndex === -1 &&
      questionEntry.correctAnswerId != null
    ) {

      correctIndex =
        answers.findIndex(
          answer =>

            String(
              answer?.id
            )

            ===

            String(
              questionEntry.correctAnswerId
            )
        );

    }


    if (
      correctIndex === -1
    ) {

      return null;

    }


    return {

      index:
        correctIndex,

      label:
        choiceLabel(
          correctIndex
        ),

      answer:
        answers[
          correctIndex
        ]

    };

  }


  // ============================================================
  // CONVERT QUIZ BUNDLE INTO SEGMENTS
  //
  // Segment:
  // - readingHtml
  // - questions
  //
  // Jika tidak ada reading:
  // - readingHtml = ''
  // - questions tetap dirender
  //
  // ============================================================

  function createSegmentsFromQuiz(
    quiz
  ) {

    const questions =
      Array.isArray(
        quiz?.questions
      )
        ? quiz.questions
        : [];


    const groups =
      Array.isArray(
        quiz?.groups
      )
        ? quiz.groups
        : [];


    const cors =
      quiz?.cors ||
      {};


    const entries =
      questions.map(
        (
          question,
          originalIndex
        ) => {

          const correctAnswerId =

            cors?.[
              question?.id
            ]

            ??

            cors?.[
              String(
                question?.id
              )
            ];


          return {

            question,

            originalIndex,

            correctAnswerId,

            exportNumber:
              null

          };

        }
      );


    // ----------------------------------------------------------
    // IMPORTANT:
    // NO READING CASE
    //
    // groups kosong -> langsung satu segment tanpa reading.
    // Tidak akan error.
    // ----------------------------------------------------------

    if (
      !groups.length
    ) {

      return [

        {

          readingHtml:
            '',

          questions:
            entries

        }

      ];

    }


    const questionMap =
      new Map();


    entries.forEach(
      entry => {

        const groupId =
          String(
            entry
              .question
              ?.groupId ??
            ''
          );


        if (
          !questionMap.has(
            groupId
          )
        ) {

          questionMap.set(
            groupId,
            []
          );

        }


        questionMap
          .get(
            groupId
          )
          .push(
            entry
          );

      }
    );


    const sortedGroups =
      [...groups].sort(
        (
          a,
          b
        ) => {

          const positionA =
            Number(
              a?.questionsPositionStart
            );


          const positionB =
            Number(
              b?.questionsPositionStart
            );


          const safeA =
            Number.isFinite(
              positionA
            )
              ? positionA
              : Number.MAX_SAFE_INTEGER;


          const safeB =
            Number.isFinite(
              positionB
            )
              ? positionB
              : Number.MAX_SAFE_INTEGER;


          return (
            safeA -
            safeB
          );

        }
      );


    const handledEntries =
      new Set();


    const segments =
      [];


    sortedGroups.forEach(
      group => {

        const groupId =
          String(
            group?.id ??
            ''
          );


        const groupQuestions =
          questionMap.get(
            groupId
          ) ||
          [];


        if (
          !groupQuestions.length
        ) {

          return;

        }


        groupQuestions.forEach(
          entry =>
            handledEntries.add(
              entry
            )
        );


        segments.push({

          // HANYA group.text
          readingHtml:
            group?.text ||
            '',

          questions:
            groupQuestions

        });

      }
    );


    // ----------------------------------------------------------
    // QUESTIONS YANG GROUP-NYA TIDAK DITEMUKAN
    // ----------------------------------------------------------

    const orphans =
      entries.filter(
        entry =>
          !handledEntries.has(
            entry
          )
      );


    if (
      orphans.length
    ) {

      segments.push({

        readingHtml:
          '',

        questions:
          orphans

      });

    }


    // ----------------------------------------------------------
    // Jika groups ada tetapi tidak satupun cocok,
    // tetap render semua questions.
    // ----------------------------------------------------------

    if (
      !segments.length
    ) {

      segments.push({

        readingHtml:
          '',

        questions:
          entries

      });

    }


    return segments;

  }


  // ============================================================
  // BUILD DOCUMENT MODEL
  //
  // mergeActive = true:
  // Question numbers diubah menjadi 1,2,3,... global.
  //
  // mergeActive = false:
  // memakai questionDisplayNumber asli.
  // ============================================================

  function buildDocumentModel(
    quizzes,
    mergeActive
  ) {

    const segments =
      [];


    quizzes.forEach(
      quiz => {

        const quizSegments =
          createSegmentsFromQuiz(
            quiz
          );


        quizSegments.forEach(
          segment =>
            segments.push(
              segment
            )
        );

      }
    );


    const allEntries =
      segments.flatMap(
        segment =>
          segment.questions
      );


    if (
      mergeActive
    ) {

      allEntries.forEach(
        (
          entry,
          index
        ) => {

          entry.exportNumber =
            String(
              index + 1
            );

        }
      );

    } else {

      allEntries.forEach(
        (
          entry,
          index
        ) => {

          entry.exportNumber =

            entry
              .question
              ?.questionDisplayNumber

            ||

            entry
              .question
              ?.ordinal

            ||

            String(
              index + 1
            );

        }
      );

    }


    return {

      segments,

      totalQuestions:
        allEntries.length

    };

  }


  // ============================================================
  // RENDER CHOICES
  // ============================================================

  function renderChoices(
    questionEntry,
    answerMode
  ) {

    const question =
      questionEntry.question;


    const answers =
      Array.isArray(
        question?.answers
      )
        ? question.answers
        : [];


    if (
      !answers.length
    ) {

      return '';

    }


    const correctInfo =
      getCorrectAnswerInfo(
        questionEntry
      );


    return `

      <div
        class="choices"
      >

        ${answers.map(
          (
            answer,
            index
          ) => {

            const label =
              choiceLabel(
                index
              );


            const isCorrect =
              Boolean(

                answerMode

                &&

                correctInfo

                &&

                correctInfo.index ===
                  index

              );


            return `

              <div
                class="
                  choice-row
                  ${
                    isCorrect
                      ? 'choice-correct'
                      : ''
                  }
                "
              >

                <div
                  class="choice-letter"
                >
                  ${label}.
                </div>


                <div
                  class="choice-content"
                >
                  ${answer?.text || ''}
                </div>


                <div
                  class="choice-mark"
                >
                  ${
                    isCorrect
                      ? '✓'
                      : ''
                  }
                </div>

              </div>

            `;

          }
        ).join('')}

      </div>

    `;

  }


  // ============================================================
  // CORRECT ANSWER LABEL
  // ============================================================

  function renderCorrectAnswerLabel(
    questionEntry
  ) {

    const correctInfo =
      getCorrectAnswerInfo(
