(() => {
  'use strict';

  // ============================================================
  // PRACTICE HTML EXPORTER - VERSION 5
  //
  // FEATURES
  // ============================================================
  //
  // 1. Monitor:
  //    /json/practice/exam/get
  //
  // 2. Output:
  //    - Open in New Tabs (DEFAULT / Blob URL)
  //    - Save HTML Files
  //
  // 3. Export:
  //    - Questions
  //    - Answers
  //
  // 4. HTML fields ONLY:
  //    - groups[].text
  //    - questionText
  //    - answers[].text
  //    - solutionText
  //
  //    Tidak memakai:
  //    - questionTextSrc
  //    - solutionTextSrc
  //
  // 5. Reading:
  //    - Reading berdasarkan groupId
  //    - Jika TIDAK ada reading, TIDAK ERROR
  //    - Soal langsung ditampilkan
  //    - Reading kedua dan seterusnya mulai halaman baru saat print
  //
  // 6. Answers:
  //    - Correct choice diberi tanda ✓
  //    - Correct Answer: A/B/C
  //
  // 7. MERGE QUIZ:
  //    - Default OFF
  //    - Jika ON:
  //        muncul tombol "Save Current Quiz for Merge"
  //
  //    Workflow:
  //
  //      Quiz 1
  //      -> centang Merge Quiz
  //      -> Save Current Quiz for Merge
  //
  //      pindah ke Quiz 2
  //      -> JSON Quiz 2 terdeteksi
  //      -> Process
  //
  //      OUTPUT:
  //      Quiz 1 + Quiz 2
  //
  //    - Penomoran merged quiz selalu dibuat ulang:
  //      Question 1
  //      Question 2
  //      ...
  //      Question 8
  //      Question 9
  //      ...
  //
  //      Jadi tidak akan kembali ke nomor 1.
  //
  // 8. Temporary saved quiz:
  //    - sessionStorage
  //    - tetap ada selama session/tab browser masih sama
  //
  // ============================================================


  // ============================================================
  // CONFIG
  // ============================================================

  const TARGET_PATH =
    '/json/practice/exam/get';

  const PANEL_ID =
    'practice-html-exporter-panel';

  const GLOBAL_KEY =
    '__PRACTICE_HTML_EXPORTER_V5__';

  const JSON_CACHE_KEY =
    '__practice_html_exporter_latest_json_v5__';

  const MERGE_CACHE_KEY =
    '__practice_html_exporter_merge_quiz_v5__';


  // ============================================================
  // REMOVE OLD EXPORTER VERSIONS SAFELY
  // ============================================================

  const OLD_GLOBAL_KEYS = [
    '__PRACTICE_HTML_EXPORTER__',
    '__PRACTICE_HTML_EXPORTER_V2__',
    '__PRACTICE_HTML_EXPORTER_V3__',
    '__PRACTICE_HTML_EXPORTER_V4__',
    '__PRACTICE_HTML_EXPORTER_V5__'
  ];


  let baseFetch = null;

  let baseXhrOpen = null;

  let baseXhrSend = null;


  for (
    const key
    of OLD_GLOBAL_KEYS
  ) {

    const oldState =
      window[key];


    if (
      !oldState
    ) {
      continue;
    }


    if (
      !baseFetch &&
      typeof oldState.originalFetch ===
        'function'
    ) {

      baseFetch =
        oldState.originalFetch;

    }


    if (
      !baseXhrOpen &&
      typeof oldState.originalXhrOpen ===
        'function'
    ) {

      baseXhrOpen =
        oldState.originalXhrOpen;

    }


    if (
      !baseXhrSend &&
      typeof oldState.originalXhrSend ===
        'function'
    ) {

      baseXhrSend =
        oldState.originalXhrSend;

    }

  }


  if (
    baseFetch
  ) {

    window.fetch =
      baseFetch;

  }


  if (
    baseXhrOpen
  ) {

    XMLHttpRequest.prototype.open =
      baseXhrOpen;

  }


  if (
    baseXhrSend
  ) {

    XMLHttpRequest.prototype.send =
      baseXhrSend;

  }


  for (
    const key
    of OLD_GLOBAL_KEYS
  ) {

    try {

      delete window[key];

    } catch (_) {

      window[key] =
        undefined;

    }

  }


  const existingPanel =
    document.getElementById(
      PANEL_ID
    );


  if (
    existingPanel
  ) {

    existingPanel.remove();

  }


  // ============================================================
  // STATE
  // ============================================================

  const state = {

    installed:
      true,

    latestJson:
      null,

    latestUrl:
      '',

    latestCapturedAt:
      null,

    savedQuiz:
      null,

    originalFetch:
      baseFetch ||
      window.fetch,

    originalXhrOpen:
      baseXhrOpen ||
      XMLHttpRequest.prototype.open,

    originalXhrSend:
      baseXhrSend ||
      XMLHttpRequest.prototype.send,

    blobUrls:
      []

  };


  window[GLOBAL_KEY] =
    state;


  // ============================================================
  // BASIC UTILITIES
  // ============================================================

  function isTargetUrl(
    url
  ) {

    try {

      return String(
        url ||
        ''
      ).includes(
        TARGET_PATH
      );

    } catch (_) {

      return false;

    }

  }


  function escapeHtml(
    value
  ) {

    return String(
      value ??
      ''
    )
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /'/g,
        '&#039;'
      );

  }


  function choiceLabel(
    index
  ) {

    if (
      index >= 0 &&
      index < 26
    ) {

      return String.fromCharCode(
        65 + index
      );

    }


    return String(
      index + 1
    );

  }


  function cleanFilename(
    name
  ) {

    return String(
      name ||
      'Practice Exam'
    )
      .replace(
        /[\\/:*?"<>|]/g,
        '-'
      )
      .replace(
        /\s+/g,
        ' '
      )
      .trim();

  }


  function deepClone(
    value
  ) {

    return JSON.parse(
      JSON.stringify(
        value
      )
    );

  }


  function getDataRoot(
    json
  ) {

    return (
      json?.data ||
      json ||
      {}
    );

  }


  // ============================================================
  // SIMPLE HASH
  //
  // Digunakan untuk mengenali apakah Current Quiz
  // berbeda dari Saved Quiz.
  // ============================================================

  function hashString(
    input
  ) {

    let hash =
      2166136261;


    const text =
      String(
        input ||
        ''
      );


    for (
      let i = 0;
      i < text.length;
      i++
    ) {

      hash ^=
        text.charCodeAt(
          i
        );


      hash +=
        (
          hash << 1
        ) +
        (
          hash << 4
        ) +
        (
          hash << 7
        ) +
        (
          hash << 8
        ) +
        (
          hash << 24
        );

    }


    return (
      hash >>> 0
    ).toString(
      16
    );

  }


  // ============================================================
  // EXTRACT QUIZ BUNDLE FROM JSON
  // ============================================================

  function extractQuizBundle(
    json
  ) {

    const data =
      getDataRoot(
        json
      );


    const questions =
      Array.isArray(
        data?.questions
      )
        ? data.questions
        : [];


    const groups =
      data?.groups &&
      typeof data.groups ===
        'object'

        ? Object.values(
            data.groups
          )

        : [];


    const sections =
      data?.sections &&
      typeof data.sections ===
        'object'

        ? Object.values(
            data.sections
          )

        : [];


    const topSection =
      sections.find(
        section =>
          section?.name
      );


    const questionSection =
      questions.find(
        question =>
          question
            ?.sections
            ?.[0]
            ?.name
      )
        ?.sections
        ?.[0];


    const title =

      topSection?.name

      ||

      questionSection?.name

      ||

      'Practice Exam';


    const cors =

      data?.cors &&
      typeof data.cors ===
        'object'

        ? data.cors

        : {};


    const fingerprintSource =
      [
        title,

        questions.length,

        ...questions.map(
          question => {

            return [
              question?.id ?? '',
              question?.groupId ?? '',
              question?.questionText ?? ''
            ].join(
              ':'
            );

          }
        )
      ].join(
        '|'
      );


    const fingerprint =
      hashString(
        fingerprintSource
      );


    return {

      title,

      questions,

      groups,

      cors,

      fingerprint

    };

  }


  // ============================================================
  // GET CURRENT QUIZ
  // ============================================================

  function getCurrentQuiz() {

    if (
      !state.latestJson
    ) {
      return null;
    }


    return extractQuizBundle(
      state.latestJson
    );

  }


  // ============================================================
  // RESTORE LATEST JSON CACHE
  // ============================================================

  try {

    const cached =
      JSON.parse(

        sessionStorage.getItem(
          JSON_CACHE_KEY
        ) ||

        'null'

      );


    if (
      cached?.json
    ) {

      state.latestJson =
        cached.json;


      state.latestUrl =
        cached.url ||
        '';


      state.latestCapturedAt =
        cached.capturedAt ||
        '';

    }

  } catch (
    err
  ) {

    console.warn(
      '[Practice Exporter] JSON cache restore failed:',
      err
    );

  }


  // ============================================================
  // RESTORE SAVED MERGE QUIZ
  // ============================================================

  try {

    const saved =
      JSON.parse(

        sessionStorage.getItem(
          MERGE_CACHE_KEY
        ) ||

        'null'

      );


    if (
      saved?.bundle
    ) {

      state.savedQuiz =
        saved;

    }

  } catch (
    err
  ) {

    console.warn(
      '[Practice Exporter] Merge cache restore failed:',
      err
    );

  }


  // ============================================================
  // UPDATE MERGE UI
  // ============================================================

  function updateMergeUI() {

    const mergeCheckbox =
      document.getElementById(
        'phe-merge-checkbox'
      );


    const saveMergeButton =
      document.getElementById(
        'phe-save-merge-button'
      );


    const mergeInfo =
      document.getElementById(
        'phe-merge-info'
      );


    if (
      !mergeCheckbox ||
      !saveMergeButton ||
      !mergeInfo
    ) {

      return;

    }


    const enabled =
      mergeCheckbox.checked;


    saveMergeButton.style.display =
      enabled
        ? 'block'
        : 'none';


    mergeInfo.style.display =
      enabled
        ? 'block'
        : 'none';


    if (
      !enabled
    ) {

      return;

    }


    const current =
      getCurrentQuiz();


    if (
      !state.savedQuiz?.bundle
    ) {

      mergeInfo.innerHTML = `

        <div
          style="
            color:#64748b;
          "
        >
          No quiz saved for merge.
        </div>

      `;


      return;

    }


    const saved =
      state.savedQuiz.bundle;


    const sameQuiz =

      current &&

      current.fingerprint ===
        saved.fingerprint;


    mergeInfo.innerHTML = `

      <div
        style="
          font-weight:700;
          color:#334155;
          margin-bottom:4px;
        "
      >
        Saved Merge Quiz
      </div>


      <div>
        ${escapeHtml(
          saved.title
        )}
      </div>


      <div
        style="
          color:#64748b;
          margin-top:2px;
        "
      >
        ${saved.questions.length}
        questions
      </div>


      ${
        current

          ? `

            <div
              style="
                margin-top:6px;
                padding-top:6px;
                border-top:1px solid #e2e8f0;
                font-weight:700;
                color:${
                  sameQuiz
                    ? '#b45309'
                    : '#15803d'
                };
              "
            >

              ${
                sameQuiz

                  ? 'Current quiz is the saved quiz — it will not be duplicated.'

                  : 'New quiz detected — Process will merge both quizzes.'
              }

            </div>

          `

          : ''
      }

    `;

  }


  // ============================================================
  // UPDATE MAIN PANEL
  // ============================================================

  function updatePanel() {

    const status =
      document.getElementById(
        'phe-status'
      );


    const info =
      document.getElementById(
        'phe-capture-info'
      );


    if (
