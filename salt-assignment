  // ============================================================
  // CREATE BLOB URL
  // ============================================================

  function createBlobUrl(
    html
  ) {

    const blob =
      new Blob(

        [
          html
        ],

        {
          type:
            'text/html;charset=utf-8'
        }

      );


    const url =
      URL.createObjectURL(
        blob
      );


    state.blobUrls.push(
      url
    );


    return url;

  }


  // ============================================================
  // OPEN HTML IN PREPARED TAB
  // ============================================================

  function openInPreparedTab(
    tab,
    html
  ) {

    if (
      !tab
    ) {

      return false;

    }


    try {

      const blobUrl =
        createBlobUrl(
          html
        );


      tab.location.href =
        blobUrl;


      return true;

    } catch (
      err
    ) {

      console.error(
        '[Practice Exporter] Open Blob failed:',
        err
      );


      return false;

    }

  }


  // ============================================================
  // SAVE HTML
  // ============================================================

  function saveHtml(
    html,
    filename
  ) {

    const blob =
      new Blob(

        [
          html
        ],

        {
          type:
            'text/html;charset=utf-8'
        }

      );


    const blobUrl =
      URL.createObjectURL(
        blob
      );


    const anchor =
      document.createElement(
        'a'
      );


    anchor.href =
      blobUrl;


    anchor.download =
      filename;


    anchor.style.display =
      'none';


    document.body.appendChild(
      anchor
    );


    anchor.click();


    anchor.remove();


    setTimeout(
      () => {

        URL.revokeObjectURL(
          blobUrl
        );

      },
      10000
    );

  }


  // ============================================================
  // GET OUTPUT MODE
  // ============================================================

  function getOutputMode() {

    return (

      document.querySelector(
        'input[name="phe-output-mode"]:checked'
      )?.value

      ||

      'open'

    );

  }


