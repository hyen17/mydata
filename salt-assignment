    // ==========================================================
    // OPEN IN NEW TABS
    // ==========================================================

    if (
      mode === 'open'
    ) {

      // Dibuka langsung dari click event agar
      // kemungkinan popup blocking lebih kecil.

      const questionsTab =
        window.open(
          'about:blank',
          '_blank'
        );


      const answersTab =
        window.open(
          'about:blank',
          '_blank'
        );


      if (
        questionsTab
      ) {

        questionsTab.document.write(`

          <!DOCTYPE html>

          <html>

          <head>

            <title>
              Preparing Questions...
            </title>

          </head>

          <body
            style="
              font-family:Arial,sans-serif;
              padding:40px;
              color:#475569;
            "
          >

            Preparing Questions...

          </body>

          </html>

        `);


        questionsTab.document.close();

