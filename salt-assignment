  // ============================================================
  // EXPLANATION / MODEL ANSWER
  //
  // HANYA solutionText
  // ============================================================

  function renderAnswerContent(
    question
  ) {

    const answers =
      Array.isArray(
        question?.answers
      )
        ? question.answers
        : [];


    const isMcq =

      question
        ?.questionType
        ?.id === 1

      ||

      answers.length > 0;


    const solutionHtml =
      question?.solutionText ||
      '';


    if (
      !solutionHtml
    ) {

      return '';

    }


    if (
      isMcq
    ) {

      return `

        <div
          class="explanation-box"
        >

          <div
            class="box-title"
          >
            Explanation
          </div>


          <div
            class="solution-content"
          >
            ${solutionHtml}
          </div>

        </div>

      `;

    }


    return `

      <div
        class="model-answer-box"
      >

        <div
          class="box-title"
        >
          Model Answer / Explanation
        </div>


        <div
          class="solution-content"
        >
          ${solutionHtml}
        </div>

      </div>

    `;

  }


  // ============================================================
  // RUBRIC
  // ============================================================

  function renderRubric(
    question
  ) {

    const rubrics =
      Array.isArray(
        question?.rubricScores
      )
        ? question.rubricScores
        : [];


    if (
      !rubrics.length
    ) {

      return '';

    }


    return `

      <div
        class="rubric-box"
      >

        <div
          class="box-title"
        >
          Scoring Rubric
        </div>


        <div
          class="rubric-items"
        >

          ${rubrics.map(
            rubric => `

              <div
                class="rubric-item"
              >
                ${rubric?.text || ''}
              </div>

            `
          ).join('')}

        </div>

      </div>

    `;

  }


  // ============================================================
  // RENDER QUESTION
  //
  // HANYA questionText
  // ============================================================

  function renderQuestion(
    questionEntry,
    answerMode
  ) {

    const question =
      questionEntry.question;


    const number =
      questionEntry.exportNumber;


    const questionHtml =
      question?.questionText ||
      '';


    const answers =
      Array.isArray(
        question?.answers
      )
        ? question.answers
        : [];


    const isMcq =

      question
        ?.questionType
        ?.id === 1

      ||

      answers.length > 0;


    return `

      <section
        class="question-block"
      >

        <div
          class="question-number"
        >
          Question ${escapeHtml(
            number
          )}
        </div>


        <div
          class="question-text"
        >
          ${questionHtml}
        </div>


        ${
          renderChoices(
            questionEntry,
            answerMode
          )
        }


        ${
          answerMode &&
          isMcq

            ? renderCorrectAnswerLabel(
                questionEntry
              )

            : ''
        }


        ${
          answerMode

            ? renderAnswerContent(
                question
              )

            : ''
        }


        ${
          answerMode &&
          !isMcq

            ? renderRubric(
                question
              )

            : ''
        }

      </section>

    `;

  }


  // ============================================================
  // RENDER SEGMENTS
  //
  // Jika readingHtml kosong:
  // langsung render questions.
  //
  // Tidak dibuat fake "Reading".
  // ============================================================

  function renderSegments(
    documentModel,
    answerMode
  ) {

    const segments =
      documentModel.segments;


    let html =
      '';


    let readingNumber =
      0;


    segments.forEach(
      segment => {

        const hasReading =
          Boolean(
            String(
              segment?.readingHtml ||
              ''
            ).trim()
          );


        if (
          hasReading
        ) {

          readingNumber++;


          const firstEntry =
            segment.questions[
              0
            ];


          const lastEntry =
            segment.questions[
              segment.questions.length - 1
            ];


          const firstNumber =
            firstEntry
              ?.exportNumber ||
            '';


          const lastNumber =
            lastEntry
              ?.exportNumber ||
            '';


          let rangeText =
            '';


          if (
            firstNumber &&
            lastNumber
          ) {

            rangeText =

              firstNumber ===
                lastNumber

                ? `Q${firstNumber}`

                : `Q${firstNumber}–Q${lastNumber}`;

          }


          const readingClass =

            readingNumber === 1

              ? 'first-reading'

              : 'new-reading';


          html += `

            <section
              class="
                reading-section
                ${readingClass}
              "
            >

              <div
                class="reading-heading"
              >

                <span
                  class="reading-number"
                >
                  Reading ${readingNumber}
                </span>


                <span
                  class="reading-range"
                >
                  ${escapeHtml(
                    rangeText
                  )}
                </span>

              </div>


              <div
                class="reading-content"
              >
                ${segment.readingHtml}
              </div>

            </section>

          `;

        }


        segment.questions.forEach(
          questionEntry => {

            html +=
              renderQuestion(

                questionEntry,

                answerMode

              );

          }
        );

      }
    );


    return html;

  }


  // ============================================================
  // DETERMINE DOCUMENT TITLE
  // ============================================================

  function getDocumentTitle(
    quizzes,
    merged
  ) {

    if (
      !merged ||
      quizzes.length <= 1
    ) {

      return (
        quizzes[0]?.title ||
        'Practice Exam'
      );

    }


    const titles =
      [
        ...new Set(
          quizzes.map(
            quiz =>
              quiz?.title ||
              'Practice Exam'
          )
        )
      ];


    if (
      titles.length === 1
    ) {

      return (
        `${titles[0]} - Merged Quiz`
      );

    }


    return (
      `${titles.join(' + ')} - Merged Quiz`
    );

  }


