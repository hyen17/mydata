    const title =
      getDocumentTitle(

        quizzes,

        actuallyMerged

      );


    const questionsHtml =
      buildHtml({

        title,

        documentModel,

        answerMode:
          false

      });


    const answersHtml =
      buildHtml({

        title,

        documentModel,

        answerMode:
          true

