    // ----------------------------------------------------------
    // MERGE SAVED QUIZ + CURRENT QUIZ
    // ----------------------------------------------------------

    if (
      mergeEnabled &&
      state.savedQuiz?.bundle
    ) {

      const saved =
        state.savedQuiz.bundle;


      if (
        saved.fingerprint !==
        current.fingerprint
      ) {

        quizzes = [

          deepClone(
            saved
          ),

          deepClone(
            current
          )

        ];


        actuallyMerged =
          true;

