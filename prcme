  /* =========================================================
     GENERIC OBJECT HELPERS
     ========================================================= */

  function isObject(
    value
  ) {
    return (
      value !== null &&
      typeof value ===
        'object' &&
      !Array.isArray(
        value
      )
    );
  }

  function walkObject(
    value,
    visitor,
    seen =
      new WeakSet()
  ) {
    if (
      value === null ||
      typeof value !==
        'object'
    ) {
      return;
    }

    if (
      seen.has(
        value
      )
    ) {
      return;
    }

    seen.add(
      value
    );

    visitor(
      value
    );

    if (
      Array.isArray(
        value
      )
    ) {
      for (
        const item of value
      ) {
        walkObject(
          item,
          visitor,
          seen
        );
      }

      return;
    }

    for (
      const child
      of Object.values(
        value
      )
    ) {
      walkObject(
        child,
        visitor,
        seen
      );
    }
  }

  /* =========================================================
     PARSE INPUT
     ========================================================= */

  function findQuestionIdsInObject(
    root
  ) {
    let result =
      null;

    walkObject(
      root,
      obj => {
        if (
          result
        ) {
          return;
        }

        if (
          Array.isArray(
            obj.questionIds
          )
        ) {
          const ids =
            obj.questionIds
              .map(
                value =>
                  String(
                    value
                  ).trim()
              )
              .filter(
                value =>
                  /^[a-f0-9]{24}$/i.test(
                    value
                  )
              );

          if (
            ids.length
          ) {
            result =
              ids;
          }
        }
      }
    );

    return result || [];
  }

  function findMockTitleInObject(
    root
  ) {
    let found =
      '';

    walkObject(
      root,
      obj => {
        if (
          found
        ) {
          return;
        }

        if (
          obj.mockExam &&
          isObject(
            obj.mockExam
          )
        ) {
          const title =
            obj.mockExam
              ?.title
              ?.en;

          if (
            typeof title ===
              'string' &&
            title.trim()
          ) {
            found =
              title.trim();
          }
        }
      }
    );

    return found;
  }

  function uniquePreserveOrder(
    values
  ) {
    const seen =
      new Set();

    const result =
      [];

    for (
      const value of values
    ) {
      if (
        seen.has(
          value
        )
      ) {
        continue;
      }

      seen.add(
        value
      );

      result.push(
        value
      );
    }

    return result;
  }

  function parseQuestionInput(
    raw
  ) {
    raw =
      String(
        raw || ''
      ).trim();

    if (
      !raw
    ) {
      return {
        ids: [],
        title: ''
      };
    }

    /*
      Try JSON first.
    */

    try {
      const parsed =
        JSON.parse(
          raw
        );

      let ids =
        [];

      let title =
        '';

      /*
        Direct array of IDs.
      */

      if (
        Array.isArray(
          parsed
        )
      ) {
        ids =
          parsed
            .map(
              value =>
                String(
                  value
                ).trim()
            )
            .filter(
              value =>
                /^[a-f0-9]{24}$/i.test(
                  value
                )
            );

      } else {
        ids =
          findQuestionIdsInObject(
            parsed
          );

        title =
          findMockTitleInObject(
            parsed
          );
      }

      if (
        ids.length
      ) {
        return {
          ids:
            uniquePreserveOrder(
              ids
            ),

          title
        };
      }

    } catch {
      /*
        Continue to text parsing.
      */
    }

    /*
      Plain text fallback.

      Accept:
        ID
        ID
        ID

      or:
        ID, ID, ID
    */

    const matches =
      raw.match(
        /\b[a-f0-9]{24}\b/gi
      ) || [];

    return {
      ids:
        uniquePreserveOrder(
          matches
        ),

      title: ''
    };
  }

