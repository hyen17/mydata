     ========================================================= */

  function looksLikeJWT(
    value
  ) {
    return (
      typeof value ===
        'string' &&
      /^eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/
        .test(
          value.trim()
        )
    );
  }

  function normalizeBearer(
    value
  ) {
    value =
      String(
        value || ''
      ).trim();

    if (
      !value
    ) {
      return '';
    }

    value =
      value.replace(
        /^Bearer\s+/i,
        ''
      );

    return value;
  }

  function searchJWTInValue(
    value,
    depth = 0
  ) {
    if (
      depth > 8 ||
      value === null ||
      value === undefined
    ) {
      return '';
    }

    if (
      typeof value ===
        'string'
    ) {
      const clean =
        normalizeBearer(
          value
        );

      if (
        looksLikeJWT(
          clean
        )
      ) {
        return clean;
      }

      /*
        JWT may be embedded inside another string.
      */

      const match =
        value.match(
          /eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/
        );

      if (
        match &&
        looksLikeJWT(
          match[0]
        )
      ) {
        return match[0];
      }

      /*
        JSON encoded string.
      */

      try {
        const parsed =
          JSON.parse(
            value
          );

        return searchJWTInValue(
          parsed,
          depth + 1
        );

      } catch {
        return '';
      }
    }

    if (
      Array.isArray(
        value
      )
    ) {
      for (
        const item of value
      ) {
        const result =
          searchJWTInValue(
            item,
            depth + 1
          );

        if (
          result
        ) {
          return result;
        }
      }

      return '';
    }

    if (
      isObject(
        value
      )
    ) {
      /*
        Prefer token-like keys.
      */

      const priorityKeys =
        [
          'accessToken',
          'access_token',
          'token',
          'jwt',
          'authorization',
          'authToken',
          'bearerToken'
        ];

      for (
        const key
        of priorityKeys
      ) {
        if (
          key in value
        ) {
          const result =
            searchJWTInValue(
              value[key],
              depth + 1
            );

          if (
            result
          ) {
            return result;
          }
        }
      }

      for (
        const child
        of Object.values(
          value
        )
      ) {
        const result =
          searchJWTInValue(
            child,
            depth + 1
          );

        if (
          result
        ) {
          return result;
        }
      }
    }

    return '';
  }

  function findJWTInStorage() {
    const storages =
      [
        window.localStorage,
        window.sessionStorage
      ];

    for (
      const storage of storages
    ) {
      try {
        /*
          First examine likely key names.
        */

        for (
          let i = 0;
          i <
          storage.length;
          i++
        ) {
          const key =
            storage.key(i);

          if (
            !key
          ) {
            continue;
          }

          if (
            /token|auth|session|user/i
              .test(
                key
              )
          ) {
            const found =
              searchJWTInValue(
                storage.getItem(
                  key
                )
              );

            if (
              found
            ) {
              return found;
            }
          }
        }

        /*
          Then examine all values.
        */

        for (
          let i = 0;
          i <
          storage.length;
          i++
        ) {
          const key =
            storage.key(i);

          const found =
            searchJWTInValue(
              storage.getItem(
                key
              )
            );

          if (
            found
          ) {
            return found;
          }
        }

      } catch {}
    }

    /*
      Non-HttpOnly cookie fallback.
    */

    try {
      const match =
        document.cookie.match(
          /eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/
        );

      if (
        match
      ) {
        return match[0];
      }
    } catch {}

    return '';
  }

  /* =========================================================
     ORGANIZATION ID DETECTION
     ========================================================= */

  function searchOrganizationId(
    value,
    depth = 0
  ) {
    if (
      depth > 8 ||
      value === null ||
      value === undefined
    ) {
      return '';
    }

    if (
      typeof value ===
        'string'
    ) {
      try {
        const parsed =
          JSON.parse(
            value
          );

        return searchOrganizationId(
          parsed,
          depth + 1
        );

      } catch {
        return '';
      }
    }

    if (
      Array.isArray(
        value
      )
    ) {
      for (
        const item of value
      ) {
        const result =
          searchOrganizationId(
            item,
            depth + 1
          );

        if (
          result
        ) {
          return result;
        }
      }

      return '';
    }

    if (
      isObject(
        value
      )
    ) {
      for (
        const [
          key,
          child
        ]
        of Object.entries(
          value
        )
      ) {
        if (
          /organization.?id/i
            .test(
              key
            )
        ) {
          const candidate =
            String(
              child || ''
            ).trim();

          if (
            /^[a-f0-9]{24}$/i
              .test(
                candidate
              )
          ) {
            return candidate;
          }
        }
      }

      for (
        const child
        of Object.values(
          value
        )
      ) {
        const result =
          searchOrganizationId(
            child,
            depth + 1
          );

        if (
          result
        ) {
          return result;
        }
      }
    }

    return '';
  }

  function findOrganizationIdInStorage() {
    const storages =
      [
        window.localStorage,
        window.sessionStorage
      ];

    for (
      const storage
      of storages
    ) {
      try {
        for (
          let i = 0;
          i <
          storage.length;
          i++
        ) {
          const key =
            storage.key(i);

          const raw =
            storage.getItem(
              key
            );

          /*
            Direct organization key.
          */

          if (
            /organization.?id/i
              .test(
                key || ''
              )
          ) {
            const direct =
              String(
                raw || ''
              )
              .replace(
                /^["']|["']$/g,
                ''
              )
              .trim();

            if (
              /^[a-f0-9]{24}$/i
                .test(
                  direct
                )
            ) {
              return direct;
            }
          }

          const found =
            searchOrganizationId(
              raw
            );

          if (
            found
          ) {
            return found;
          }
        }

      } catch {}
    }

    return '';
  }

  /* =========================================================
     HTTP HELPERS
     ========================================================= */

  function createAbortTimeout(
    milliseconds
  ) {
    const controller =
      new AbortController();

    const timer =
      setTimeout(
        () =>
          controller.abort(),
        milliseconds
      );

    return {
      controller,
      clear:
        () =>
          clearTimeout(
            timer
          )
    };
  }

  function buildHeaders() {
    const headers = {
      accept:
        'application/json, text/plain, */*',

      'cognit-app':
        'lms'
    };

    if (
      state.authorization
    ) {
      headers.authorization =
        `Bearer ${state.authorization}`;
    }

    if (
      state.organizationId
    ) {
      headers['organization-id'] =
        state.organizationId;
    }

    return headers;
  }

  /* =========================================================
     FETCH SINGLE QUESTION
     ========================================================= */

  async function fetchQuestionOnce(
    id
  ) {
    const timeout =
      createAbortTimeout(
        CONFIG.requestTimeout
      );

    try {
      const response =
        await fetch(
          state.apiBase +
          encodeURIComponent(
            id
          ),
          {
            method:
              'GET',

            headers:
              buildHeaders(),

            credentials:
              'include',

            mode:
              'cors',

            cache:
              'no-store',

            signal:
              timeout
                .controller
                .signal
          }
        );

      let body =
        null;

      const text =
        await response.text();

      try {
        body =
          JSON.parse(
            text
          );
      } catch {
        body =
          text;
      }

      if (
        !response.ok
      ) {
        const error =
          new Error(
            `HTTP ${response.status} ${response.statusText}`
          );

        error.status =
          response.status;

        error.body =
          body;

        throw error;
      }

      /*
        Support APIs wrapping response in:
          { data: {...} }
      */

      if (
        body &&
        isObject(
          body
        ) &&
        body.data &&
        isObject(
          body.data
        ) &&
        (
          body.data.answers ||
          body.data.text
        )
      ) {
        return body.data;
      }

      return body;

    } finally {
      timeout.clear();
    }
  }

  async function fetchQuestion(
    id
  ) {
    let lastError =
      null;

    for (
      let attempt = 0;
      attempt <=
        CONFIG.retryCount;
      attempt++
    ) {
      if (
        state.stopRequested
      ) {
        throw new Error(
          'Stopped'
        );
      }

      try {
        return await fetchQuestionOnce(
          id
        );

      } catch (
        error
      ) {
        lastError =
          error;

        /*
          Authentication errors should not be retried
          repeatedly.
        */

        if (
          error.status === 401 ||
          error.status === 403
        ) {
          throw error;
        }

        if (
          attempt <
          CONFIG.retryCount
        ) {
          await sleep(
            CONFIG.retryDelay *
            (
              attempt + 1
            )
          );
        }
      }
    }

    throw lastError;
  }

  /* =========================================================
     LANGUAGE HELPERS
     ========================================================= */

  function getEnglishHTML(
    value
  ) {
    if (
      value === null ||
      value === undefined
    ) {
      return '';
    }

    if (
      typeof value ===
        'string'
    ) {
      return value;
    }

    if (
      isObject(
        value
      )
    ) {
      if (
        typeof value.en ===
          'string'
      ) {
        return value.en;
      }

      /*
        Fallback to first string language.
      */

      const candidate =
        Object.values(
          value
        )
        .find(
          item =>
            typeof item ===
              'string'
        );

      return candidate || '';
    }

    return '';
  }

  /* =========================================================
     FACT PATTERN SUPPORT
     ========================================================= */

  function extractFactPatternHTML(
    question
  ) {
    const fp =
      question?.factPattern;

    if (
      !fp
    ) {
      return '';
    }

    if (
      typeof fp ===
        'string'
    ) {
      return fp;
    }

    /*
      Common possibilities.
    */

    const candidates =
      [
        fp.text,
        fp.body,
        fp.description,
        fp.content,
        fp
      ];

    for (
      const candidate
      of candidates
    ) {
      const html =
        getEnglishHTML(
          candidate
        );

      if (
        html
      ) {
        return html;
      }
    }

    return '';
  }

  /* =========================================================
     NORMALIZE API QUESTION
     ========================================================= */

  function normalizeQuestion(
    rawQuestion,
    questionId,
    position
  ) {
    if (
      !rawQuestion ||
      typeof rawQuestion !==
        'object'
    ) {
      throw new Error(
        'Invalid question response.'
      );
    }

    const questionHTML =
      getEnglishHTML(
        rawQuestion.text
      );

    if (
      !questionHTML
    ) {
      throw new Error(
        'Question text is missing.'
      );
    }

    const sourceAnswers =
      Array.isArray(
        rawQuestion.answers
      )
        ? [
            ...rawQuestion.answers
          ]
        : [];

    if (
      sourceAnswers.length < 2
    ) {
      throw new Error(
        'Question has fewer than two answers.'
      );
    }

    /*
      Respect API sorting.
      Stable fallback to original array order.
    */

    const answers =
      sourceAnswers
        .map(
          (
            answer,
            originalIndex
          ) => ({
            answer,
            originalIndex
          })
        )
        .sort(
          (
            a,
            b
          ) => {
            const sortingA =
              Number(
                a.answer
                  ?.sorting
              );

            const sortingB =
              Number(
                b.answer
                  ?.sorting
              );

            const validA =
              Number.isFinite(
                sortingA
              );

            const validB =
              Number.isFinite(
                sortingB
              );

            if (
              validA &&
              validB &&
              sortingA !==
                sortingB
            ) {
              return (
                sortingA -
                sortingB
              );
            }

            return (
              a.originalIndex -
              b.originalIndex
            );
          }
        )
        .map(
          item =>
            item.answer
        );

    const choices =
      answers.map(
        answer =>
          getEnglishHTML(
            answer.text
          )
      );

    const correctIndexes =
      [];

    answers.forEach(
      (
        answer,
        index
      ) => {
        if (
          answer?.isCorrect ===
          true
        ) {
          correctIndexes.push(
            index
          );
        }
      }
    );

    if (
      !correctIndexes.length
    ) {
      throw new Error(
        'No correct answer marked by API.'
      );
    }

    /*
      Current Mock Exam is multi-choice with one correct answer.
      Keep array support internally in case API expands later.
    */

    const correctIndex =
      correctIndexes[0];

    /*
      Build explanation from EVERY answer feedback
      in answer order.

      This recreates:
        Not (a) ...
        Not (b) ...
        Answer (c) is correct ...
        Not (d) ...
    */

    const feedbackParts =
      answers
        .map(
          answer =>
            getEnglishHTML(
              answer.feedback
            )
        )
        .filter(
          html =>
            String(
              html || ''
            ).trim()
        );

    const explanationHTML =
      feedbackParts.join(
        '\n'
      );

    return {
      position,

      questionId,

      apiId:
        rawQuestion.id ||
        rawQuestion._id ||
        questionId,

      externalId:
        rawQuestion.externalId ||
        '',

      reference:
        rawQuestion.reference ??
        '',

      type:
        rawQuestion.type ||
        '',

      factPatternHTML:
        extractFactPatternHTML(
          rawQuestion
        ),

      questionHTML,

      choices,

      correctIndex,

      correctIndexes,

      explanationHTML
    };
  }

  /* =========================================================
     AUTH ERROR MESSAGE
     ========================================================= */

  function describeFetchError(
    error
  ) {
    if (
      error?.status === 401
    ) {
      return (
        'Authorization failed (HTTP 401). ' +
        'Automatic Bearer token detection did not work or the session expired. ' +
        'Open Advanced / Authentication and paste the current Bearer token.'
      );
    }

    if (
      error?.status === 403
    ) {
      return (
        'Access was rejected (HTTP 403). ' +
        'Check the Bearer token and Organization ID under Advanced / Authentication.'
      );
    }

    if (
      error?.name ===
        'AbortError'
    ) {
      return (
        'Request timed out.'
      );
    }

    return (
      error?.message ||
      String(
        error
      )
    );
  }

  /* =========================================================
     FETCH ALL — SMALL WORKER POOL
     ========================================================= */

  async function fetchAllQuestions(
    ids
  ) {
    const total =
      ids.length;

    const results =
      new Array(
        total
      );

    let nextIndex =
      0;

    let completed =
      0;

    const worker =
      async () => {
        while (
          !state.stopRequested
        ) {
          const index =
            nextIndex++;

          if (
            index >= total
          ) {
            return;
          }

          const id =
            ids[index];

          setStatus(
            `Fetching Question ${index + 1} of ${total}…`
          );

          try {
            const raw =
              await fetchQuestion(
                id
              );

            const normalized =
              normalizeQuestion(
                raw,
                id,
                index + 1
              );

            results[index] =
              normalized;

          } catch (
            error
          ) {
            /*
              Auth failure:
              stop immediately because all subsequent requests
              would fail as well.
            */

            if (
              error?.status === 401 ||
              error?.status === 403
            ) {
              state.stopRequested =
                true;

              throw error;
            }

            state.failures.push({
              index:
                index + 1,

              id,

              error:
                describeFetchError(
                  error
                )
            });
          }

          completed++;

          setProgress(
            (
              completed /
              total
            ) * 100
          );

          setCounter(
            `${completed} of ${total} processed`
          );
        }
      };

    const workerCount =
      Math.min(
        CONFIG.concurrency,
        total
      );

    await Promise.all(
      Array.from(
        {
          length:
            workerCount
        },
        () =>
          worker()
      )
    );

    if (
      state.stopRequested &&
      state.failures.length === 0 &&
      completed <
        total
    ) {
      throw new Error(
        'Stopped by user.'
      );
    }

    return results.filter(
      Boolean
    );
  }

  /* =========================================================
     HTML ESCAPE
     ========================================================= */

  function escapeHTML(
    text
  ) {
    return String(
      text ?? ''
    )
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /'/g,
        '&#039;'
      );
  }

