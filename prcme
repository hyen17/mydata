      const items =
        Array.from(
          breadcrumb.querySelectorAll(
            'li'
          )
        );

      for (
        let i =
          items.length - 1;
        i >= 0;
        i--
      ) {
        const text =
          items[i]
            .innerText
            ?.trim();

        if (
          text
        ) {
          return text;
        }
      }
    }

    return 'Mock Exam';
