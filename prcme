  /* =========================================================
     REBUILD OUTPUT
     ========================================================= */

  function rebuildOutputs() {
    if (
      !state.questions.length
    ) {
      return;
    }

    state.questionHTML =
      buildOutputHTML(
        state.questions,
        false
      );

    state.answerHTML =
      buildOutputHTML(
        state.questions,
        true
      );
  }

  fontEl.addEventListener(
    'input',
    () => {
      if (
        state.questions.length
      ) {
        rebuildOutputs();
      }
    }
  );

  /* =========================================================
     OPEN HTML
     ========================================================= */

  function openHTML(
    html
  ) {
    const blob =
      new Blob(
        [html],
        {
          type:
            'text/html;charset=utf-8'
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const win =
      window.open(
        url,
        '_blank'
      );

    if (!win) {
      alert(
        'The browser blocked the new tab. Allow pop-ups or use Download.'
      );
    }

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      60000
    );
  }

  /* =========================================================
     DOWNLOAD
     ========================================================= */

  function sanitizeFilename(
    value
  ) {
    return String(
      value ||
      'Mock Exam'
    )
      .replace(
        /[<>:"/\\\\|?*]+/g,
        ' '
      )
      .replace(
        /\s+/g,
        ' '
      )
      .trim()
      .slice(
        0,
        120
      );
  }

  function downloadHTML(
    html,
    filename
  ) {
    const blob =
      new Blob(
        [html],
        {
          type:
            'text/html;charset=utf-8'
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const link =
      document.createElement(
        'a'
      );

    link.href =
      url;

    link.download =
      filename;

    document.body.appendChild(
      link
    );

    link.click();

    link.remove();

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      5000
    );
  }

  /* =========================================================
     FAILURE DISPLAY
     ========================================================= */

  function showFailures() {
    if (
      !state.failures.length
    ) {
      errorsEl.style.display =
        'none';

      errorsEl.innerHTML =
        '';

      return;
    }

    errorsEl.style.display =
      'block';

    const rows =
      state.failures
        .map(
          failure =>
            `
              <div>
                <b>#${failure.index}</b>
                ${escapeHTML(failure.id)}
                —
                ${escapeHTML(failure.error)}
              </div>
            `
        )
        .join('');

    errorsEl.innerHTML =
      `
        <b>
          ${state.failures.length}
          question(s) failed:
        </b>

        <div style="margin-top:5px">
          ${rows}
        </div>
      `;
  }

  /* =========================================================
     RUN
     ========================================================= */

  async function run() {
    if (
      state.running
    ) {
      return;
    }

    const parsed =
      parseQuestionInput(
        inputEl.value
      );

    if (
      !parsed.ids.length
    ) {
      inputEl.classList.add(
        'me-error-input'
      );

      inputEl.focus();

      setStatus(
        'Please paste valid question IDs or the complete Mock Exam JSON.'
      );

      return;
    }

    /* ---------------------------------------------------------
       INITIALIZE
       --------------------------------------------------------- */

    state.running =
      true;

    state.stopRequested =
      false;

    state.questionIds =
      parsed.ids;

    state.questions =
      [];

    state.failures =
      [];

    state.questionHTML =
      '';

    state.answerHTML =
      '';

    state.title =
      titleEl.value
        .trim() ||
      parsed.title ||
      'Mock Exam';

    state.apiBase =
      apiBaseEl.value
        .trim() ||
      DEFAULT_API_BASE;

    if (
      !state.apiBase.endsWith(
        '/'
      )
    ) {
      state.apiBase +=
        '/';
    }

    /* ---------------------------------------------------------
       AUTH
       --------------------------------------------------------- */

    const manualToken =
      normalizeBearer(
        tokenEl.value
      );

    const autoToken =
      findJWTInStorage();

    state.authorization =
      manualToken ||
      autoToken ||
      '';

    const manualOrg =
      orgEl.value
        .trim();

    const autoOrg =
      findOrganizationIdInStorage();

    state.organizationId =
      manualOrg ||
      autoOrg ||
      '';

    /* ---------------------------------------------------------
       UI
       --------------------------------------------------------- */

    startBtn.disabled =
      true;

    stopBtn.disabled =
      false;

    resultsEl.style.display =
      'none';

    errorsEl.style.display =
      'none';

    setProgress(
      0
    );

    setCounter(
      `0 of ${state.questionIds.length} processed`
    );

    const authParts =
      [];

    if (
      state.authorization
    ) {
      authParts.push(
        'token detected'
      );
    }

    if (
      state.organizationId
    ) {
      authParts.push(
        'organization detected'
      );
    }

    setStatus(
      authParts.length
        ? `Starting — ${authParts.join(', ')}.`
        : 'Starting with current browser session…'
    );

    try {
      /* -------------------------------------------------------
         FETCH
         ------------------------------------------------------- */

      const questions =
        await fetchAllQuestions(
          state.questionIds
        );

      /*
        Auth failure sets stopRequested but throws from worker.
      */

      state.questions =
        questions.sort(
          (
            a,
            b
          ) =>
            a.position -
            b.position
        );

      showFailures();

      if (
        !state.questions.length
      ) {
        throw new Error(
          'No questions were successfully fetched.'
        );
      }

      /* -------------------------------------------------------
         BUILD OUTPUT
         ------------------------------------------------------- */

      rebuildOutputs();

      resultsEl.style.display =
        'block';

      const success =
        state.questions.length;

      const total =
        state.questionIds.length;

      if (
        state.failures.length
      ) {
        setStatus(
          `Finished with warnings — ${success} of ${total} questions fetched successfully.`
        );

      } else {
        setProgress(
          100
        );

        setStatus(
          `Completed — ${success} questions fetched and converted.`
        );
      }

      setCounter(
        `${success} of ${total} questions ready`
      );

    } catch (
      error
    ) {
      console.error(
        '[Mock Exam Extractor]',
        error
      );

      /*
        Keep partial successful questions.
      */

      if (
        state.questions.length
      ) {
        rebuildOutputs();

        resultsEl.style.display =
          'block';
      }

      const message =
        describeFetchError(
          error
        );

      setStatus(
        `Error: ${message}`
      );

      showFailures();

    } finally {
      state.running =
        false;

      startBtn.disabled =
        false;

      stopBtn.disabled =
        true;
    }
  }

  /* =========================================================
     EVENTS
     ========================================================= */

  startBtn.addEventListener(
    'click',
    run
  );

  stopBtn.addEventListener(
    'click',
    () => {
      state.stopRequested =
        true;

      stopBtn.disabled =
        true;

      setStatus(
        'Stopping…'
      );
    }
  );

  $('#me-close')
    .addEventListener(
      'click',
      () => {
        if (
          state.running
        ) {
          const confirmClose =
            confirm(
              'Mock Exam Extractor is still running. Stop and close it?'
            );

          if (
            !confirmClose
          ) {
            return;
          }

          state.stopRequested =
            true;
        }

        panel.remove();
        style.remove();
      }
    );

  $('#me-open-q')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          state.questionHTML
        ) {
          openHTML(
            state.questionHTML
          );
        }
      }
    );

  $('#me-open-a')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          state.answerHTML
        ) {
          openHTML(
            state.answerHTML
          );
        }
      }
    );

  $('#me-download-q')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          !state.questionHTML
        ) {
          return;
        }

        downloadHTML(
          state.questionHTML,
          `${sanitizeFilename(
            state.title
          )} - Questions.html`
        );
      }
    );

  $('#me-download-a')
    .addEventListener(
      'click',
      () => {
        rebuildOutputs();

        if (
          !state.answerHTML
        ) {
          return;
        }

        downloadHTML(
          state.answerHTML,
          `${sanitizeFilename(
            state.title
          )} - Answers.html`
        );
      }
    );

  /* =========================================================
     READY
     ========================================================= */

  console.log(
    '%cMock Exam Extractor v1.0.0 loaded.',
    'font-weight:bold;color:#2563eb'
  );

  console.log(
    'Paste the complete Mock Exam JSON or question IDs into the floating UI.'
  );

})();
