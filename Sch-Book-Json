  const parseTocJson = (text) => {
    const json = JSON.parse(text);
    const items = Array.isArray(json) ? json : [json];
    let allNodes = [];

    for (const item of items) {
      const nodes = item?.data?.person?.learner?.course?.nodes;
      if (Array.isArray(nodes)) allNodes = allNodes.concat(nodes);
    }

    if (!allNodes.length) throw new Error("Tidak menemukan field data.person.learner.course.nodes di JSON TOC.");

    // Build hierarchy map
    const nodeMap = new Map();
    allNodes.forEach((n) => {
      nodeMap.set(n.nodeId, {
        nodeId: n.nodeId,
        parentNodeId: n.parentNodeId,
        title: n.title,
        children: [],
      });
    });

    // Link parent-child
    nodeMap.forEach((n) => {
      if (n.parentNodeId && nodeMap.has(n.parentNodeId)) {
        nodeMap.get(n.parentNodeId).children.push(n);
      }
    });

    // Identify: Topics (no parent in map), Readings (children of topics), Modules (children of readings)
    const topics = [];
    nodeMap.forEach((n) => {
      if (!n.parentNodeId || !nodeMap.has(n.parentNodeId)) {
        topics.push(n);
      }
    });

    // Flatten into pages list (modules + readings key concepts), preserving hierarchy context
    const pages = [];
    const walk = (node, topicTitle, readingTitle) => {
      if (node.children.length === 0) {
        pages.push({
          nodeId: node.nodeId,
          title: node.title,
          topic: topicTitle || "Unknown Topic",
          reading: readingTitle || null,
          parentNodeId: node.parentNodeId,
        });
      } else {
        if (!topicTitle) {
          node.children.forEach((c) => walk(c, node.title, null));
        } else {
          node.children.forEach((c) => walk(c, topicTitle, node.title));
        }
      }
    };

    topics.forEach((t) => walk(t, null, null));

    return { pages, topics, nodeMap };
  };

