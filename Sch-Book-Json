            <span style="color:#777;font-size:10px;">${topic.pages.length} pg</span>
          </summary>
          <div>
      `);

      topic.readings.forEach((reading, ri) => {
        const rSel = reading.pages.filter((p) => selectedNodeIds.has(p.nodeId)).length;
        const rAll = rSel === reading.pages.length && reading.pages.length > 0;
        const rSome = rSel > 0 && rSel < reading.pages.length;

        bits.push(`
          <details data-reading="${ti}-${ri}" open style="border-top:1px solid #eee;">
            <summary style="list-style:none;display:flex;align-items:flex-start;gap:8px;padding:5px 10px 5px 24px;background:#fafafa;cursor:pointer;">
              <input type="checkbox" data-reading-cb="${ti}-${ri}" ${rAll ? "checked" : ""} ${rSome ? "data-indeterminate='1'" : ""} style="margin-top:2px;">
              <span style="font-weight:700;flex:1;font-size:11px;">${escapeHtml(reading.title)}</span>
              <span style="color:#888;font-size:10px;">${reading.pages.length}</span>
            </summary>
            <div>
        `);

        reading.pages.forEach((page) => {
          bits.push(`
            <label style="display:flex;gap:7px;padding:4px 10px 4px 42px;align-items:flex-start;cursor:pointer;font-size:11px;">
              <input type="checkbox" data-node-id="${page.nodeId}" ${selectedNodeIds.has(page.nodeId) ? "checked" : ""} style="margin-top:2px;">
              <span style="min-width:0;flex:1;">${escapeHtml(page.title)} <span style="color:#999;">[${page.nodeId}]</span></span>
            </label>
          `);
        });

        bits.push(`</div></details>`);
      });

      bits.push(`</div></details>`);
    });

    container.innerHTML = bits.join("") || '<div style="padding:12px 14px;color:#666;">Tidak ada data.</div>';

    container.querySelectorAll('[data-indeterminate="1"]').forEach((cb) => {
      cb.indeterminate = true;
    });

    const totalSel = selectedNodeIds.size;
    const readingCount = hierarchy.reduce((n, t) => n + t.readings.length, 0);
    $('[data-role="pageSummary"]').textContent = `${hierarchy.length} Topics · ${readingCount} Readings · ${parsedPages.length} pages · ${totalSel} selected`;
  };

  $('[data-act="parseToc"]').onclick = () => {
    const text = $('[data-role="tocJson"]').value.trim();
    if (!text) {
      setStatus("❌ Paste TOC JSON dulu.", true);
      return;
    }
    try {
      const { pages } = parseTocJson(text);
      parsedPages = pages;
      selectedNodeIds = new Set(pages.map((p) => p.nodeId));
      hierarchy = buildHierarchicalPages(pages);

      $('[data-role="pageSection"]').style.display = "block";
      $('[data-role="optionsSection"]').style.display = "block";
      renderPageList();
      setStatus(`✅ Parsed: ${pages.length} halaman ditemukan di ${hierarchy.length} topics.`);
    } catch (e) {
      console.error(e);
      setStatus(`❌ Parse error: ${e.message}`, true);
      alert(`Parse error:\n${e.message}`);
    }
  };

  $('[data-act="clearToc"]').onclick = () => {
    $('[data-role="tocJson"]').value = "";
    $('[data-role="pageSection"]').style.display = "none";
    $('[data-role="optionsSection"]').style.display = "none";
    parsedPages = [];
    selectedNodeIds.clear();
    hierarchy = [];
    setStatus("Cleared.");
  };

  // ============================================================
  // Page list interaction
  // ============================================================
  $('[data-role="pageList"]').addEventListener("click", (e) => {
    if (e.target.matches("input[data-topic-cb],input[data-reading-cb]")) e.stopPropagation();
  });

  $('[data-role="pageList"]').addEventListener("change", (e) => {
    const t = e.target;
    if (t.matches("input[data-node-id]")) {
      const id = Number(t.dataset.nodeId);
      if (t.checked) selectedNodeIds.add(id);
      else selectedNodeIds.delete(id);
      renderPageList();
      return;
    }
    if (t.matches("input[data-topic-cb]")) {
      const ti = Number(t.dataset.topicCb);
      hierarchy[ti]?.pages.forEach((p) => {
        if (t.checked) selectedNodeIds.add(p.nodeId);
        else selectedNodeIds.delete(p.nodeId);
      });
      renderPageList();
      return;
    }
    if (t.matches("input[data-reading-cb]")) {
      const [ti, ri] = t.dataset.readingCb.split("-").map(Number);
      hierarchy[ti]?.readings[ri]?.pages.forEach((p) => {
        if (t.checked) selectedNodeIds.add(p.nodeId);
        else selectedNodeIds.delete(p.nodeId);
      });
      renderPageList();
    }
  });

  $('[data-act="selectAll"]').onclick = () => {
    selectedNodeIds = new Set(parsedPages.map((p) => p.nodeId));
    renderPageList();
  };
  $('[data-act="clearSel"]').onclick = () => {
    selectedNodeIds.clear();
    renderPageList();
  };
  $('[data-act="expandAll"]').onclick = () => {
    $('[data-role="pageList"]').querySelectorAll("details").forEach((d) => (d.open = true));
  };
  $('[data-act="collapseAll"]').onclick = () => {
    $('[data-role="pageList"]').querySelectorAll("details").forEach((d) => (d.open = false));
  };

  $('[data-act="close"]').onclick = () => {
    if (busy) {
      alert("Proses masih berjalan. Cancel terlebih dahulu.");
      return;
    }
    ui.remove();
  };

  cancelBtn.onclick = () => {
    cancelled = true;
    setStatus("Cancelling...");
  };

  // ============================================================
  // MAIN: Fetch & Save
  // ============================================================
  fetchBtn.onclick = async () => {
    if (busy) return;

    const auth = $('[data-role="authToken"]').value.trim();
    const programId = $('[data-role="programId"]').value.trim();
    const enrollmentId = $('[data-role="enrollmentId"]').value.trim();
    const courseName = $('[data-role="courseName"]').value.trim() || "Course Export";

    if (!auth) return alert("Authorization token wajib diisi!");
    if (!programId) return alert("Program ID wajib diisi!");
    if (!enrollmentId) return alert("Enrollment Detail ID wajib diisi!");

    const selectedPages = parsedPages.filter((p) => selectedNodeIds.has(p.nodeId));
    if (!selectedPages.length) return alert("Pilih minimal 1 halaman!");

    const isSplitMode = $('[data-role="splitReading"]').checked;
    const imagePrefix = $('[data-role="imagePrefix"]').value.trim();
    const withImages = $('[data-role="imageMode"]').value === "json-images";
    const fetchDelay = Math.max(100, Number($('[data-role="fetchDelay"]').value) || 500);

    cancelled = false;
    setBusy(true);

    try {
      const jsonPages = [];
      const allImageDownloads = new Map();
      const usedImageNames = new Set();
      const failed = [];

      // 1. Fetching Data Phase
      for (let i = 0; i < selectedPages.length; i++) {
        if (cancelled) throw new Error("Export cancelled by user.");

        const item = selectedPages[i];
        setStatus(`🌐 Fetching ${i + 1}/${selectedPages.length}: ${item.title} [${item.nodeId}]`);

        let nodeData = null;
        try {
          nodeData = await fetchNodeContent(item.nodeId, auth, programId, enrollmentId);
        } catch (err) {
          console.error(`Failed to fetch node ${item.nodeId}:`, err);
          failed.push(`${item.title} [${item.nodeId}]: ${err.message}`);
        }

        const activityName = nodeData?.activityName || item.title;
        let contentText = nodeData?.contentText || "";
        const moduleNum = extractModuleNumber(activityName) || extractModuleNumber(item.title);
        const pageImageMap = new Map();

        if (withImages && contentText) {
          for (const imgUrl of extractImagesFromHtml(contentText)) {
            const absUrl = absolutize(imgUrl);
            if (allImageDownloads.has(absUrl)) {
              pageImageMap.set(imgUrl, allImageDownloads.get(absUrl).localName);
              continue;
            }

            let originalName = "";
            try {
              originalName = decodeURIComponent(new URL(absUrl).pathname.split("/").pop());
            } catch {
              originalName = imgUrl.split("/").pop().split("?")[0] || `image_${allImageDownloads.size + 1}.png`;
            }
            originalName = originalName.trim().replace(/[\\/:*?"<>|]+/g, "_");
            if (!originalName || !originalName.includes(".")) originalName = `image_${allImageDownloads.size + 1}.png`;

            const parts = [];
            if (imagePrefix) parts.push(imagePrefix);
            if (moduleNum) parts.push(moduleNum);
            parts.push(originalName);
            let localName = parts.join("-");

            let uniqueName = localName, counter = 1;
            const extIdx = localName.lastIndexOf(".");
            const nameBase = extIdx !== -1 ? localName.slice(0, extIdx) : localName;
            const nameExt = extIdx !== -1 ? localName.slice(extIdx) : ".png";
            while (usedImageNames.has(uniqueName.toLowerCase())) {
              uniqueName = `${nameBase}_${counter}${nameExt}`;
              counter++;
            }
            usedImageNames.add(uniqueName.toLowerCase());
            localName = uniqueName;

            allImageDownloads.set(absUrl, { localName, url: absUrl });
            pageImageMap.set(imgUrl, localName);
          }
          contentText = rewriteImageUrls(contentText, pageImageMap);
        }

        jsonPages.push({
          index: i,
          nodeId: item.nodeId,
          topic: item.topic,
          reading: item.reading,
          title: item.title,
          activityName: activityName,
          moduleNumber: moduleNum,
          contentLength: contentText.length,
          contentText: contentText,
          images: withImages
            ? Array.from(pageImageMap.entries()).map(([o, l]) => ({ originalUrl: absolutize(o), localFilename: l }))
            : undefined,
          _status: nodeData ? "ok" : "failed",
        });

        await sleep(fetchDelay);
      }

      // 2. Saving JSON Phase
      let groupedByReading = {}; // Variabel dipindahkan ke scope luar agar tidak memicu error
      if (isSplitMode) {
        // Mode Split: Kelompokkan berdasarkan Reading
        for (const p of jsonPages) {
          const groupName = p.reading || p.topic || courseName; 
          if (!groupedByReading[groupName]) {
            groupedByReading[groupName] = [];
          }
          groupedByReading[groupName].push(p);
        }

        let groupCount = 1;
        const totalGroups = Object.keys(groupedByReading).length;
        
        for (const [readingTitle, pagesInGroup] of Object.entries(groupedByReading)) {
          if (cancelled) throw new Error("Cancelled during JSON save.");
          
          const output = {
            exportDate: new Date().toISOString(),
            courseName: courseName,
            readingName: readingTitle,
            imagePrefix: imagePrefix || null,
            imageMode: withImages ? "local" : "original",
            totalPages: pagesInGroup.length,
            okCount: pagesInGroup.filter((p) => p.contentLength > 0).length,
            pages: pagesInGroup,
          };

          const jsonFileName = cleanFilename(readingTitle);
          setStatus(`💾 Saving JSON file (${groupCount}/${totalGroups}): ${jsonFileName}...`);
          
          downloadBlob(
            new Blob([JSON.stringify(output, null, 2)], { type: "application/json;charset=utf-8" }),
            `${jsonFileName}.json`
          );
          
          await sleep(600);
          groupCount++;
        }
      } else {
        // Mode Gabung (1 File JSON)
        const output = {
          exportDate: new Date().toISOString(),
          courseName: courseName,
          imagePrefix: imagePrefix || null,
          imageMode: withImages ? "local" : "original",
          totalPages: jsonPages.length,
          okCount: jsonPages.filter((p) => p.contentLength > 0).length,
          failedCount: failed.length,
          failedPages: failed.length ? failed : undefined,
          pages: jsonPages,
        };

        const jsonFileName = cleanFilename(`${courseName} - ${selectedPages.length} pages`);
        setStatus(`💾 Saving single JSON file...`);
        downloadBlob(
          new Blob([JSON.stringify(output, null, 2)], { type: "application/json;charset=utf-8" }),
          `${jsonFileName}.json`
        );
        await sleep(500);
      }

      // 3. Downloading Images Phase
      if (withImages && allImageDownloads.size > 0) {
        setStatus(`📥 Downloading ${allImageDownloads.size} images...`);
        let c = 0;
        for (const [, d] of allImageDownloads.entries()) {
          if (cancelled) throw new Error("Cancelled during image download.");
          try {
            c++;
            setStatus(`📥 Image ${c}/${allImageDownloads.size}: ${d.localName}`);
            downloadBlob(await fetchAsBlob(d.url), d.localName);
          } catch (err) {
            console.warn(`[Export] Image download failed: ${d.url}`, err);
          }
          await sleep(250);
        }
      }

      // 4. Finish
      const okCount = jsonPages.filter((p) => p.contentLength > 0).length;
      setStatus(
        `✅ Done: ${okCount}/${jsonPages.length} pages fetched${withImages ? ` + ${allImageDownloads.size} images` : ""}${failed.length ? ` (${failed.length} failed — cek console)` : ""}.`
      );
      if (failed.length) console.warn("[Kaplan Fetcher] Failed pages:", failed);
      
      if (isSplitMode && Object.keys(groupedByReading || {}).length > 1) {
        console.log("INFO: Jika browser meminta izin 'Download multiple files', pastikan Anda menekan 'Allow'.");
      }
      
    } catch (e) {
      console.error(e);
      if (cancelled || /cancelled/i.test(e.message)) {
        setStatus("❌ Cancelled.", true);
      } else {
        setStatus(`❌ Error: ${e.message}`, true);
        alert(`Error:\n${e.message}`);
      }
    } finally {
      setBusy(false);
    }
  };

  if (location.href.includes("kaplanlearn.com")) {
    setTimeout(() => $('[data-act="autoFill"]').click(), 100);
  }
})();
